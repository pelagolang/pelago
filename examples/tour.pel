}

switch day { case 1: "a" case 2: "b" default: "c" }

// ---- Labels and closure return types ------------------------------------------------
outer: for i of 0..10 {
    inner: for j of 0..10 {
        if i * j > 20 { break outer }
        if j > i { continue outer }
        if j == 3 { break inner }
    }
}

search: loop {
    break search 5
}

const twice = (x: int) -> int ~> x * 2
const bump = [inout n] (a: int, b: int) -> int ~> {
    n += 1
    a + b
}
