linear struct transaction { id: int }

pub fn commit(sink t: transaction) -> void ! db_error { }

struct range {
    lo: int
    hi: int

    init(lo: int, hi: int) -> Self ! bad_range {
        if lo > hi { return err(bad_range) }
        self.lo = lo
        self.hi = hi
    }

    deinit { }
}

impl add for vec2 {
    fn add(self, other: vec2) -> vec2 = vec2 { x: self.x + other.x, y: self.y + other.y }
}

impl<T> show for stack<T> where T: show {
    fn show(self) -> string = "stack"
}

fn largest<T>(xs: [T]) -> T? where T: ordered, T: eq { none }
fn sized<meta N: int>() -> [int; N] { [0; N] }
