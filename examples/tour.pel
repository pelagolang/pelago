switch shape {
    case .rect(w: width, h): width * h
    case shape.circle(radius): radius
    case point { x: 0, y: 0 }: "origin"
    case point { x, .. }: "x is #x"
    case 0..10, 20..=30: "range"
    case ..0: "negative"
    case 100..: "big"
    case -1: "minus one"
    case big is 100..=999: "three digits (#big)"
