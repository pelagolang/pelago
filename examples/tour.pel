// ---- Functions --------------------------------------------------------------
/// Adds two numbers.
///
/// The last expression is the result.
fn add(a: int, b: int) -> int {
    a + b
}

fn double(x: int) -> int = x * 2

fn greet(name: string, greeting: string = "Hello") {
    print("#greeting, #name")
}

greet("Dennis", greeting: "Hi")

fn sum(...nums: int) -> int {
    var total = 0
    for n of nums { total += n }
    total
}

sum(...[1, 2, 3])

fn clear(inout xs: [int]) { xs.clear!() }
fn finish(sink xs: [int]) -> int = xs.len()

clear(inout scores)
finish(sink scores)

fn sum_to(n: int, acc: int = 0) -> int {
    if n == 0 { return acc }
    become sum_to(n - 1, acc + n)
}

fn parse_int(s: string) -> int ! parse_error {
    const n = digits(s)?
    ok(n)
}

fn find(xs: [string], name: string) -> int? { none }
const index = find(names, "Dennis") ?? -1

@inline fn square(x: int) -> int = x * x

meta fn build_table() -> [int; 256] { table }
const table = meta build_table()

fn max<T: ordered>(a: T, b: T) -> T {
    a > b ? a : b
}

// ---- Control flow -------------------------------------------------------------
const grade = {score > 90 ? "A" : score > 80 ? "B" : "C"}

for i in 0..=10 {
    if i % 2 == 0 { continue }
    unless i < 5 { break }
}

for (var i = 0; i < 10; i += 1) { }
for i, x of items { print("#i: #x") }
for inout x of items { x++ }

while score > 0 { score-- }
do { score++ } while score < 3
loop { break }

switch shape {
    case .circle(r): PI * r * r
    case .rect(inout w, h): w += 1.0
    case 1, 2, 3: 0.0
    case n if n > 100: 1.0
    case d is dog: d.fetch()
    default: 0.0
}

if shape is .circle(r) { print("radius #r") }
guard shape is .circle(r) else { return }
const maybe_dog = pet to? dog

if 0 < x && x < 10 || !done { }
const inside = x in 1..10
const mixed = a & b | c ^ d << 2 >> 1

// ---- Types -----------------------------------------------------------------------
struct point {
    x: float
    y: float

    fn length(self) -> float = sqrt(self.x * self.x + self.y * self.y)
    fn shift(inout self, dx: float, dy: float) { self.x += dx; self.y += dy }
}

var p = point { x: 3.0, y: 4.0 }
p.shift!(1.0, 1.0)
const n = c.close!!()

/// A shape with a size.
enum shape {
    /// A round one.
    circle(radius: float)
    rect(w: float, h: float)
    empty
}

interface shape_like {
    fn area(self) -> float
}

struct circle : shape_like { radius: float }
impl shape_like for rect { }

open obj animal {
    name: string
    init(name: string) { self.name = name }
    open fn speak(self) -> string = "..."
}

obj dog : animal {
    override fn speak(self) -> string = "Woof"
}

struct stack<T> { items: [T] }
const lookup: map<string, [int]> = map { "a": [1, 2], "b": [] }
const empty = {:}

// ---- Closures ---------------------------------------------------------------------
const doubled = numbers.map(x ~> x * 2)
const tripled = numbers.map(~> it * 3)
numbers.each([inout total] x ~> total += x)
const cleaned = raw |> trim |> parse
const user_name = user?.name ?? "anonymous"

// ---- Builders -----------------------------------------------------------------------
const doubled_pos = [x of xs if x > 0 ~> x * 2]
const labels = [i, x of xs ~> "#i: #x"]
const pairs = [x of xs, y of ys if x != y ~> (x, y)]
const remainders = set { x of xs ~> x % 10 }
const ages = map { u of users ~> u.name : u.age }
const total = sum(x of xs if x > 0 ~> x * x)
const tail = xs[-3..]

// ---- Overflow ---------------------------------------------------------------------
const hash = a *% 31 +% b
h *%= 31
h +%= c
const safe = a.checked_add(b)
const capped = a.saturating_add(b)
const wrapped = a.wrapping_add(b)

// ---- List patterns ------------------------------------------------------------------
fn sum_list(xs: [int]) -> int {
    switch xs {
        case []: 0
        case [h, ...t]: h + sum_list(t)
    }
}

fn describe(xs: [int]) -> string {
    switch xs {
        case []: "empty"
        case [x]: "one: #x"
        case [first, ..., last]: "from #first to #last"
        case [0, ...rest] if rest.len() > 3: "zero then many"
        case [a, ...mid, b]: "#a, #(mid.len()) more, #b"
    }
}

switch inout xs {
    case [inout first, ...inout rest]:
        first += 1
        rest.reverse!()
    case []: print("nothing")
}

fn command(line: string) {
    switch line.split(" ").to_list() {
        case ["add", name]: add!(name)
        case ["rename", old, new]: rename!(old, new)
        case [cmd, ...]: print("unknown command #cmd")
        case []: print("empty line")
    }
}

fn starts(s: string) -> string {
    switch s {
        case "": "empty"
        case ['a', ...rest]: "starts with a, then #rest"
        case [c, ...]: "starts with #c"
    }
}

if args is [cmd, ...rest] { run(cmd, rest) }
guard args is [path] else { return err(usage()) }
const radii = [s of shapes if s is .circle(r) ~> r]
const values = [o of opts if o is some(v) ~> v * 2]

switch lookup {
    case some(n) if n > 3: "big"
    case some(_): "small"
    case none: "missing"
}

switch result {
    case ok(.circle(r)): r
    case ok(_): 0.0
    case err(e): panic("failed: #e")
}

// ---- Concurrency ---------------------------------------------------------------------
fn parallel_total(xs: [int]) -> int {
    var left = 0
    var right = 0
    const mid = xs.len() / 2
    scope s {
        s.spawn([inout left] ~> left = sum(xs[..mid]))
        s.spawn([inout right] ~> right = sum(xs[mid..]))
    }
    left + right
}

fn pipeline() {
    const task = spawn([sink data] ~> crunch(data))
    const total = task.join!!()
    const (tx, rx) = chan<int>()
    spawn([sink tx] ~> {
        for i of 0..10 { tx.send(i)? }
    })
    for x of rx { print("got #x") }
    select {
        case v = a.recv() { print("a: #v") }
        case v = b.recv() { print("b: #v") }
        case tx.send(next) { sent += 1 }
        case timeout(ms(50)) { print("slow") }
        default { }
    }
    const config = shared(load_config())
    const hits = lock(0)
    hits.with!(n ~> n += 1)
    par_for(inout xs, x ~> x *= 2)
}

// ---- Boxes -----------------------------------------------------------------------------
enum tree { leaf, node(box<tree>, int, box<tree>) }

fn boxes() {
    var b = box(5)
    b.set!(6)
    const seen = b.get() + 1
    const taken = b.take!!()
}

