///* Big integers from the standard library: 30! and the first digits of 2^200. *///
import std.big
import { bigint } = std.big

fn factorial(n: int) -> bigint {
    var result = big.fromInt(1)
    var i = 2
    while i <= n {
        result = result * big.fromInt(i)
        i += 1
    }
    result
}

fn main() {
    print(factorial(30))
    print(big.fromInt(2).pow(200))
}
