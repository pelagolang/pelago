/// A generic stack: type parameters, methods that change and read, options.

struct stack<T> {
    items: [T]

    fn push(inout self, sink item: T) {
        self.items.push!(sink item)
    }

    fn pop(inout self) -> T? = self.items.pop!()

    fn size(self) -> int = self.items.len()
}

fn largest<T>(a: T, b: T, bigger: fn(T, T) -> bool) -> T {
    bigger(a, b) ? a : b
}

fn main() {
    var s = stack<int> { items: [] }
    s.push!(1)
    s.push!(2)
    print(s.size())
    const top = s.pop!() ?? 0
    print(top)
    print(largest(3, 9, (a, b) ~> a > b))
}
