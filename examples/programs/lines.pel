/// Counts the lines and bytes of the files named on the command line, or of standard input without arguments.
import std.fs
import std.io

fn countText(text: str) -> int {
    var n = 0
    var i = 0
    while i < text.len() {
        if text.byteAt(i) == 10 { n += 1 }
        i += 1
    }
    n
}

fn report(name: str, text: str) {
    print("#name: #(countText(text)) lines, #(text.len()) bytes")
}

fn readFile(path: str) -> void ! io_error {
    const text = fs.readText(path)?
    report(path, text)
}

fn main(args: [string]) {
    if args.len() < 2 {
        report("standard input", io.readAll())
        return
    }
    var i = 1
    while i < args.len() {
        if readFile(args[i]) is err(e) { io.eprintln(e.message) }
        i += 1
    }
}
