struct point {
    x: float
    y: float

    fn length(self) -> float = sqrt(self.x * self.x + self.y * self.y)
    fn shift(inout self, dx: float, dy: float) { self.x += dx; self.y += dy }
}

var p = point { x: 3.0, y: 4.0 }
