/// Concurrency: tasks, channels, shared values and locks (docs/design/concurrency.md).

/// ---- Concurrency (docs/design/concurrency.md) ----------------------------------------------------

//~ What `send` returns when nobody is receiving any more.
pub struct closed {}

//~ A running task that will produce a `T`. `join!!()` waits and consumes it.
//~
//~ A task is a function on a stack of its own (`rt_ctx_init`). One worker runs the tasks in turn: a spawned task
//~ starts when the running one waits (a `join`, a `recv` on an empty channel, a `select` with nothing ready, the
//~ end of a `scope` or of `main`) or calls `yield_now()`. Waiting lets the others run, so tasks may talk back and
//~ forth. Several workers come later (docs/design/concurrency-runtime.md).
pub struct task<T> {
    state: ptr

    deinit {
        /// Dropping the handle detaches the task; a task that is already done is freed here.
        if rt_load_int(self.state) == 1 {
            rt_drop_at<T>(rt_offset(self.state, 64))
            rt_free(self.state)
        } else {
            rt_store_int(rt_offset(self.state, 16), 1)
        }
    }
}

/// The task block: [state: 0 live, 1 done][saved context][detached][stack][closure: 16 bytes][pad][result].
/// The running task is `rt_cur`; `rt_tasks` lists every live task, the one `main` runs in first.

//~ Addresses of the live task blocks (0 is `main`'s, made on first use).
pub var rt_tasks: [int] = []
//~ The address of the running task's block.
pub var rt_cur: int = 0
//~ Switches since something last happened: enough of them with nothing happening is a deadlock.
pub var rt_idle: int = 0
//~ A finished task whose stack is freed by the next task to run.
pub var rt_zombie: int = 0

const RT_TASK_STACK = 262144

fn rt_main_init() {
    if rt_tasks.len() == 0 {
        const s = rt_alloc(72)
        rt_cur = rt_addr_int(s)
        rt_tasks.push!(rt_cur)
    }
}

//~ Frees the stack (and a detached task's block) of the task that just finished.
fn rt_reap() {
    if rt_zombie != 0 {
        const z = rt_cast<int, ptr>(rt_zombie)
        rt_zombie = 0
        rt_free(rt_load_ptr(rt_offset(z, 24)))
        rt_store_ptr(rt_offset(z, 24), rt_null())
        if rt_load_int(rt_offset(z, 16)) == 1 {
            rt_free(z)
        }
    }
}

fn rt_switch_to(t: int) {
    const me = rt_cast<int, ptr>(rt_cur)
    const next = rt_cast<int, ptr>(t)
    rt_cur = t
    rt_ctx_switch(rt_offset(me, 8), rt_load_ptr(rt_offset(next, 8)))
    rt_reap()
}

//~ Lets the next task run; false when there is no other.
fn rt_switch_next() -> bool {
    rt_main_init()
    var i = 0
    while rt_tasks[i] != rt_cur { i += 1 }
    const next = rt_tasks[(i + 1) % rt_tasks.len()]
    if next == rt_cur { return false }
    rt_switch_to(next)
    true
}

//~ The running task cannot go on: lets the others run. Stops when nobody can make progress.
fn rt_wait(what: string) {
    rt_idle += 1
    if rt_idle > 2 * rt_tasks.len() + 2 || !rt_switch_next() {
        panic("deadlock: waiting for #what that nobody can provide")
    }
}

//~ Lets the other tasks run for a while.
pub fn yield_now() {
    rt_idle = 0
    rt_switch_next()
}

//~ The first code a task runs: the task block's closure, then the end of the task, which never returns.
fn rt_task_entry() {
    rt_reap()
    rt_task_run_closure()
    rt_task_exit()
}

//~ Its own function so the closure is dropped before the task ends: `rt_task_exit` never returns.
fn rt_task_run_closure() {
    const cur = rt_cast<int, ptr>(rt_cur)
    const g = rt_read<once fn()>(rt_offset(cur, 32))
    g!!()
}

fn rt_task_exit() {
    rt_idle = 0
    const cur = rt_cast<int, ptr>(rt_cur)
    rt_store_int(cur, 1)
    var i = 0
    while rt_tasks[i] != rt_cur { i += 1 }
    rt_tasks.remove!(i)
    rt_zombie = rt_cur
    const next = rt_tasks[i % rt_tasks.len()]
    rt_switch_to(next)
    panic("a finished task ran again")
}

//~ Runs every task that has not finished: the end of a `scope` and of `main`.
pub fn rt_run_pending() {
    if rt_tasks.len() == 0 { return }
    /// `main` is always the first; a task that ends a scope leaves itself and `main` waiting.
    const others = if rt_cur == rt_tasks[0] { 1 } else { 2 }
    while rt_tasks.len() > others {
        rt_wait("a task")
    }
    if rt_tasks.len() == 1 {
        rt_free(rt_cast<int, ptr>(rt_tasks[0]))
        rt_tasks = []
        rt_cur = 0
    }
}

//~ Lets another task run so something may change, for `select`; false when none can.
pub fn rt_run_one_pending() -> bool {
    if rt_tasks.len() <= 1 { return false }
    rt_idle += 1
    if rt_idle > 2 * rt_tasks.len() + 2 { return false }
    rt_switch_next()
}

//~ Can a receive on this channel finish now: a value is queued, or no sender is left?
pub fn rt_chan_ready(ch: ptr) -> bool = rt_hdr_len(ch) > 0 || rt_load_int(rt_offset(ch, 24)) == 0

pub fn rt_task_body<T>(s: ptr, sink f: once fn() -> T) {
    rt_write<T>(rt_offset(s, 64), f!!())
    if rt_load_int(rt_offset(s, 16)) == 1 {
        rt_drop_at<T>(rt_offset(s, 64))
    }
}

impl<T> task<T> {
    fn join(sink self) -> T {
        const s = self.state
        while rt_load_int(s) != 1 {
            rt_wait("a task to finish")
        }
        rt_idle = 0
        const r = rt_read<T>(rt_offset(s, 64))
        rt_free(s)
        rt_forget_task<T>(sink self)
        r
    }
}

//~ Gives up a task handle without running its `deinit`.
pub fn rt_forget_task<T>(sink t: task<T>) {
    rt_cast<task<T>, ptr>(sink t)
}

//~ Starts `f` as a task. What the closure uses must be copied or moved in (`sink x ~> ...`).
pub fn spawn<T>(sink f: once fn() -> T) -> task<T> {
    rt_main_init()
    rt_idle = 0
    const s = rt_alloc(64 + rt_size_of<T>())
    const stack = rt_alloc(RT_TASK_STACK)
    rt_store_ptr(rt_offset(s, 24), stack)
    const runner = [sink f, sink s] () ~> rt_task_body<T>(s, sink f)
    rt_write<once fn()>(rt_offset(s, 32), sink runner)
    rt_store_ptr(rt_offset(s, 8), rt_ctx_init(stack, RT_TASK_STACK, rt_fn_addr(rt_task_entry), rt_null()))
    rt_tasks.push!(rt_addr_int(s))
    task<T> { state: s }
}

//~ The handle of `scope s { ... }`. `s.spawn(task)` starts a task that is finished when the scope ends.
pub struct scope_handle {
    id: int
}

impl scope_handle {
    fn spawn<T>(self, sink f: once fn() -> T) -> task<T> = spawn(sink f)
}

/// A channel block: [queue: list 24 bytes][senders: int][receiver alive: int].

pub struct sender<T> {
    ch: ptr

    deinit {
        const n = rt_load_int(rt_offset(self.ch, 24)) - 1
        rt_store_int(rt_offset(self.ch, 24), n)
        if n == 0 && rt_load_int(rt_offset(self.ch, 32)) == 0 { rt_chan_free<T>(self.ch) }
    }
}

pub struct receiver<T> {
    ch: ptr

    deinit {
        rt_store_int(rt_offset(self.ch, 32), 0)
        if rt_load_int(rt_offset(self.ch, 24)) == 0 { rt_chan_free<T>(self.ch) }
    }
}

pub fn rt_chan_free<T>(ch: ptr) {
    rt_drop_at<list<T>>(ch)
    rt_free(ch)
}

//~ A channel: a sender end and a receiver end. A capacity of 0 means unbounded.
pub fn chan<T>(capacity: int = 0) -> (sender<T>, receiver<T>) {
    const ch = rt_alloc(48)
    var q: list<T> = []
    rt_write<list<T>>(ch, sink q)
    rt_store_int(rt_offset(ch, 24), 1)
    rt_store_int(rt_offset(ch, 32), 1)
    (sender<T> { ch: ch }, receiver<T> { ch: ch })
}

impl<T> sender<T> {
    fn send(self, sink value: T) -> void ! closed {
        if rt_load_int(rt_offset(self.ch, 32)) == 0 { return err(closed {}) }
        var q = rt_read<list<T>>(self.ch)
        q.push!(value)
        rt_write<list<T>>(self.ch, sink q)
        rt_idle = 0
    }
}

//~ More senders: `copy tx`.
impl<T> clone for sender<T> {
    fn clone(self) -> sender<T> {
        rt_store_int(rt_offset(self.ch, 24), rt_load_int(rt_offset(self.ch, 24)) + 1)
        sender<T> { ch: self.ch }
    }
}

impl<T> receiver<T> {
    fn tryRecv(self) -> T? {
        if rt_hdr_len(self.ch) == 0 { return none }
        var q = rt_read<list<T>>(self.ch)
        const v = q.remove!(0)
        rt_write<list<T>>(self.ch, sink q)
        return v
    }

    //~ Waits for a value: other tasks run while the queue is empty. `none` when every sender is gone.
    fn recv(self) -> T? {
        while rt_hdr_len(self.ch) == 0 {
            if rt_load_int(rt_offset(self.ch, 24)) == 0 { return none }
            rt_wait("a value")
        }
        rt_idle = 0
        return self.tryRecv()
    }

    fn iter(self) -> iter<T> {
        var out: list<T> = []
        var more = true
        while more {
            const v = self.recv()
            switch v {
                case some(x): out.push!(x)
                case none: more = false
            }
        }
        rt_cast<list<T>, iter<T>>(sink out)
    }
}

//~ Read-only data counted across threads: `shared(value)`, and `copy handle` for another handle.
pub struct shared<T> {
    p: ptr

    init(sink value: T) {
        const p = rt_alloc(8 + rt_size_of<T>())
        rt_store_int(p, 1)
        rt_write<T>(rt_offset(p, 8), sink value)
        self.p = p
    }

    deinit {
        const n = rt_load_int(self.p) - 1
        rt_store_int(self.p, n)
        if n == 0 {
            rt_drop_at<T>(rt_offset(self.p, 8))
            rt_free(self.p)
        }
    }
}

impl<T> shared<T> {
    fn get(self) -> T = rt_clone<T>(rt_offset(self.p, 8))
}

impl<T> clone for shared<T> {
    fn clone(self) -> shared<T> {
        rt_store_int(self.p, rt_load_int(self.p) + 1)
        shared<T> { p: self.p }
    }
}

//~ Data changed from several threads one at a time: `lock(value)`. Access is through `with`.
pub struct lock<T> {
    p: ptr

    init(sink value: T) {
        const p = rt_alloc(rt_size_of<T>() + 1)
        rt_write<T>(p, sink value)
        self.p = p
    }

    deinit {
        rt_drop_at<T>(self.p)
        rt_free(self.p)
    }
}

impl<T> lock<T> {
    fn with<R>(self, f: fn(inout T) -> R) -> R {
        var v = rt_read<T>(self.p)
        const r = f(inout v)
        rt_write<T>(self.p, sink v)
        r
    }
}
