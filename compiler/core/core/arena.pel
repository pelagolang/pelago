/// Bump arenas (docs/design/arena.md).

//~ A value placed in an `arena`, named by the byte offset in the low 32 bits and the arena's epoch above them.
//~ It is plain data: copying it copies the name, dropping it does nothing. `arena.get` stops on a stale one.
pub struct aref<T> {
    bits: int
}

//~ Handed to each new arena and to each reset, so a handle from before a reset (or from another arena) is recognised.
pub var rtArenaEpoch: int = 0

const rtArenaMax: int = 4294967296

//~ A block of memory (its first 8 bytes are never handed out, so a handle is never zero) where allocating is a bump of `top` and `reset!` frees every value with one store.
//~ Values must not need dropping (numbers, `bool`, `char`, structs and enums of those, other `aref`s).
pub struct arena {
    base: ptr
    top: int
    cap: int
    epoch: int

    init() {
        rtArenaEpoch = rtArenaEpoch + 1
        self.base = rtNull()
        self.top = 8
        self.cap = 0
        self.epoch = rtArenaEpoch & 2147483647
    }

    deinit {
        if self.cap > 0 { rtFree(self.base) }
    }
}

impl arena {
    //~ Puts `value` in the arena and gives its handle. The block may move (handles are offsets, so they survive).
    fn new<T>(inout self, sink value: T) -> aref<T> {
        if rtNeedsDrop<T>() { panic("an arena holds only types without drop glue") }
        const at = self.top
        const end = at + ((rtSizeOf<T>() + 7) / 8) * 8
        if end > self.cap { rtArenaGrowSlow(inout self, end) }
        self.top = end
        rtWrite<T>(rtOffset(self.base, at), sink value)
        aref<T> { bits: (self.epoch << 32) | at }
    }

    //~ The byte offset of `r`; a handle from before a reset, or from another arena, stops the program.
    fn offsetOf<T>(self, r: aref<T>) -> int {
        if (r.bits >> 32) != self.epoch { panic("used a handle after the arena was reset") }
        r.bits & 4294967295
    }

    //~ The value `r` names (a plain value, so this is a bit-for-bit copy).
    fn get<T>(self, r: aref<T>) -> T = rtClone<T>(rtOffset(self.base, self.offsetOf(r)))

    //~ Overwrites the value `r` names.
    fn set<T>(inout self, r: aref<T>, sink value: T) {
        rtWrite<T>(rtOffset(self.base, self.offsetOf(r)), sink value)
    }

    //~ Forgets every value at once; all handles made so far are stale.
    fn reset(inout self) {
        rtArenaEpoch = rtArenaEpoch + 1
        self.epoch = rtArenaEpoch & 2147483647
        self.top = 8
    }

    //~ Bytes handed out since the last reset.
    fn used(self) -> int = self.top - 8

    //~ A handle that names nothing (zero bits: the first 8 bytes of an arena are never handed out). Smaller than `aref<T>?`: 8 bytes, not 16.
    fn noRef<T>(self) -> aref<T> = aref<T> { bits: 0 }

    fn isNone<T>(self, r: aref<T>) -> bool = r.bits == 0
}

//~ Makes room for `needed` bytes. The rarely taken half of `arena.new` (`_slow`: the optimiser keeps it a call), so `new` stays small enough to be inlined.
pub fn rtArenaGrowSlow(inout a: arena, needed: int) {
    if needed > rtArenaMax { panic("arena full") }
    var ncap = a.cap * 2
    if ncap < 4096 { ncap = 4096 }
    if ncap < needed { ncap = needed }
    if ncap > rtArenaMax { ncap = rtArenaMax }
    if a.cap > 0 {
        a.base = rtRealloc(a.base, ncap)
    } else {
        a.base = rtAlloc(ncap)
    }
    a.cap = ncap
}
