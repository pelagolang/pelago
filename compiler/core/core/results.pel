/// `option` and `result`.

impl<T> option<T> {
    fn isSome(self) -> bool {
        switch self {
            case some(_): true
            case none: false
        }
    }

    fn isNone(self) -> bool = !self.isSome()

    fn unwrapOr(self, fallback: T) -> T {
        switch self {
            case some(v): rtClone<T>(rtAddrOf(v))
            case none: rtClone<T>(rtAddrOf(fallback))
        }
    }

    fn map<U>(self, f: fn(T) -> U) -> U? {
        switch self {
            case some(v): f(rtClone<T>(rtAddrOf(v)))
            case none: none
        }
    }

    //~ The value, or `f()` when there is none (the fallback is only computed when needed).
    fn unwrapOrElse(self, f: fn() -> T) -> T {
        switch self {
            case some(v): rtClone<T>(rtAddrOf(v))
            case none: f()
        }
    }

    //~ Chains a step that may itself give `none`: `parse(a).andThen((n) ~> half(n))`.
    fn andThen<U>(self, f: fn(T) -> U?) -> U? {
        switch self {
            case some(v): f(rtClone<T>(rtAddrOf(v)))
            case none: none
        }
    }

    //~ Keeps the value only when `f` holds for it.
    fn filter(self, f: fn(T) -> bool) -> T? {
        switch self {
            case some(v): {
                if f(rtClone<T>(rtAddrOf(v))) { rtClone<T>(rtAddrOf(v)) } else { none }
            }
            case none: none
        }
    }

    //~ This option when it has a value, else `f()`.
    fn orElse(self, f: fn() -> T?) -> T? {
        switch self {
            case some(v): rtClone<T>(rtAddrOf(v))
            case none: f()
        }
    }

    //~ True when there is a value and `f` holds for it.
    fn isSomeAnd(self, f: fn(T) -> bool) -> bool {
        switch self {
            case some(v): f(rtClone<T>(rtAddrOf(v)))
            case none: false
        }
    }

    //~ Both values as a pair, or `none` when either is missing.
    fn zip<U>(self, other: U?) -> (T, U)? {
        switch self {
            case some(a): {
                switch other {
                    case some(b): (rtClone<T>(rtAddrOf(a)), rtClone<U>(rtAddrOf(b)))
                    case none: none
                }
            }
            case none: none
        }
    }

    fn orErr<E>(self, e: E) -> T ! E {
        switch self {
            case some(v): ok(rtClone<T>(rtAddrOf(v)))
            case none: err(rtClone<E>(rtAddrOf(e)))
        }
    }
}

impl<T, E> result<T, E> {
    fn ok(self) -> T? {
        switch self {
            case ok(v): return rtClone<T>(rtAddrOf(v))
            case err(_): return none
        }
    }

    fn isOk(self) -> bool {
        switch self {
            case ok(_): true
            case err(_): false
        }
    }

    fn isErr(self) -> bool = !self.isOk()

    fn or(self, fallback: T) -> T {
        switch self {
            case ok(v): rtClone<T>(rtAddrOf(v))
            case err(_): rtClone<T>(rtAddrOf(fallback))
        }
    }

    //~ The error as an option: `none` when the result is `ok`.
    fn err(self) -> E? {
        switch self {
            case ok(_): return none
            case err(e): return rtClone<E>(rtAddrOf(e))
        }
    }

    fn map<U>(self, f: fn(T) -> U) -> U ! E {
        switch self {
            case ok(v): ok(f(rtClone<T>(rtAddrOf(v))))
            case err(e): err(rtClone<E>(rtAddrOf(e)))
        }
    }

    //~ Chains a step that can fail with the same error type.
    fn andThen<U>(self, f: fn(T) -> U ! E) -> U ! E {
        switch self {
            case ok(v): f(rtClone<T>(rtAddrOf(v)))
            case err(e): err(rtClone<E>(rtAddrOf(e)))
        }
    }

    //~ The value, or `f(error)` when it failed.
    fn unwrapOrElse(self, f: fn(E) -> T) -> T {
        switch self {
            case ok(v): rtClone<T>(rtAddrOf(v))
            case err(e): f(rtClone<E>(rtAddrOf(e)))
        }
    }

    //~ Recovers from an error with another result.
    fn orElse<F>(self, f: fn(E) -> T ! F) -> T ! F {
        switch self {
            case ok(v): ok(rtClone<T>(rtAddrOf(v)))
            case err(e): f(rtClone<E>(rtAddrOf(e)))
        }
    }

    fn isOkAnd(self, f: fn(T) -> bool) -> bool {
        switch self {
            case ok(v): f(rtClone<T>(rtAddrOf(v)))
            case err(_): false
        }
    }

    fn mapErr<F>(self, f: fn(E) -> F) -> T ! F {
        switch self {
            case ok(v): ok(rtClone<T>(rtAddrOf(v)))
            case err(e): err(f(rtClone<E>(rtAddrOf(e))))
        }
    }

    //~ Adds a line of context to the error: `context: error`.
    fn context(self, message: str) -> T ! error {
        switch self {
            case ok(v): ok(rtClone<T>(rtAddrOf(v)))
            case err(e): {
                var text = ""
                rtStrPush(
                    rtAddrOf(text),
                    rtHdrData(rtAddrOf(message)),
                    rtHdrLen(rtAddrOf(message)),
                )
                rtPushChar(rtAddrOf(text), ':')
                rtPushChar(rtAddrOf(text), ' ')
                rtShowTo<E>(rtAddrOf(e), rtAddrOf(text))
                err(rtCast<string, error>(sink text))
            }
        }
    }
}
