/// `option` and `result`.

impl<T> option<T> {
    fn isSome(self) -> bool {
        switch self {
            case some(_): true
            case none: false
        }
    }

    fn isNone(self) -> bool = !self.isSome()

    fn unwrapOr(self, fallback: T) -> T {
        switch self {
            case some(v): rtClone<T>(rtAddrOf(v))
            case none: rtClone<T>(rtAddrOf(fallback))
        }
    }

    fn map<U>(self, f: fn(T) -> U) -> U? {
        switch self {
            case some(v): f(rtClone<T>(rtAddrOf(v)))
            case none: none
        }
    }

    fn orErr<E>(self, e: E) -> T ! E {
        switch self {
            case some(v): ok(rtClone<T>(rtAddrOf(v)))
            case none: err(rtClone<E>(rtAddrOf(e)))
        }
    }
}

impl<T, E> result<T, E> {
    fn ok(self) -> T? {
        switch self {
            case ok(v): return rtClone<T>(rtAddrOf(v))
            case err(_): return none
        }
    }

    fn isOk(self) -> bool {
        switch self {
            case ok(_): true
            case err(_): false
        }
    }

    fn isErr(self) -> bool = !self.isOk()

    fn or(self, fallback: T) -> T {
        switch self {
            case ok(v): rtClone<T>(rtAddrOf(v))
            case err(_): rtClone<T>(rtAddrOf(fallback))
        }
    }

    fn mapErr<F>(self, f: fn(E) -> F) -> T ! F {
        switch self {
            case ok(v): ok(rtClone<T>(rtAddrOf(v)))
            case err(e): err(f(rtClone<E>(rtAddrOf(e))))
        }
    }

    //~ Adds a line of context to the error: `context: error`.
    fn context(self, message: str) -> T ! error {
        switch self {
            case ok(v): ok(rtClone<T>(rtAddrOf(v)))
            case err(e): {
                var text = ""
                rtStrPush(
                    rtAddrOf(text),
                    rtHdrData(rtAddrOf(message)),
                    rtHdrLen(rtAddrOf(message)),
                )
                rtPushChar(rtAddrOf(text), ':')
                rtPushChar(rtAddrOf(text), ' ')
                rtShowTo<E>(rtAddrOf(e), rtAddrOf(text))
                err(rtCast<string, error>(sink text))
            }
        }
    }
}
