/// Concurrency: tasks, channels, shared values and locks (docs/design/concurrency.md).

/// ---- Concurrency (docs/design/concurrency.md) ----------------------------------------------------

//~ What `send` returns when nobody is receiving any more.
pub struct closed {}

//~ A running task that will produce a `T`. `join!!()` waits and consumes it.
//~
//~ A task is a function on a stack of its own (`rt_ctx_init`). One worker runs the tasks in turn: a spawned task
//~ starts when the running one waits (a `join`, a `recv` on an empty channel, a `select` with nothing ready, the
//~ end of a `scope` or of `main`) or calls `yield_now()`. Waiting lets the others run, so tasks may talk back and
//~ forth. Several workers come later (docs/design/concurrency-runtime.md).
pub struct task<T> {
    state: ptr

    deinit {
        /// Dropping the handle detaches the task; a task that is already done is freed here.
        if rt_load_int(self.state) == 1 {
            rt_drop_at<T>(rt_offset(self.state, 64))
            rt_free(self.state)
        } else {
            rt_store_int(rt_offset(self.state, 16), 1)
        }
    }
}

/// The task block: [state: 0 live, 1 done][saved context][detached][stack][closure: 16 bytes][pad][result].
/// The running task is `rt_cur`; `rt_tasks` lists every live task, the one `main` runs in first.

//~ Addresses of the live task blocks (0 is `main`'s, made on first use).
pub var rt_tasks: [int] = []
//~ The address of the running task's block.
pub var rt_cur: int = 0
//~ Switches since something last happened: enough of them with nothing happening is a deadlock.
pub var rt_idle: int = 0
//~ A finished task whose stack is freed by the next task to run.
pub var rt_zombie: int = 0

const RT_TASK_STACK = 262144

fn rt_main_init() {
    if rt_tasks.len() == 0 {
        const s = rt_alloc(72)
        rt_cur = rt_addr_int(s)
        rt_tasks.push!(rt_cur)
    }
}

//~ Frees the stack (and a detached task's block) of the task that just finished.
fn rt_reap() {
    if rt_zombie != 0 {
        const z = rt_cast<int, ptr>(rt_zombie)
        rt_zombie = 0
        rt_free(rt_load_ptr(rt_offset(z, 24)))
        rt_store_ptr(rt_offset(z, 24), rt_null())
        if rt_load_int(rt_offset(z, 16)) == 1 {
            rt_free(z)
        }
    }
}

fn rt_switch_to(t: int) {
    const me = rt_cast<int, ptr>(rt_cur)
    const next = rt_cast<int, ptr>(t)
    rt_cur = t
    rt_ctx_switch(rt_offset(me, 8), rt_load_ptr(rt_offset(next, 8)))
    rt_reap()
}

//~ Lets the next task run; false when there is no other.
fn rt_switch_next() -> bool {
    rt_main_init()
    var i = 0
    while rt_tasks[i] != rt_cur { i += 1 }
    const next = rt_tasks[(i + 1) % rt_tasks.len()]
    if next == rt_cur { return false }
    rt_switch_to(next)
    true
}

//~ The running task cannot go on: lets the others run. Stops when nobody can make progress.
fn rt_wait(what: string) {
    rt_idle += 1
    if rt_idle > 2 * rt_tasks.len() + 2 || !rt_switch_next() {
        panic("deadlock: waiting for #what that nobody can provide")
    }
}

//~ Lets the other tasks run for a while.
pub fn yield_now() {
    rt_idle = 0
    rt_switch_next()
}

//~ The first code a task runs: the task block's closure, then the end of the task, which never returns.
fn rt_task_entry() {
    rt_reap()
    rt_task_run_closure()
    rt_task_exit()
}

//~ Its own function so the closure is dropped before the task ends: `rt_task_exit` never returns.
fn rt_task_run_closure() {
    const cur = rt_cast<int, ptr>(rt_cur)
    const g = rt_read<once fn()>(rt_offset(cur, 32))
    g!!()
}

fn rt_task_exit() {
    rt_idle = 0
    const cur = rt_cast<int, ptr>(rt_cur)
    rt_store_int(cur, 1)
    var i = 0
    while rt_tasks[i] != rt_cur { i += 1 }
    rt_tasks.remove!(i)
    rt_zombie = rt_cur
    const next = rt_tasks[i % rt_tasks.len()]
    rt_switch_to(next)
    panic("a finished task ran again")
}

//~ Runs every task that has not finished: the end of a `scope` and of `main`.
pub fn rt_run_pending() {
    if rt_tasks.len() == 0 { return }
    /// `main` is always the first; a task that ends a scope leaves itself and `main` waiting.
    const others = if rt_cur == rt_tasks[0] { 1 } else { 2 }
    while rt_tasks.len() > others {
        rt_wait("a task")
    }
    if rt_tasks.len() == 1 {
        rt_free(rt_cast<int, ptr>(rt_tasks[0]))
        rt_tasks = []
        rt_cur = 0
    }
}

//~ Lets another task run so something may change, for `select`; false when none can.
pub fn rt_run_one_pending() -> bool {
    if rt_tasks.len() <= 1 { return false }
    rt_idle += 1
    if rt_idle > 2 * rt_tasks.len() + 2 { return false }
    rt_switch_next()
}

//~ Can a receive on this channel finish now: a value is queued, or no sender is left?
pub fn rt_chan_ready(ch: ptr) -> bool = rt_load_int(rt_offset(ch, 24)) > 0 || rt_load_int(rt_offset(ch, 32)) == 0

pub fn rt_task_body<T>(s: ptr, sink f: once fn() -> T) {
    rt_write<T>(rt_offset(s, 64), f!!())
    if rt_load_int(rt_offset(s, 16)) == 1 {
        rt_drop_at<T>(rt_offset(s, 64))
    }
}

impl<T> task<T> {
    fn join(sink self) -> T {
        const s = self.state
        while rt_load_int(s) != 1 {
            rt_wait("a task to finish")
        }
        rt_idle = 0
        const r = rt_read<T>(rt_offset(s, 64))
        rt_free(s)
        rt_forget_task<T>(sink self)
        r
    }
}

//~ Gives up a task handle without running its `deinit`.
pub fn rt_forget_task<T>(sink t: task<T>) {
    rt_cast<task<T>, ptr>(sink t)
}

//~ Starts `f` as a task. What the closure uses must be copied or moved in (`sink x ~> ...`).
pub fn spawn<T>(sink f: once fn() -> T) -> task<T> {
    rt_main_init()
    rt_idle = 0
    const s = rt_alloc(64 + rt_size_of<T>())
    const stack = rt_alloc(RT_TASK_STACK)
    rt_store_ptr(rt_offset(s, 24), stack)
    const runner = [sink f, sink s] () ~> rt_task_body<T>(s, sink f)
    rt_write<once fn()>(rt_offset(s, 32), sink runner)
    rt_store_ptr(rt_offset(s, 8), rt_ctx_init(stack, RT_TASK_STACK, rt_fn_addr(rt_task_entry), rt_null()))
    rt_tasks.push!(rt_addr_int(s))
    task<T> { state: s }
}

//~ The handle of `scope s { ... }`. `s.spawn(task)` starts a task that is finished when the scope ends.
pub struct scope_handle {
    id: int
}

impl scope_handle {
    fn spawn<T>(self, sink f: once fn() -> T) -> task<T> = spawn(sink f)
}

/// A channel block: [buffer][capacity in slots][head][length][senders][receiver alive][bound][slot size].
/// The buffer is a ring of flat slots, one per value: `send` moves the value's bytes into a slot, `recv` moves them
/// out, so nothing is shared between tasks. `bound` is the capacity asked for (0: unbounded, the ring grows).

pub struct sender<T> {
    ch: ptr

    deinit {
        const n = rt_load_int(rt_offset(self.ch, 32)) - 1
        rt_store_int(rt_offset(self.ch, 32), n)
        rt_idle = 0
        if n == 0 && rt_load_int(rt_offset(self.ch, 40)) == 0 { rt_chan_free<T>(self.ch) }
    }
}

pub struct receiver<T> {
    ch: ptr

    deinit {
        rt_store_int(rt_offset(self.ch, 40), 0)
        rt_idle = 0
        if rt_load_int(rt_offset(self.ch, 32)) == 0 { rt_chan_free<T>(self.ch) }
    }
}

//~ The address of the n-th queued slot.
fn rt_chan_slot(ch: ptr, n: int) -> ptr {
    const cap = rt_load_int(rt_offset(ch, 8))
    const at = (rt_load_int(rt_offset(ch, 16)) + n) % cap
    rt_offset(rt_load_ptr(ch), at * rt_load_int(rt_offset(ch, 56)))
}

pub fn rt_chan_free<T>(ch: ptr) {
    var i = 0
    const len = rt_load_int(rt_offset(ch, 24))
    while i < len {
        rt_drop_at<T>(rt_chan_slot(ch, i))
        i += 1
    }
    rt_free(rt_load_ptr(ch))
    rt_free(ch)
}

//~ A channel: a sender end and a receiver end. With a capacity, `send` waits while that many values are queued;
//~ a capacity of 0 means unbounded.
pub fn chan<T>(capacity: int = 0) -> (sender<T>, receiver<T>) {
    const ch = rt_alloc(64)
    const slot = if rt_size_of<T>() == 0 { 8 } else { rt_size_of<T>() }
    const cap = if capacity > 0 { capacity } else { 8 }
    rt_store_ptr(ch, rt_alloc(cap * slot))
    rt_store_int(rt_offset(ch, 8), cap)
    rt_store_int(rt_offset(ch, 32), 1)
    rt_store_int(rt_offset(ch, 40), 1)
    rt_store_int(rt_offset(ch, 48), capacity)
    rt_store_int(rt_offset(ch, 56), slot)
    (sender<T> { ch: ch }, receiver<T> { ch: ch })
}

//~ Doubles the ring of an unbounded channel that is full, keeping the queued values in order.
fn rt_chan_grow(ch: ptr) {
    const cap = rt_load_int(rt_offset(ch, 8))
    const slot = rt_load_int(rt_offset(ch, 56))
    const len = rt_load_int(rt_offset(ch, 24))
    const fresh = rt_alloc(cap * 2 * slot)
    var i = 0
    while i < len {
        rt_copy(rt_offset(fresh, i * slot), rt_chan_slot(ch, i), slot)
        i += 1
    }
    rt_free(rt_load_ptr(ch))
    rt_store_ptr(ch, fresh)
    rt_store_int(rt_offset(ch, 8), cap * 2)
    rt_store_int(rt_offset(ch, 16), 0)
}

impl<T> sender<T> {
    //~ Queues the value; waits while a bounded channel is full. `closed` when the receiver is gone.
    fn send(self, sink value: T) -> void ! closed {
        const ch = self.ch
        var sent = false
        while !sent && rt_load_int(rt_offset(ch, 40)) != 0 {
            const bound = rt_load_int(rt_offset(ch, 48))
            if bound == 0 || rt_load_int(rt_offset(ch, 24)) < bound {
                if rt_load_int(rt_offset(ch, 24)) == rt_load_int(rt_offset(ch, 8)) { rt_chan_grow(ch) }
                const len = rt_load_int(rt_offset(ch, 24))
                rt_write<T>(rt_chan_slot(ch, len), sink value)
                rt_store_int(rt_offset(ch, 24), len + 1)
                rt_idle = 0
                sent = true
            } else {
                rt_wait("room in a channel")
            }
        }
        if !sent {
            return err(closed {})
        }
    }
}

//~ More senders: `copy tx`.
impl<T> clone for sender<T> {
    fn clone(self) -> sender<T> {
        rt_store_int(rt_offset(self.ch, 32), rt_load_int(rt_offset(self.ch, 32)) + 1)
        sender<T> { ch: self.ch }
    }
}

impl<T> receiver<T> {
    fn tryRecv(self) -> T? {
        const ch = self.ch
        const len = rt_load_int(rt_offset(ch, 24))
        if len == 0 { return none }
        const v = rt_read<T>(rt_chan_slot(ch, 0))
        rt_store_int(rt_offset(ch, 16), (rt_load_int(rt_offset(ch, 16)) + 1) % rt_load_int(rt_offset(ch, 8)))
        rt_store_int(rt_offset(ch, 24), len - 1)
        rt_idle = 0
        return v
    }

    //~ Waits for a value: other tasks run while the queue is empty. `none` when every sender is gone.
    fn recv(self) -> T? {
        while rt_load_int(rt_offset(self.ch, 24)) == 0 {
            if rt_load_int(rt_offset(self.ch, 32)) == 0 { return none }
            rt_wait("a value")
        }
        return self.tryRecv()
    }

    fn iter(self) -> iter<T> {
        var out: list<T> = []
        var more = true
        while more {
            const v = self.recv()
            switch v {
                case some(x): out.push!(x)
                case none: more = false
            }
        }
        rt_cast<list<T>, iter<T>>(sink out)
    }
}

//~ Read-only data counted across threads: `shared(value)`, and `copy handle` for another handle.
pub struct shared<T> {
    p: ptr

    init(sink value: T) {
        const p = rt_alloc(8 + rt_size_of<T>())
        rt_store_int(p, 1)
        rt_write<T>(rt_offset(p, 8), sink value)
        self.p = p
    }

    deinit {
        const n = rt_load_int(self.p) - 1
        rt_store_int(self.p, n)
        if n == 0 {
            rt_drop_at<T>(rt_offset(self.p, 8))
            rt_free(self.p)
        }
    }
}

impl<T> shared<T> {
    fn get(self) -> T = rt_clone<T>(rt_offset(self.p, 8))
}

impl<T> clone for shared<T> {
    fn clone(self) -> shared<T> {
        rt_store_int(self.p, rt_load_int(self.p) + 1)
        shared<T> { p: self.p }
    }
}

//~ Data changed from several threads one at a time: `lock(value)`. Access is through `with`; `copy handle` for
//~ another handle to the same lock, which another task can own.
pub struct lock<T> {
    p: ptr

    init(sink value: T) {
        /// The block: [held: 0 or 1][handles][value].
        const p = rt_alloc(16 + rt_size_of<T>())
        rt_store_int(rt_offset(p, 8), 1)
        rt_write<T>(rt_offset(p, 16), sink value)
        self.p = p
    }

    deinit {
        const n = rt_load_int(rt_offset(self.p, 8)) - 1
        rt_store_int(rt_offset(self.p, 8), n)
        if n == 0 {
            rt_drop_at<T>(rt_offset(self.p, 16))
            rt_free(self.p)
        }
    }
}

impl<T> lock<T> {
    //~ Runs `f` with the value, one task at a time: a task that finds the lock held waits, also when the holder
    //~ itself waits inside `f` (on a channel, say).
    fn with<R>(self, f: fn(inout T) -> R) -> R {
        while rt_load_int(self.p) != 0 {
            rt_wait("a lock")
        }
        rt_store_int(self.p, 1)
        var v = rt_read<T>(rt_offset(self.p, 16))
        const r = f(inout v)
        rt_write<T>(rt_offset(self.p, 16), sink v)
        rt_store_int(self.p, 0)
        rt_idle = 0
        r
    }

    //~ Like `with`, but waits until `ready` accepts the value (the lock is free while it waits): a condition
    //~ variable without the separate type.
    fn withWhen<R>(self, ready: fn(T) -> bool, f: fn(inout T) -> R) -> R {
        while true {
            while rt_load_int(self.p) != 0 {
                rt_wait("a lock")
            }
            rt_store_int(self.p, 1)
            var v = rt_read<T>(rt_offset(self.p, 16))
            if ready(v) {
                const r = f(inout v)
                rt_write<T>(rt_offset(self.p, 16), sink v)
                rt_store_int(self.p, 0)
                rt_idle = 0
                return r
            }
            rt_write<T>(rt_offset(self.p, 16), sink v)
            rt_store_int(self.p, 0)
            rt_wait("a lock condition")
        }
        panic("unreachable")
    }
}

impl<T> clone for lock<T> {
    fn clone(self) -> lock<T> {
        rt_store_int(rt_offset(self.p, 8), rt_load_int(rt_offset(self.p, 8)) + 1)
        lock<T> { p: self.p }
    }
}

//~ A count of permits: `semaphore(n)`; `acquire` waits for one, `release` returns one. `copy handle` shares it.
pub struct semaphore {
    p: ptr

    init(permits: int) {
        /// The block: [permits][handles].
        const p = rt_alloc(16)
        rt_store_int(p, permits)
        rt_store_int(rt_offset(p, 8), 1)
        self.p = p
    }

    deinit {
        const n = rt_load_int(rt_offset(self.p, 8)) - 1
        rt_store_int(rt_offset(self.p, 8), n)
        if n == 0 {
            rt_free(self.p)
        }
    }
}

impl semaphore {
    fn acquire(self) {
        while rt_load_int(self.p) <= 0 {
            rt_wait("a semaphore permit")
        }
        rt_store_int(self.p, rt_load_int(self.p) - 1)
        rt_idle = 0
    }

    fn release(self) {
        rt_store_int(self.p, rt_load_int(self.p) + 1)
        rt_idle = 0
    }
}

impl clone for semaphore {
    fn clone(self) -> semaphore {
        rt_store_int(rt_offset(self.p, 8), rt_load_int(rt_offset(self.p, 8)) + 1)
        semaphore { p: self.p }
    }
}

//~ A meeting point for `n` tasks: `barrier(n)`; `wait` returns once all `n` have called it, and the barrier
//~ can be used again. `copy handle` shares it.
pub struct barrier {
    p: ptr

    init(n: int) {
        /// The block: [n][arrived][generation][handles].
        const p = rt_alloc(32)
        rt_store_int(p, n)
        rt_store_int(rt_offset(p, 8), 0)
        rt_store_int(rt_offset(p, 16), 0)
        rt_store_int(rt_offset(p, 24), 1)
        self.p = p
    }

    deinit {
        const n = rt_load_int(rt_offset(self.p, 24)) - 1
        rt_store_int(rt_offset(self.p, 24), n)
        if n == 0 {
            rt_free(self.p)
        }
    }
}

impl barrier {
    fn wait(self) {
        const gen = rt_load_int(rt_offset(self.p, 16))
        const arrived = rt_load_int(rt_offset(self.p, 8)) + 1
        if arrived >= rt_load_int(self.p) {
            rt_store_int(rt_offset(self.p, 8), 0)
            rt_store_int(rt_offset(self.p, 16), gen + 1)
            rt_idle = 0
            return
        }
        rt_store_int(rt_offset(self.p, 8), arrived)
        while rt_load_int(rt_offset(self.p, 16)) == gen {
            rt_wait("a barrier")
        }
    }
}

impl clone for barrier {
    fn clone(self) -> barrier {
        rt_store_int(rt_offset(self.p, 24), rt_load_int(rt_offset(self.p, 24)) + 1)
        barrier { p: self.p }
    }
}
