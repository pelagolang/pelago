/// Concurrency: tasks, channels, shared values and locks (docs/design/concurrency.md).

/// ---- Concurrency (docs/design/concurrency.md) ----------------------------------------------------

//~ What `send` returns when nobody is receiving any more.
pub struct closed {}

//~ A running task that will produce a `T`. `join!!()` waits and consumes it.
//~
//~ A task is a function on a stack of its own (`rtCtxInit`). One worker runs the tasks in turn: a spawned task
//~ starts when the running one waits (a `join`, a `recv` on an empty channel, a `select` with nothing ready, the
//~ end of a `scope` or of `main`) or calls `yield_now()`. Waiting lets the others run, so tasks may talk back and
//~ forth. Several workers come later (docs/design/concurrency-runtime.md).
pub struct task<T> {
    state: ptr

    deinit {
        /// Dropping the handle detaches the task; a task that is already done is freed here.
        if rtLoadInt(self.state) == 1 {
            rtDropAt<T>(rtOffset(self.state, 64))
            rtFree(self.state)
        } else {
            rtStoreInt(rtOffset(self.state, 16), 1)
        }
    }
}

/// The task block: [state: 0 live, 1 done][saved context][detached][stack][closure: 16 bytes][cancelled][pad][result].
/// The running task is `rtCur`; `rtTasks` lists every live task, the one `main` runs in first.

//~ Addresses of the live task blocks (0 is `main`'s, made on first use).
pub var rtTasks: [int] = []
//~ The address of the running task's block.
pub var rtCur: int = 0
//~ Switches since something last happened: enough of them with nothing happening is a deadlock.
pub var rtIdle: int = 0
//~ A finished task whose stack is freed by the next task to run.
pub var rtZombie: int = 0

const RT_TASK_STACK = 262144

//~ Stacks of finished tasks, kept for the next `spawn` (no mapping, no unmapping). At most `RT_STACK_POOL` of them.
pub var rtStackPool: [int] = []
const RT_STACK_POOL = 16

fn rtStackTake() -> ptr {
    const n = rtStackPool.len()
    if n == 0 { return rtAlloc(RT_TASK_STACK) }
    const p = rtStackPool[n - 1]
    rtStackPool.pop!()
    rtCast<int, ptr>(p)
}

fn rtStackGive(p: ptr) {
    if rtStackPool.len() < RT_STACK_POOL {
        rtStackPool.push!(rtAddrInt(p))
    } else {
        rtFree(p)
    }
}

fn rtMainInit() {
    if rtTasks.len() == 0 {
        const s = rtAlloc(72)
        rtCur = rtAddrInt(s)
        rtTasks.push!(rtCur)
    }
}

//~ Frees the stack (and a detached task's block) of the task that just finished.
fn rtReap() {
    if rtZombie != 0 {
        const z = rtCast<int, ptr>(rtZombie)
        rtZombie = 0
        rtStackGive(rtLoadPtr(rtOffset(z, 24)))
        rtStorePtr(rtOffset(z, 24), rtNull())
        if rtLoadInt(rtOffset(z, 16)) == 1 {
            rtFree(z)
        }
    }
}

fn rtSwitchTo(t: int) {
    const me = rtCast<int, ptr>(rtCur)
    const next = rtCast<int, ptr>(t)
    rtCur = t
    rtCtxSwitch(rtOffset(me, 8), rtLoadPtr(rtOffset(next, 8)))
    rtReap()
}

//~ Lets the next task run; false when there is no other.
fn rtSwitchNext() -> bool {
    rtMainInit()
    var i = 0
    while rtTasks[i] != rtCur { i += 1 }
    const next = rtTasks[(i + 1) % rtTasks.len()]
    if next == rtCur { return false }
    rtSwitchTo(next)
    true
}

//~ The running task cannot go on: lets the others run. Stops when nobody can make progress.
fn rtWait(what: string) {
    rtIdle += 1
    if rtIdle > 2 * rtTasks.len() + 2 || !rtSwitchNext() {
        panic("deadlock: waiting for #what that nobody can provide")
    }
}

//~ Lets the other tasks run for a while.
pub fn yield_now() {
    rtIdle = 0
    rtSwitchNext()
}

//~ The first code a task runs: the task block's closure, then the end of the task, which never returns.
fn rtTaskEntry() {
    rtReap()
    rtTaskRunClosure()
    rtTaskExit()
}

//~ Its own function so the closure is dropped before the task ends: `rtTaskExit` never returns.
fn rtTaskRunClosure() {
    const cur = rtCast<int, ptr>(rtCur)
    const g = rtRead<once fn()>(rtOffset(cur, 32))
    g!!()
}

fn rtTaskExit() {
    rtIdle = 0
    const cur = rtCast<int, ptr>(rtCur)
    rtStoreInt(cur, 1)
    var i = 0
    while rtTasks[i] != rtCur { i += 1 }
    rtTasks.remove!(i)
    rtZombie = rtCur
    const next = rtTasks[i % rtTasks.len()]
    rtSwitchTo(next)
    panic("a finished task ran again")
}

//~ Runs every task that has not finished: the end of a `scope` and of `main`.
pub fn rtRunPending() {
    if rtTasks.len() == 0 { return }
    /// `main` is always the first; a task that ends a scope leaves itself and `main` waiting.
    const others = if rtCur == rtTasks[0] { 1 } else { 2 }
    while rtTasks.len() > others {
        rtWait("a task")
    }
    if rtTasks.len() == 1 {
        rtFree(rtCast<int, ptr>(rtTasks[0]))
        while rtStackPool.len() > 0 {
            rtFree(rtStackTake())
        }
        rtStackPool = []
        rtTasks = []
        rtCur = 0
    }
}

//~ Lets another task run so something may change, for `select`; false when none can.
pub fn rtRunOnePending() -> bool {
    if rtTasks.len() <= 1 { return false }
    rtIdle += 1
    if rtIdle > 2 * rtTasks.len() + 2 { return false }
    rtSwitchNext()
}

//~ Can a receive on this channel finish now: a value is queued, or no sender is left?
pub fn rtChanReady(ch: ptr) -> bool = rtLoadInt(rtOffset(ch, 24)) > 0 ||
    rtLoadInt(rtOffset(ch, 32)) == 0
//~ Whether a send into the channel would not wait: it has room, no bound, or nobody is receiving.
pub fn rtChanRoom(ch: ptr) -> bool {
    const bound = rtLoadInt(rtOffset(ch, 48))
    bound == 0 || rtLoadInt(rtOffset(ch, 24)) < bound || rtLoadInt(rtOffset(ch, 40)) == 0
}

pub fn rtTaskBody<T>(s: ptr, sink f: once fn() -> T) {
    rtWrite<T>(rtOffset(s, 64), f!!())
    if rtLoadInt(rtOffset(s, 16)) == 1 {
        rtDropAt<T>(rtOffset(s, 64))
    }
}

//~ Whether the running task was asked to stop (`t.cancel()`). A task that wants to stop early looks at this between
//~ steps; nothing is interrupted and nothing unwinds. Always false in `main`.
pub fn cancelled() -> bool {
    if rtCur == 0 { return false }
    rtLoadInt(rtOffset(rtCast<int, ptr>(rtCur), 48)) != 0
}

impl<T> task<T> {
    //~ Asks the task to stop: it sees `cancelled()` become true. It still has to be joined (or dropped) as usual.
    fn cancel(self) {
        rtStoreInt(rtOffset(self.state, 48), 1)
        rtIdle = 0
    }

    fn join(sink self) -> T {
        const s = self.state
        while rtLoadInt(s) != 1 {
            rtWait("a task to finish")
        }
        rtIdle = 0
        const r = rtRead<T>(rtOffset(s, 64))
        rtFree(s)
        rtForgetTask<T>(sink self)
        r
    }
}

//~ Gives up a task handle without running its `deinit`.
pub fn rtForgetTask<T>(sink t: task<T>) {
    rtCast<task<T>, ptr>(sink t)
}

//~ Starts `f` as a task. What the closure uses must be copied or moved in (`sink x ~> ...`).
pub fn spawn<T>(sink f: once fn() -> T) -> task<T> {
    rtMainInit()
    rtIdle = 0
    const s = rtAlloc(64 + rtSizeOf<T>())
    const stack = rtStackTake()
    rtStorePtr(rtOffset(s, 24), stack)
    const runner = [sink f, sink s] () ~> rtTaskBody<T>(s, sink f)
    rtWrite<once fn()>(rtOffset(s, 32), sink runner)
    rtStorePtr(rtOffset(s, 8), rtCtxInit(stack, RT_TASK_STACK, rtFnAddr(rtTaskEntry), rtNull()))
    rtTasks.push!(rtAddrInt(s))
    task<T> { state: s }
}

//~ The handle of `scope s { ... }`. `s.spawn(task)` starts a task that is finished when the scope ends.
pub struct scope_handle {
    id: int
}

impl scope_handle {
    fn spawn<T>(self, sink f: once fn() -> T) -> task<T> = spawn(sink f)
}

/// A channel block: [buffer][capacity in slots][head][length][senders][receiver alive][bound][slot size].
/// The buffer is a ring of flat slots, one per value: `send` moves the value's bytes into a slot, `recv` moves them
/// out, so nothing is shared between tasks. `bound` is the capacity asked for (0: unbounded, the ring grows).

pub struct sender<T> {
    ch: ptr

    deinit {
        const n = rtLoadInt(rtOffset(self.ch, 32)) - 1
        rtStoreInt(rtOffset(self.ch, 32), n)
        rtIdle = 0
        if n == 0 && rtLoadInt(rtOffset(self.ch, 40)) == 0 { rtChanFree<T>(self.ch) }
    }
}

pub struct receiver<T> {
    ch: ptr

    deinit {
        rtStoreInt(rtOffset(self.ch, 40), 0)
        rtIdle = 0
        if rtLoadInt(rtOffset(self.ch, 32)) == 0 { rtChanFree<T>(self.ch) }
    }
}

//~ The address of the n-th queued slot.
fn rtChanSlot(ch: ptr, n: int) -> ptr {
    const cap = rtLoadInt(rtOffset(ch, 8))
    const at = (rtLoadInt(rtOffset(ch, 16)) + n) % cap
    rtOffset(rtLoadPtr(ch), at * rtLoadInt(rtOffset(ch, 56)))
}

pub fn rtChanFree<T>(ch: ptr) {
    var i = 0
    const len = rtLoadInt(rtOffset(ch, 24))
    while i < len {
        rtDropAt<T>(rtChanSlot(ch, i))
        i += 1
    }
    rtFree(rtLoadPtr(ch))
    rtFree(ch)
}

//~ A channel: a sender end and a receiver end. With a capacity, `send` waits while that many values are queued;
//~ a capacity of 0 means unbounded.
pub fn chan<T>(capacity: int = 0) -> (sender<T>, receiver<T>) {
    const ch = rtAlloc(64)
    const slot = if rtSizeOf<T>() == 0 { 8 } else { rtSizeOf<T>() }
    const cap = if capacity > 0 { capacity } else { 8 }
    rtStorePtr(ch, rtAlloc(cap * slot))
    rtStoreInt(rtOffset(ch, 8), cap)
    rtStoreInt(rtOffset(ch, 32), 1)
    rtStoreInt(rtOffset(ch, 40), 1)
    rtStoreInt(rtOffset(ch, 48), capacity)
    rtStoreInt(rtOffset(ch, 56), slot)
    (sender<T> { ch: ch }, receiver<T> { ch: ch })
}

//~ Doubles the ring of an unbounded channel that is full, keeping the queued values in order.
fn rtChanGrow(ch: ptr) {
    const cap = rtLoadInt(rtOffset(ch, 8))
    const slot = rtLoadInt(rtOffset(ch, 56))
    const len = rtLoadInt(rtOffset(ch, 24))
    const fresh = rtAlloc(cap * 2 * slot)
    var i = 0
    while i < len {
        rtCopy(rtOffset(fresh, i * slot), rtChanSlot(ch, i), slot)
        i += 1
    }
    rtFree(rtLoadPtr(ch))
    rtStorePtr(ch, fresh)
    rtStoreInt(rtOffset(ch, 8), cap * 2)
    rtStoreInt(rtOffset(ch, 16), 0)
}

impl<T> sender<T> {
    //~ Queues the value; waits while a bounded channel is full. `closed` when the receiver is gone.
    fn send(self, sink value: T) -> void ! closed {
        const ch = self.ch
        var sent = false
        while !sent && rtLoadInt(rtOffset(ch, 40)) != 0 {
            const bound = rtLoadInt(rtOffset(ch, 48))
            if bound == 0 || rtLoadInt(rtOffset(ch, 24)) < bound {
                if rtLoadInt(rtOffset(ch, 24)) == rtLoadInt(rtOffset(ch, 8)) { rtChanGrow(ch) }
                const len = rtLoadInt(rtOffset(ch, 24))
                rtWrite<T>(rtChanSlot(ch, len), sink value)
                rtStoreInt(rtOffset(ch, 24), len + 1)
                rtIdle = 0
                sent = true
            } else {
                rtWait("room in a channel")
            }
        }
        if !sent {
            return err(closed {})
        }
    }
}

//~ More senders: `copy tx`.
impl<T> clone for sender<T> {
    fn clone(self) -> sender<T> {
        rtStoreInt(rtOffset(self.ch, 32), rtLoadInt(rtOffset(self.ch, 32)) + 1)
        sender<T> { ch: self.ch }
    }
}

impl<T> receiver<T> {
    fn tryRecv(self) -> T? {
        const ch = self.ch
        const len = rtLoadInt(rtOffset(ch, 24))
        if len == 0 { return none }
        const v = rtRead<T>(rtChanSlot(ch, 0))
        rtStoreInt(rtOffset(ch, 16), (rtLoadInt(rtOffset(ch, 16)) + 1) % rtLoadInt(rtOffset(ch, 8)))
        rtStoreInt(rtOffset(ch, 24), len - 1)
        rtIdle = 0
        return v
    }

    //~ Waits for a value: other tasks run while the queue is empty. `none` when every sender is gone.
    fn recv(self) -> T? {
        while rtLoadInt(rtOffset(self.ch, 24)) == 0 {
            if rtLoadInt(rtOffset(self.ch, 32)) == 0 { return none }
            rtWait("a value")
        }
        return self.tryRecv()
    }

    fn iter(self) -> iter<T> {
        var out: list<T> = []
        var more = true
        while more {
            const v = self.recv()
            switch v {
                case some(x): out.push!(x)
                case none: more = false
            }
        }
        rtCast<list<T>, iter<T>>(sink out)
    }
}

//~ Read-only data counted across threads: `shared(value)`, and `copy handle` for another handle.
pub struct shared<T> {
    p: ptr

    init(sink value: T) {
        const p = rtAlloc(8 + rtSizeOf<T>())
        rtStoreInt(p, 1)
        rtWrite<T>(rtOffset(p, 8), sink value)
        self.p = p
    }

    deinit {
        const n = rtLoadInt(self.p) - 1
        rtStoreInt(self.p, n)
        if n == 0 {
            rtDropAt<T>(rtOffset(self.p, 8))
            rtFree(self.p)
        }
    }
}

impl<T> shared<T> {
    fn get(self) -> T = rtClone<T>(rtOffset(self.p, 8))
}

impl<T> clone for shared<T> {
    fn clone(self) -> shared<T> {
        rtStoreInt(self.p, rtLoadInt(self.p) + 1)
        shared<T> { p: self.p }
    }
}

//~ Data changed from several threads one at a time: `lock(value)`. Access is through `with`; `copy handle` for
//~ another handle to the same lock, which another task can own.
pub struct lock<T> {
    p: ptr

    init(sink value: T) {
        /// The block: [held: 0 or 1][handles][value].
        const p = rtAlloc(16 + rtSizeOf<T>())
        rtStoreInt(rtOffset(p, 8), 1)
        rtWrite<T>(rtOffset(p, 16), sink value)
        self.p = p
    }

    deinit {
        const n = rtLoadInt(rtOffset(self.p, 8)) - 1
        rtStoreInt(rtOffset(self.p, 8), n)
        if n == 0 {
            rtDropAt<T>(rtOffset(self.p, 16))
            rtFree(self.p)
        }
    }
}

impl<T> lock<T> {
    //~ Runs `f` with the value, one task at a time: a task that finds the lock held waits, also when the holder
    //~ itself waits inside `f` (on a channel, say).
    fn with<R>(self, f: fn(inout T) -> R) -> R {
        while rtLoadInt(self.p) != 0 {
            rtWait("a lock")
        }
        rtStoreInt(self.p, 1)
        var v = rtRead<T>(rtOffset(self.p, 16))
        const r = f(inout v)
        rtWrite<T>(rtOffset(self.p, 16), sink v)
        rtStoreInt(self.p, 0)
        rtIdle = 0
        r
    }

    //~ Like `with`, but waits until `ready` accepts the value (the lock is free while it waits): a condition
    //~ variable without the separate type.
    fn withWhen<R>(self, ready: fn(T) -> bool, f: fn(inout T) -> R) -> R {
        while true {
            while rtLoadInt(self.p) != 0 {
                rtWait("a lock")
            }
            rtStoreInt(self.p, 1)
            var v = rtRead<T>(rtOffset(self.p, 16))
            if ready(v) {
                const r = f(inout v)
                rtWrite<T>(rtOffset(self.p, 16), sink v)
                rtStoreInt(self.p, 0)
                rtIdle = 0
                return r
            }
            rtWrite<T>(rtOffset(self.p, 16), sink v)
            rtStoreInt(self.p, 0)
            rtWait("a lock condition")
        }
        panic("unreachable")
    }
}

impl<T> clone for lock<T> {
    fn clone(self) -> lock<T> {
        rtStoreInt(rtOffset(self.p, 8), rtLoadInt(rtOffset(self.p, 8)) + 1)
        lock<T> { p: self.p }
    }
}

//~ A count of permits: `semaphore(n)`; `acquire` waits for one, `release` returns one. `copy handle` shares it.
pub struct semaphore {
    p: ptr

    init(permits: int) {
        /// The block: [permits][handles].
        const p = rtAlloc(16)
        rtStoreInt(p, permits)
        rtStoreInt(rtOffset(p, 8), 1)
        self.p = p
    }

    deinit {
        const n = rtLoadInt(rtOffset(self.p, 8)) - 1
        rtStoreInt(rtOffset(self.p, 8), n)
        if n == 0 {
            rtFree(self.p)
        }
    }
}

impl semaphore {
    fn acquire(self) {
        while rtLoadInt(self.p) <= 0 {
            rtWait("a semaphore permit")
        }
        rtStoreInt(self.p, rtLoadInt(self.p) - 1)
        rtIdle = 0
    }

    fn release(self) {
        rtStoreInt(self.p, rtLoadInt(self.p) + 1)
        rtIdle = 0
    }
}

impl clone for semaphore {
    fn clone(self) -> semaphore {
        rtStoreInt(rtOffset(self.p, 8), rtLoadInt(rtOffset(self.p, 8)) + 1)
        semaphore { p: self.p }
    }
}

//~ A meeting point for `n` tasks: `barrier(n)`; `wait` returns once all `n` have called it, and the barrier
//~ can be used again. `copy handle` shares it.
pub struct barrier {
    p: ptr

    init(n: int) {
        /// The block: [n][arrived][generation][handles].
        const p = rtAlloc(32)
        rtStoreInt(p, n)
        rtStoreInt(rtOffset(p, 8), 0)
        rtStoreInt(rtOffset(p, 16), 0)
        rtStoreInt(rtOffset(p, 24), 1)
        self.p = p
    }

    deinit {
        const n = rtLoadInt(rtOffset(self.p, 24)) - 1
        rtStoreInt(rtOffset(self.p, 24), n)
        if n == 0 {
            rtFree(self.p)
        }
    }
}

impl barrier {
    fn wait(self) {
        const gen = rtLoadInt(rtOffset(self.p, 16))
        const arrived = rtLoadInt(rtOffset(self.p, 8)) + 1
        if arrived >= rtLoadInt(self.p) {
            rtStoreInt(rtOffset(self.p, 8), 0)
            rtStoreInt(rtOffset(self.p, 16), gen + 1)
            rtIdle = 0
            return
        }
        rtStoreInt(rtOffset(self.p, 8), arrived)
        while rtLoadInt(rtOffset(self.p, 16)) == gen {
            rtWait("a barrier")
        }
    }
}

impl clone for barrier {
    fn clone(self) -> barrier {
        rtStoreInt(rtOffset(self.p, 24), rtLoadInt(rtOffset(self.p, 24)) + 1)
        barrier { p: self.p }
    }
}

//~ The coroutine's block: [done][coroutine context][resumer context][stack][closure: 16 bytes][value ready][started]
//~ [cancelled][value]. A coroutine runs on a stack of its own and only when its owner calls `next()`.
pub var rtCoCur: int = 0

const RT_CO_STACK = 65536

//~ A function that produces values one at a time: `coroutine<int>(co ~> { co.emit(1) })`; `g.next()` runs it up to
//~ its next `emit`. Dropping an unfinished one asks it to stop (`co.cancelled()`) and resumes it once; whatever it
//~ still holds then is not dropped, since nothing unwinds.
pub struct coroutine<T> {
    p: ptr

    init(sink f: once fn(yielder<T>)) {
        const p = rtAlloc(72 + rtSizeOf<T>())
        const stack = rtAlloc(RT_CO_STACK)
        rtStorePtr(rtOffset(p, 24), stack)
        const runner = [sink f, sink p] () ~> rtCoBody<T>(p, sink f)
        rtWrite<once fn()>(rtOffset(p, 32), sink runner)
        rtStorePtr(rtOffset(p, 8), rtCtxInit(stack, RT_CO_STACK, rtFnAddr(rtCoEntry), rtNull()))
        self.p = p
    }

    deinit {
        const p = self.p
        if rtLoadInt(rtOffset(p, 56)) == 0 {
            /// Never started: only the closure is left.
            rtDropAt<once fn()>(rtOffset(p, 32))
        } else if rtLoadInt(p) == 0 {
            rtStoreInt(rtOffset(p, 56 + 8), 1)
            if rtCoResume(p) { rtDropAt<T>(rtOffset(p, 72)) }
        }
        rtFree(rtLoadPtr(rtOffset(p, 24)))
        rtFree(p)
    }
}

//~ What a coroutine's body receives: `emit` hands a value out and waits for the next `next()`.
pub struct yielder<T> {
    p: ptr
}

pub fn rtCoBody<T>(p: ptr, sink f: once fn(yielder<T>)) {
    f!!(yielder<T> { p: p })
}

fn rtCoEntry() {
    const p = rtCast<int, ptr>(rtCoCur)
    rtCoRunClosure(p)
    rtStoreInt(p, 1)
    rtCtxSwitch(rtOffset(p, 8), rtLoadPtr(rtOffset(p, 16)))
    panic("a finished coroutine ran again")
}

//~ Its own function so the closure is dropped before the coroutine ends: `rtCoEntry` never returns.
fn rtCoRunClosure(p: ptr) {
    const g = rtRead<once fn()>(rtOffset(p, 32))
    g!!()
}

//~ Runs the coroutine until it emits or ends; whether a value is waiting in its block.
fn rtCoResume(p: ptr) -> bool {
    const saved = rtCoCur
    rtCoCur = rtAddrInt(p)
    rtStoreInt(rtOffset(p, 56), 1)
    rtCtxSwitch(rtOffset(p, 16), rtLoadPtr(rtOffset(p, 8)))
    rtCoCur = saved
    rtLoadInt(rtOffset(p, 48)) != 0
}

impl<T> yielder<T> {
    fn emit(self, sink v: T) {
        rtWrite<T>(rtOffset(self.p, 72), sink v)
        rtStoreInt(rtOffset(self.p, 48), 1)
        rtCtxSwitch(rtOffset(self.p, 8), rtLoadPtr(rtOffset(self.p, 16)))
    }

    //~ True once the coroutine's owner dropped it: finish up and return.
    fn cancelled(self) -> bool = rtLoadInt(rtOffset(self.p, 64)) != 0
}

impl<T> coroutine<T> {
    //~ Runs the coroutine to its next `emit`; `none` once it has ended.
    fn next(self) -> T? {
        const p = self.p
        if rtLoadInt(p) == 1 { return none }
        if !rtCoResume(p) { return none }
        rtStoreInt(rtOffset(p, 48), 0)
        return rtRead<T>(rtOffset(p, 72))
    }

    //~ Runs it to the end and collects what it emits.
    fn iter(self) -> iter<T> {
        var out: list<T> = []
        var more = true
        while more {
            const v = self.next()
            switch v {
                case some(x): out.push!(x)
                case none: more = false
            }
        }
        rtCast<list<T>, iter<T>>(sink out)
    }
}
