/// `iter` and its adapters.

impl<T> iter<T> {
    fn count(self) -> int = rtHdrLen(rtAddrOf(self))

    fn first(self) -> T? {
        const h = rtAddrOf(self)
        if rtHdrLen(h) == 0 { return none }
        return rtClone<T>(rtHdrData(h))
    }

    fn toList(self) -> list<T> = rtCast<iter<T>, list<T>>(rtClone<iter<T>>(rtAddrOf(self)))
    fn map<U>(self, f: fn(T) -> U) -> iter<U> {
        const h = rtAddrOf(self)
        const size = rtSizeOf<T>()
        var out: list<U> = []
        var i = 0
        const n = rtHdrLen(h)
        while i < n {
            out.push!(f(rtClone<T>(rtOffset(rtHdrData(h), i * size))))
            i += 1
        }
        rtCast<list<U>, iter<U>>(sink out)
    }

    fn filter(self, f: fn(T) -> bool) -> iter<T> {
        const h = rtAddrOf(self)
        const size = rtSizeOf<T>()
        var out: list<T> = []
        var i = 0
        const n = rtHdrLen(h)
        while i < n {
            if f(rtClone<T>(rtOffset(rtHdrData(h), i * size))) {
                out.push!(rtClone<T>(rtOffset(rtHdrData(h), i * size)))
            }
            i += 1
        }
        rtCast<list<T>, iter<T>>(sink out)
    }

    fn each(self, f: fn(T)) {
        const h = rtAddrOf(self)
        const size = rtSizeOf<T>()
        var i = 0
        const n = rtHdrLen(h)
        while i < n {
            f(rtClone<T>(rtOffset(rtHdrData(h), i * size)))
            i += 1
        }
    }
    fn toSet(self) -> set<T> {
        const h = rtAddrOf(self)
        const size = rtSizeOf<T>()
        var out: set<T> = set {}
        var i = 0
        const n = rtHdrLen(h)
        while i < n {
            out.insert!(rtClone<T>(rtOffset(rtHdrData(h), i * size)))
            i += 1
        }
        out
    }
}

impl iter<int> {
    fn sum(self) -> int {
        const h = rtAddrOf(self)
        var total = 0
        var i = 0
        const n = rtHdrLen(h)
        while i < n {
            total += rtLoadInt(rtOffset(rtHdrData(h), i * 8))
            i += 1
        }
        total
    }
}

impl iter<float> {
    fn sum(self) -> float {
        const h = rtAddrOf(self)
        var total = 0.0
        var i = 0
        const n = rtHdrLen(h)
        while i < n {
            total += rtLoadFloat(rtOffset(rtHdrData(h), i * 8))
            i += 1
        }
        total
    }
}
