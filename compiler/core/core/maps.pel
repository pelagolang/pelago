/// Insertion-ordered tables: `map` and `set`.

/// ---- Maps and sets: insertion-ordered tables ---------------------------------------------------
///
/// The header has four words: the entries block, the length, the capacity and the index table. The
/// block holds `cap` keys, then (for maps) `cap` values starting at an 8-byte boundary. The index
/// table has `rtTabSize(cap)` slots; see `rtMapTag` for what a slot holds.

//~ A capacity is always 4, 8, 16, ...: twice that is the power of two the table needs.
pub fn rtTabSize(cap: int) -> int = cap << 1

pub fn rtValsOff(cap: int, ksize: int) -> int = (cap *% ksize +% 7) & -8
pub fn rtMapIndex(h: ptr) -> ptr = rtLoadPtr(rtOffset(h, 24))
pub fn rtMapKeyAt(h: ptr, i: int, ksize: int) -> ptr = rtOffset(rtHdrData(h), i *% ksize)

pub fn rtMapValAt(h: ptr, i: int, ksize: int, vsize: int) -> ptr {
    rtOffset(rtHdrData(h), rtValsOff(rtHdrCap(h), ksize) +% i *% vsize)
}

//~ The 32-bit tag of a key: its hash with the high bits folded in. An index slot holds the tag in
//~ its upper half and the entry's position plus one in its lower half (0 when empty), so a table
//~ can be rebuilt without hashing again and a probe skips `eq` for keys with another tag. `size` is
//~ a power of two. The first slot probed is `tag & (size - 1)`, so nearby keys stay in nearby slots;
//~ the next ones are `5 * slot + 1 + perturb` with `perturb` the tag shifted right 5 more each step
//~ (as CPython does), which pulls the higher bits in when keys collide in the low ones.
pub fn rtMapTag(hash: ptr, key: ptr) -> int {
    const h = rtCallInt1(hash, key)
    (h ^ (h >> 17)) & 4294967295
}

pub fn rtSlotPos(v: int) -> int = v & 4294967295
pub fn rtSlotTag(v: int) -> int = (v >> 32) & 4294967295

pub fn rtMapZeroed(size: int) -> ptr {
    const tab = rtAlloc(size << 3)
    var i = 0
    while i < size {
        rtStoreInt(rtOffset(tab, i << 3), 0)
        i += 1
    }
    tab
}

//~ Puts an entry in the first free slot of its probe sequence.
pub fn rtMapPlace(tab: ptr, size: int, tag: int, e: int) {
    const mask = size -% 1
    var s = tag & mask
    var perturb = tag
    while rtLoadInt(rtOffset(tab, s << 3)) != 0 {
        perturb = perturb >> 5
        s = (s *% 5 +% perturb +% 1) & mask
    }
    rtStoreInt(rtOffset(tab, s << 3), (tag << 32) | (e +% 1))
}

//~ Rebuilds the index table from the entries.
pub fn rtMapReindex(h: ptr, ksize: int, hash: ptr) {
    const old = rtMapIndex(h)
    if !rtIsNull(old) { rtFree(old) }
    const cap = rtHdrCap(h)
    if cap == 0 {
        rtStorePtr(rtOffset(h, 24), rtNull())
        return
    }
    const size = rtTabSize(cap)
    const tab = rtMapZeroed(size)
    var e = 0
    const n = rtHdrLen(h)
    while e < n {
        rtMapPlace(tab, size, rtMapTag(hash, rtMapKeyAt(h, e, ksize)), e)
        e += 1
    }
    rtStorePtr(rtOffset(h, 24), tab)
}

pub fn rtMapFind(h: ptr, key: ptr, ksize: int, eq: ptr, hash: ptr) -> int {
    if rtHdrLen(h) == 0 { return -1 }
    return rtMapFindTag(h, key, ksize, eq, rtMapTag(hash, key))
}

//~ The position of the entry whose key (tag `tag`) equals the one at `key`, or -1. The first slot is
//~ tried here, so that this stays small enough to be copied into its callers (where `eq` is known);
//~ a collision goes on in `rtMapProbeSlow`.
pub fn rtMapFindTag(h: ptr, key: ptr, ksize: int, eq: ptr, tag: int) -> int {
    if rtHdrLen(h) == 0 { return -1 }
    const mask = rtTabSize(rtHdrCap(h)) -% 1
    const s = tag & mask
    const v = rtLoadInt(rtOffset(rtMapIndex(h), s << 3))
    if v == 0 { return -1 }
    if rtSlotTag(v) == tag && rtCallBool2(
        eq,
        rtMapKeyAt(h, rtSlotPos(v) -% 1, ksize),
        key,
    ) {
        return rtSlotPos(v) -% 1
    }
    return rtMapProbeSlow(h, key, ksize, eq, tag, s)
}

//~ The rest of the probe sequence of `rtMapFindTag`, after the first slot `s` held another key.
pub fn rtMapProbeSlow(h: ptr, key: ptr, ksize: int, eq: ptr, tag: int, first: int) -> int {
    const tab = rtMapIndex(h)
    const mask = rtTabSize(rtHdrCap(h)) -% 1
    var s = first
    var perturb = tag
    var v = rtLoadInt(rtOffset(tab, s << 3))
    while v != 0 {
        if s != first && rtSlotTag(v) == tag && rtCallBool2(
            eq,
            rtMapKeyAt(h, rtSlotPos(v) -% 1, ksize),
            key,
        ) {
            return rtSlotPos(v) -% 1
        }
        perturb = perturb >> 5
        s = (s *% 5 +% perturb +% 1) & mask
        v = rtLoadInt(rtOffset(tab, s << 3))
    }
    -1
}

pub fn rtMapGrow(h: ptr, ksize: int, vsize: int, hash: ptr) {
    const cap = rtHdrCap(h)
    var ncap = cap * 2
    if ncap < 4 { ncap = 4 }
    const len = rtHdrLen(h)
    const data = rtAlloc(rtValsOff(ncap, ksize) + ncap * vsize)
    const old = rtHdrData(h)
    if len > 0 {
        rtCopy(data, old, len * ksize)
        if vsize > 0 { rtCopy(rtOffset(data, rtValsOff(ncap, ksize)), rtOffset(old, rtValsOff(cap, ksize)), len * vsize) }
    }
    if cap > 0 { rtFree(old) }
    rtStorePtr(h, data)
    rtStoreInt(rtOffset(h, 16), ncap)
    const oldtab = rtMapIndex(h)
    if rtIsNull(oldtab) {
        rtMapReindex(h, ksize, hash)
        return
    }
    /// The tags are in the old table: move them over without hashing the keys again.
    const osize = rtTabSize(cap)
    const size = rtTabSize(ncap)
    const tab = rtMapZeroed(size)
    var j = 0
    while j < osize {
        const v = rtLoadInt(rtOffset(oldtab, j << 3))
        if v != 0 { rtMapPlace(tab, size, rtSlotTag(v), rtSlotPos(v) -% 1) }
        j += 1
    }
    rtFree(oldtab)
    rtStorePtr(rtOffset(h, 24), tab)
}

//~ Makes room for one more entry; the next entry goes at the length.
pub fn rtMapReserve(h: ptr, ksize: int, vsize: int, hash: ptr) {
    if rtHdrLen(h) == rtHdrCap(h) { rtMapGrow(h, ksize, vsize, hash) }
}

//~ Counts the entry just written at the length: it becomes visible and is indexed.
pub fn rtMapCommit(h: ptr, ksize: int, tag: int) {
    const n = rtHdrLen(h)
    rtHdrSetLen(h, n + 1)
    const tab = rtMapIndex(h)
    const size = rtTabSize(rtHdrCap(h))
    rtMapPlace(tab, size, tag, n)
}

//~ Removes the entry at `i` (its key and value must already be dropped or moved out).
pub fn rtMapRemoveAt(h: ptr, i: int, ksize: int, vsize: int, hash: ptr) {
    const n = rtHdrLen(h)
    var j = i
    while j + 1 < n {
        rtCopy(rtMapKeyAt(h, j, ksize), rtMapKeyAt(h, j + 1, ksize), ksize)
        if vsize > 0 { rtCopy(rtMapValAt(h, j, ksize, vsize), rtMapValAt(h, j + 1, ksize, vsize), vsize) }
        j += 1
    }
    rtHdrSetLen(h, n - 1)
    /// Entries after `i` moved down one place: rebuild the table from its tags, without hashing.
    const oldtab = rtMapIndex(h)
    const size = rtTabSize(rtHdrCap(h))
    const tab = rtMapZeroed(size)
    var k = 0
    while k < size {
        const v = rtLoadInt(rtOffset(oldtab, k * 8))
        const p = rtSlotPos(v) - 1
        if v != 0 && p != i {
            rtMapPlace(tab, size, rtSlotTag(v), if p > i { p - 1 } else { p })
        }
        k += 1
    }
    rtFree(oldtab)
    rtStorePtr(rtOffset(h, 24), tab)
}

//~ Used by literals: moves the key at `k` and the value at `v` in (the old value of an equal key is dropped).
pub fn rtMapPut<K, V>(h: ptr, k: ptr, v: ptr) {
    const ks = rtSizeOf<K>()
    const vs = rtSizeOf<V>()
    const hash = rtHashFn<K>()
    const tag = rtMapTag(hash, k)
    const i = rtMapFindTag(h, k, ks, rtEqFn<K>(), tag)
    if i >= 0 {
        rtDropAt<K>(k)
        rtDropAt<V>(rtMapValAt(h, i, ks, vs))
        rtCopy(rtMapValAt(h, i, ks, vs), v, vs)
        return
    }
    rtMapReserve(h, ks, vs, hash)
    const n = rtHdrLen(h)
    rtCopy(rtMapKeyAt(h, n, ks), k, ks)
    rtCopy(rtMapValAt(h, n, ks, vs), v, vs)
    rtMapCommit(h, ks, tag)
}

pub fn rtSetPut<T>(h: ptr, k: ptr) {
    const ks = rtSizeOf<T>()
    const hash = rtHashFn<T>()
    const tag = rtMapTag(hash, k)
    if rtMapFindTag(h, k, ks, rtEqFn<T>(), tag) >= 0 {
        rtDropAt<T>(k)
        return
    }
    rtMapReserve(h, ks, 0, hash)
    rtCopy(rtMapKeyAt(h, rtHdrLen(h), ks), k, ks)
    rtMapCommit(h, ks, tag)
}

pub fn rtMapDrop<K, V>(h: ptr) {
    const ks = rtSizeOf<K>()
    const vs = rtSizeOf<V>()
    var i = 0
    const n = rtHdrLen(h)
    while i < n {
        rtDropAt<K>(rtMapKeyAt(h, i, ks))
        rtDropAt<V>(rtMapValAt(h, i, ks, vs))
        i += 1
    }
    if rtHdrCap(h) > 0 { rtFree(rtHdrData(h)) }
    if !rtIsNull(rtMapIndex(h)) { rtFree(rtMapIndex(h)) }
}

pub fn rtSetDrop<T>(h: ptr) {
    const ks = rtSizeOf<T>()
    var i = 0
    const n = rtHdrLen(h)
    while i < n {
        rtDropAt<T>(rtMapKeyAt(h, i, ks))
        i += 1
    }
    if rtHdrCap(h) > 0 { rtFree(rtHdrData(h)) }
    if !rtIsNull(rtMapIndex(h)) { rtFree(rtMapIndex(h)) }
}

//~ Copies the table: same capacity, same positions, so the index can be copied as it is.
pub fn rtMapCloneTo<K, V>(src: ptr, dst: ptr, vsize: int) {
    const ks = rtSizeOf<K>()
    const cap = rtHdrCap(src)
    const n = rtHdrLen(src)
    rtStoreInt(rtOffset(dst, 8), n)
    rtStoreInt(rtOffset(dst, 16), cap)
    if cap == 0 {
        rtStorePtr(dst, rtNull())
        rtStorePtr(rtOffset(dst, 24), rtNull())
        return
    }
    rtStorePtr(dst, rtAlloc(rtValsOff(cap, ks) + cap * vsize))
    var i = 0
    while i < n {
        rtCloneTo<K>(rtMapKeyAt(src, i, ks), rtMapKeyAt(dst, i, ks))
        i += 1
    }
    const size = rtTabSize(cap)
    const tab = rtAlloc(size * 8)
    rtCopy(tab, rtMapIndex(src), size * 8)
    rtStorePtr(rtOffset(dst, 24), tab)
}

pub fn rtMapClone<K, V>(src: ptr, dst: ptr) {
    rtMapCloneTo<K, V>(src, dst, rtSizeOf<V>())
    const ks = rtSizeOf<K>()
    const vs = rtSizeOf<V>()
    var i = 0
    const n = rtHdrLen(src)
    while i < n {
        rtCloneTo<V>(rtMapValAt(src, i, ks, vs), rtMapValAt(dst, i, ks, vs))
        i += 1
    }
}

pub fn rtSetClone<T>(src: ptr, dst: ptr) {
    rtMapCloneTo<T, int>(src, dst, 0)
}

pub fn rtMapEq<K, V>(a: ptr, b: ptr) -> bool {
    const n = rtHdrLen(a)
    if n != rtHdrLen(b) { return false }
    const ks = rtSizeOf<K>()
    const vs = rtSizeOf<V>()
    const eq = rtEqFn<K>()
    const hash = rtHashFn<K>()
    const veq = rtEqFn<V>()
    var i = 0
    while i < n {
        const tag = rtMapTag(hash, rtMapKeyAt(a, i, ks))
        const j = rtMapFindTag(b, rtMapKeyAt(a, i, ks), ks, eq, tag)
        if j < 0 { return false }
        if !rtCallBool2(
            veq,
            rtMapValAt(a, i, ks, vs),
            rtMapValAt(b, j, ks, vs),
        ) { return false }
        i += 1
    }
    true
}

pub fn rtSetEq<T>(a: ptr, b: ptr) -> bool {
    const n = rtHdrLen(a)
    if n != rtHdrLen(b) { return false }
    const ks = rtSizeOf<T>()
    const eq = rtEqFn<T>()
    const hash = rtHashFn<T>()
    var i = 0
    while i < n {
        const tag = rtMapTag(hash, rtMapKeyAt(a, i, ks))
        if rtMapFindTag(b, rtMapKeyAt(a, i, ks), ks, eq, tag) < 0 { return false }
        i += 1
    }
    true
}

pub fn rtMapShow<K, V>(h: ptr, out: ptr) {
    const ks = rtSizeOf<K>()
    const vs = rtSizeOf<V>()
    const n = rtHdrLen(h)
    if n == 0 {
        rtPushChar(out, '{')
        rtPushChar(out, ':')
        rtPushChar(out, '}')
        return
    }
    rtPushChar(out, '{')
    var i = 0
    while i < n {
        if i > 0 {
            rtPushChar(out, ',')
            rtPushChar(out, ' ')
        }
        rtShowItemTo<K>(rtMapKeyAt(h, i, ks), out)
        rtPushChar(out, ':')
        rtPushChar(out, ' ')
        rtShowItemTo<V>(rtMapValAt(h, i, ks, vs), out)
        i += 1
    }
    rtPushChar(out, '}')
}

pub fn rtSetShow<T>(h: ptr, out: ptr) {
    const ks = rtSizeOf<T>()
    const n = rtHdrLen(h)
    rtPushChar(out, '{')
    var i = 0
    while i < n {
        if i > 0 {
            rtPushChar(out, ',')
            rtPushChar(out, ' ')
        }
        rtShowItemTo<T>(rtMapKeyAt(h, i, ks), out)
        i += 1
    }
    rtPushChar(out, '}')
}

impl<K, V> map<K, V> {
    fn len(self) -> int = rtHdrLen(rtAddrOf(self))
    fn isEmpty(self) -> bool = rtHdrLen(rtAddrOf(self)) == 0

    fn get(self, key: K) -> V? {
        const h = rtAddrOf(self)
        const ks = rtSizeOf<K>()
        const i = rtMapFind(h, rtAddrOf(key), ks, rtEqFn<K>(), rtHashFn<K>())
        if i < 0 { return none }
        return rtClone<V>(rtMapValAt(h, i, ks, rtSizeOf<V>()))
    }

    fn containsKey(self, key: K) -> bool {
        rtMapFind(
            rtAddrOf(self),
            rtAddrOf(key),
            rtSizeOf<K>(),
            rtEqFn<K>(),
            rtHashFn<K>(),
        ) >= 0
    }

    fn insert(inout self, sink key: K, sink value: V) -> V? {
        const h = rtAddrOf(self)
        const ks = rtSizeOf<K>()
        const vs = rtSizeOf<V>()
        const hash = rtHashFn<K>()
        const tag = rtMapTag(hash, rtAddrOf(key))
        const i = rtMapFindTag(h, rtAddrOf(key), ks, rtEqFn<K>(), tag)
        if i >= 0 {
            const old = rtRead<V>(rtMapValAt(h, i, ks, vs))
            rtWrite<V>(rtMapValAt(h, i, ks, vs), sink value)
            return old
        }
        rtMapReserve(h, ks, vs, hash)
        const n = rtHdrLen(h)
        rtWrite<K>(rtMapKeyAt(h, n, ks), sink key)
        rtWrite<V>(rtMapValAt(h, n, ks, vs), sink value)
        rtMapCommit(h, ks, tag)
        none
    }

    fn remove(inout self, key: K) -> V? {
        const h = rtAddrOf(self)
        const ks = rtSizeOf<K>()
        const vs = rtSizeOf<V>()
        const hash = rtHashFn<K>()
        const tag = rtMapTag(hash, rtAddrOf(key))
        const i = rtMapFindTag(h, rtAddrOf(key), ks, rtEqFn<K>(), tag)
        if i < 0 { return none }
        const old = rtRead<V>(rtMapValAt(h, i, ks, vs))
        rtDropAt<K>(rtMapKeyAt(h, i, ks))
        rtMapRemoveAt(h, i, ks, vs, hash)
        return old
    }

    fn clear(inout self) {
        const h = rtAddrOf(self)
        const ks = rtSizeOf<K>()
        const vs = rtSizeOf<V>()
        var i = 0
        const n = rtHdrLen(h)
        while i < n {
            rtDropAt<K>(rtMapKeyAt(h, i, ks))
            rtDropAt<V>(rtMapValAt(h, i, ks, vs))
            i += 1
        }
        rtHdrSetLen(h, 0)
        rtMapReindex(h, ks, rtHashFn<K>())
    }

    fn keys(self) -> iter<K> {
        const h = rtAddrOf(self)
        const ks = rtSizeOf<K>()
        var out: list<K> = []
        var i = 0
        const n = rtHdrLen(h)
        while i < n {
            out.push!(rtClone<K>(rtMapKeyAt(h, i, ks)))
            i += 1
        }
        rtCast<list<K>, iter<K>>(sink out)
    }

    fn values(self) -> iter<V> {
        const h = rtAddrOf(self)
        const ks = rtSizeOf<K>()
        const vs = rtSizeOf<V>()
        var out: list<V> = []
        var i = 0
        const n = rtHdrLen(h)
        while i < n {
            out.push!(rtClone<V>(rtMapValAt(h, i, ks, vs)))
            i += 1
        }
        rtCast<list<V>, iter<V>>(sink out)
    }
}

impl<T> set<T> {
    fn len(self) -> int = rtHdrLen(rtAddrOf(self))
    fn isEmpty(self) -> bool = rtHdrLen(rtAddrOf(self)) == 0

    fn contains(self, item: T) -> bool {
        rtMapFind(
            rtAddrOf(self),
            rtAddrOf(item),
            rtSizeOf<T>(),
            rtEqFn<T>(),
            rtHashFn<T>(),
        ) >= 0
    }

    fn insert(inout self, sink item: T) -> bool {
        const h = rtAddrOf(self)
        const ks = rtSizeOf<T>()
        const hash = rtHashFn<T>()
        const tag = rtMapTag(hash, rtAddrOf(item))
        if rtMapFindTag(h, rtAddrOf(item), ks, rtEqFn<T>(), tag) >= 0 { return false }
        rtMapReserve(h, ks, 0, hash)
        rtWrite<T>(rtMapKeyAt(h, rtHdrLen(h), ks), sink item)
        rtMapCommit(h, ks, tag)
        true
    }

    fn remove(inout self, item: T) -> bool {
        const h = rtAddrOf(self)
        const ks = rtSizeOf<T>()
        const hash = rtHashFn<T>()
        const tag = rtMapTag(hash, rtAddrOf(item))
        const i = rtMapFindTag(h, rtAddrOf(item), ks, rtEqFn<T>(), tag)
        if i < 0 { return false }
        rtDropAt<T>(rtMapKeyAt(h, i, ks))
        rtMapRemoveAt(h, i, ks, 0, hash)
        true
    }

    fn clear(inout self) {
        const h = rtAddrOf(self)
        const ks = rtSizeOf<T>()
        var i = 0
        const n = rtHdrLen(h)
        while i < n {
            rtDropAt<T>(rtMapKeyAt(h, i, ks))
            i += 1
        }
        rtHdrSetLen(h, 0)
        rtMapReindex(h, ks, rtHashFn<T>())
    }

    fn iter(self) -> iter<T> {
        const h = rtAddrOf(self)
        const ks = rtSizeOf<T>()
        var out: list<T> = []
        var i = 0
        const n = rtHdrLen(h)
        while i < n {
            out.push!(rtClone<T>(rtMapKeyAt(h, i, ks)))
            i += 1
        }
        rtCast<list<T>, iter<T>>(sink out)
    }
}
