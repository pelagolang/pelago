//~ The always-available library. Names declared `pub` here are in scope in every module.
//~
//~ Functions declared `ext` have no body here: the backend provides them. The signatures are what
//~ the checker needs.

//~ Anything that can be printed and put into a `#( )` string.
pub interface show {
    fn show(self) -> string
}

//~ Equality with `==`. Plain `struct` and `enum` types have it already; an `obj` must say so.
pub interface eq {
    fn eq(self, other: Self) -> bool
}

//~ Ordering with `<`, `>`, `<=`, `>=`: a negative, zero or positive number.
pub interface order : eq {
    fn cmp(self, other: Self) -> int
}

//~ Use as a key of a `map` or a member of a `set` (together with `eq`).
pub interface hash : eq {
    fn hash(self) -> int
}

//~ Types that `copy` can duplicate. Plain data has it already; an `obj` must write `clone`.
pub interface clone {
    fn clone(self) -> Self
}

//~ Lets `?` and `to` turn one error type into another: `impl converts<app_error> for parse_error`.
//~ (`converts` is a placeholder name.)
pub interface converts<E> {
    fn convert(self) -> E
}

//~ One interface per operator: `impl add for vec2 { fn add(self, other: vec2) -> vec2 ... }`.
pub interface add {
    fn add(self, other: Self) -> Self
}
pub interface sub {
    fn sub(self, other: Self) -> Self
}
pub interface mul {
    fn mul(self, other: Self) -> Self
}
pub interface div {
    fn div(self, other: Self) -> Self
}
pub interface rem {
    fn rem(self, other: Self) -> Self
}
pub interface neg {
    fn neg(self) -> Self
}

//~ A failed text-to-number conversion.
pub struct parse_error {
    pub message: string
}

impl show for parse_error {
    fn show(self) -> string = copy self.message
}

pub ext fn print(...values: any show)
pub ext fn assert(condition: bool)
pub ext fn panic(message: string) -> never
pub ext fn todo() -> never
pub ext fn unreachable() -> never

/// ---- Intrinsics: what the compiler expands in place ---------------------------------------------------
///
/// The library below is written in the language over these few operations. `ptr` is a raw address;
/// nothing here is checked, so only this file uses them.

pub ext fn rt_null() -> ptr
pub ext fn rt_alloc(size: int) -> ptr
pub ext fn rt_free(p: ptr)
//~ A block of `size` bytes holding the first bytes of `p` (null allocates), the rest zero; `p` is dead afterwards.
pub ext fn rt_realloc(p: ptr, size: int) -> ptr
//~ A context: a stack at `base` of `size` bytes that starts by calling `code(env)` (a closure's two words), which must never return.
//~ Nothing runs until something switches to the handle it returns.
pub ext fn rt_ctx_init(base: ptr, size: int, code: ptr, env: ptr) -> ptr
//~ Saves where this context stands at `save` and continues the context `to`; comes back when something switches to the saved handle.
pub ext fn rt_ctx_switch(save: ptr, to: ptr)
pub ext fn rt_offset(p: ptr, bytes: int) -> ptr
pub ext fn rt_copy(dst: ptr, src: ptr, bytes: int)
pub ext fn rt_is_null(p: ptr) -> bool
pub ext fn rt_addr_int(p: ptr) -> int
pub ext fn rt_load_int(p: ptr) -> int
pub ext fn rt_store_int(p: ptr, v: int)
pub ext fn rt_load_byte(p: ptr) -> uint8
pub ext fn rt_store_byte(p: ptr, v: uint8)
pub ext fn rt_load_ptr(p: ptr) -> ptr
pub ext fn rt_store_ptr(p: ptr, v: ptr)
pub ext fn rt_load_float(p: ptr) -> float
pub ext fn rt_store_float(p: ptr, v: float)
pub ext fn rt_load_char(p: ptr) -> char
pub ext fn rt_store_char(p: ptr, v: char)
pub ext fn rt_load_bool(p: ptr) -> bool
pub ext fn rt_store_bool(p: ptr, v: bool)
pub ext fn rt_print(p: ptr, n: int)
pub ext fn rt_to_byte(n: int) -> uint8
pub ext fn rt_to_int(x: float) -> int
pub ext fn rt_fma(a: float, b: float, c: float) -> float
pub ext fn rt_to_char(n: int) -> char
pub ext fn rt_show_to<T>(src: ptr, out: ptr)
pub ext fn rt_show_item_to<T>(src: ptr, out: ptr)
pub ext fn rt_size_of<T>() -> int
pub ext fn rt_is_int<T>() -> bool
pub ext fn rt_addr_of<T>(x: T) -> ptr
pub ext fn rt_write<T>(dst: ptr, sink value: T)
pub ext fn rt_read<T>(src: ptr) -> T
pub ext fn rt_clone<T>(src: ptr) -> T
pub ext fn rt_clone_to<T>(src: ptr, dst: ptr)
pub ext fn rt_drop_at<T>(p: ptr)
pub ext fn rt_cast<A, B>(sink x: A) -> B
pub ext fn rt_drop_fn<T>() -> ptr
pub ext fn rt_clone_fn<T>() -> ptr
pub ext fn rt_eq_fn<T>() -> ptr
pub ext fn rt_cmp_fn<T>() -> ptr
pub ext fn rt_hash_fn<T>() -> ptr
pub ext fn rt_show_fn<T>() -> ptr
//~ The `show` slot of an `any show` table for a type that has no `show` method of its own (numbers, lists, ...).
fn rt_any_show<T>(out: ptr, src: ptr) {
    rt_show_to<T>(src, out)
}
pub ext fn rt_call_void1(f: ptr, a: ptr)
pub ext fn rt_call_void2(f: ptr, a: ptr, b: ptr)
pub ext fn rt_call_bool2(f: ptr, a: ptr, b: ptr) -> bool
pub ext fn rt_call_int2(f: ptr, a: ptr, b: ptr) -> int
pub ext fn rt_call_int1(f: ptr, a: ptr) -> int

/// ---- Growing buffers: the header of a list or string is a pointer, a length and a capacity -----

fn rt_hdr_data(h: ptr) -> ptr = rt_load_ptr(h)
fn rt_hdr_len(h: ptr) -> int = rt_load_int(rt_offset(h, 8))
fn rt_hdr_cap(h: ptr) -> int = rt_load_int(rt_offset(h, 16))
fn rt_hdr_set_len(h: ptr, n: int) { rt_store_int(rt_offset(h, 8), n) }

//~ Makes room for `needed` elements of `size` bytes. A capacity of 0 means the buffer is not owned.
//~ Small on purpose, so the optimiser inlines the check into every push loop; only a full buffer calls `rt_grow_slow`.
fn rt_grow(h: ptr, size: int, needed: int) {
    if rt_hdr_cap(h) >= needed { return }
    rt_grow_slow(h, size, needed)
}

fn rt_grow_slow(h: ptr, size: int, needed: int) {
    const cap = rt_hdr_cap(h)
    var ncap = cap * 2
    if ncap < 4 { ncap = 4 }
    if ncap < needed { ncap = needed }
    const old = rt_hdr_data(h)
    if cap > 0 {
        /// An owned buffer: a big one is remapped by the system instead of copied.
        rt_store_ptr(h, rt_realloc(old, ncap * size))
    } else {
        const data = rt_alloc(ncap * size)
        const len = rt_hdr_len(h)
        if len > 0 { rt_copy(data, old, len * size) }
        rt_store_ptr(h, data)
    }
    rt_store_int(rt_offset(h, 16), ncap)
}

//~ Exchanges two blocks of `size` bytes.
fn rt_swap_bytes(a: ptr, b: ptr, size: int) {
    const tmp = rt_alloc(size)
    rt_copy(tmp, a, size)
    rt_copy(a, b, size)
    rt_copy(b, tmp, size)
    rt_free(tmp)
}

//~ Sorts `n` elements of `size` bytes with a merge sort; `cmp` is a comparison glue function.
fn rt_sort(base: ptr, n: int, size: int, cmp: ptr) {
    if n < 2 { return }
    const tmp = rt_alloc(n * size)
    var width = 1
    var from = base
    var to = tmp
    while width < n {
        var start = 0
        while start < n {
            var mid = start + width
            if mid > n { mid = n }
            var end = start + 2 * width
            if end > n { end = n }
            var i = start
            var j = mid
            var k = start
            while k < end {
                if i < mid &&
                    (j >= end || rt_call_int2(cmp, rt_offset(from, i * size), rt_offset(from, j * size)) <= 0) {
                    rt_copy(rt_offset(to, k * size), rt_offset(from, i * size), size)
                    i += 1
                } else {
                    rt_copy(rt_offset(to, k * size), rt_offset(from, j * size), size)
                    j += 1
                }
                k += 1
            }
            start += 2 * width
        }
        const swapped = from
        from = to
        to = swapped
        width *= 2
    }
    if rt_addr_int(from) != rt_addr_int(base) { rt_copy(base, from, n * size) }
    rt_free(tmp)
}

//~ Sorts `n` integers at `base`: insertion sort when short, else a radix sort on the eight bytes (the
//~ order of equal integers cannot be seen, so the result is the same as for any stable sort).
fn rt_sort_int(base: ptr, n: int) {
    if n < 2 { return }
    if n <= 48 {
        var i = 1
        while i < n {
            const x = rt_load_int(rt_offset(base, i * 8))
            var j = i
            while j > 0 && rt_load_int(rt_offset(base, (j - 1) * 8)) > x {
                rt_store_int(rt_offset(base, j * 8), rt_load_int(rt_offset(base, (j - 1) * 8)))
                j -= 1
            }
            rt_store_int(rt_offset(base, j * 8), x)
            i += 1
        }
        return
    }
    const tmp = rt_alloc(n * 8)
    const counts = rt_alloc(16384)
    var z = 0
    while z < 2048 { rt_store_int(rt_offset(counts, z * 8), 0); z += 1 }
    /// One pass over the data counts every byte position.
    var i = 0
    while i < n {
        const x = rt_load_int(rt_offset(base, i * 8))
        var p = 0
        while p < 8 {
            var d = (x >> (p * 8)) & 255
            if p == 7 { d = d ^ 128 }
            const c = rt_offset(counts, (p * 256 + d) * 8)
            rt_store_int(c, rt_load_int(c) +% 1)
            p += 1
        }
        i += 1
    }
    var from = base
    var to = tmp
    var p = 0
    while p < 8 {
        const row = rt_offset(counts, p * 2048)
        /// A byte position where every integer has the same byte needs no pass.
        var busy = 0
        var d = 0
        var sum = 0
        while d < 256 {
            const c = rt_load_int(rt_offset(row, d * 8))
            if c > 0 { busy += 1 }
            rt_store_int(rt_offset(row, d * 8), sum)
            sum = sum +% c
            d += 1
        }
        if busy > 1 {
            var k = 0
            while k < n {
                const x = rt_load_int(rt_offset(from, k * 8))
                var e = (x >> (p * 8)) & 255
                if p == 7 { e = e ^ 128 }
                const c = rt_offset(row, e * 8)
                const at = rt_load_int(c)
                rt_store_int(rt_offset(to, at * 8), x)
                rt_store_int(c, at +% 1)
                k += 1
            }
            const swapped = from
            from = to
            to = swapped
        }
        p += 1
    }
    if rt_addr_int(from) != rt_addr_int(base) { rt_copy(base, from, n * 8) }
    rt_free(counts)
    rt_free(tmp)
}

//~ Is the value at `probe` equal to one of the `size`-byte elements of the list at `h`?
fn rt_list_contains(h: ptr, probe: ptr, size: int, eq: ptr) -> bool {
    var i = 0
    const n = rt_hdr_len(h)
    while i < n {
        if rt_call_bool2(eq, rt_offset(rt_hdr_data(h), i * size), probe) { return true }
        i += 1
    }
    false
}

//~ Does the text at `h` contain the text (or character) at `p`?
fn rt_str_contains(h: ptr, p: ptr) -> bool {
    const n = rt_hdr_len(h)
    const pn = rt_hdr_len(p)
    var i = 0
    while i + pn <= n {
        if rt_bytes_eq(rt_offset(rt_hdr_data(h), i), rt_hdr_data(p), pn) { return true }
        i += 1
    }
    pn == 0
}

impl<T: eq> list<T> {
    fn contains(self, item: T) -> bool {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        const eq = rt_eq_fn<T>()
        const probe = rt_addr_of(item)
        var i = 0
        const len = rt_hdr_len(h)
        while i < len {
            if rt_call_bool2(eq, rt_offset(rt_hdr_data(h), i * size), probe) { return true }
            i += 1
        }
        false
    }
}

impl<T: order> list<T> {
    fn sort(inout self) {
        const h = rt_addr_of(self)
        if rt_is_int<T>() {
            rt_sort_int(rt_hdr_data(h), rt_hdr_len(h))
        } else {
            rt_sort(rt_hdr_data(h), rt_hdr_len(h), rt_size_of<T>(), rt_cmp_fn<T>())
        }
    }

    fn sorted(self) -> list<T> {
        var out = rt_clone<list<T>>(rt_addr_of(self))
        out.sort!()
        out
    }
}

impl<T> list<T> {
    fn len(self) -> int = rt_hdr_len(rt_addr_of(self))
    fn is_empty(self) -> bool = rt_hdr_len(rt_addr_of(self)) == 0

    fn get(self, index: int) -> T? {
        const h = rt_addr_of(self)
        if index < 0 || index >= rt_hdr_len(h) { return none }
        return rt_clone<T>(rt_offset(rt_hdr_data(h), index * rt_size_of<T>()))
    }

    fn first(self) -> T? = self.get(0)
    fn last(self) -> T? = self.get(self.len() - 1)

    fn push(inout self, sink item: T) {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        const len = rt_hdr_len(h)
        rt_grow(h, size, len + 1)
        rt_write<T>(rt_offset(rt_hdr_data(h), len * size), sink item)
        rt_hdr_set_len(h, len + 1)
    }

    fn pop(inout self) -> T? {
        const h = rt_addr_of(self)
        const len = rt_hdr_len(h)
        if len == 0 { return none }
        rt_hdr_set_len(h, len - 1)
        return rt_read<T>(rt_offset(rt_hdr_data(h), (len - 1) * rt_size_of<T>()))
    }

    fn insert(inout self, index: int, sink item: T) {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        const len = rt_hdr_len(h)
        if index < 0 || index > len { panic("insert: index out of range") }
        rt_grow(h, size, len + 1)
        const at = rt_offset(rt_hdr_data(h), index * size)
        var i = len - 1
        while i >= index {
            rt_copy(
                rt_offset(rt_hdr_data(h), (i + 1) * size),
                rt_offset(rt_hdr_data(h), i * size),
                size,
            )
            i -= 1
        }
        rt_write<T>(at, sink item)
        rt_hdr_set_len(h, len + 1)
    }

    fn remove(inout self, index: int) -> T {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        const len = rt_hdr_len(h)
        if index < 0 || index >= len { panic("remove: index out of range") }
        const value = rt_read<T>(rt_offset(rt_hdr_data(h), index * size))
        var i = index
        while i < len - 1 {
            rt_copy(
                rt_offset(rt_hdr_data(h), i * size),
                rt_offset(rt_hdr_data(h), (i + 1) * size),
                size,
            )
            i += 1
        }
        rt_hdr_set_len(h, len - 1)
        value
    }

    fn clear(inout self) {
        const h = rt_addr_of(self)
        const drop = rt_drop_fn<T>()
        const size = rt_size_of<T>()
        if !rt_is_null(drop) {
            var i = 0
            const len = rt_hdr_len(h)
            while i < len {
                rt_call_void1(drop, rt_offset(rt_hdr_data(h), i * size))
                i += 1
            }
        }
        rt_hdr_set_len(h, 0)
    }

    fn reverse(inout self) {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        var i = 0
        var j = rt_hdr_len(h) - 1
        while i < j {
            rt_swap_bytes(
                rt_offset(rt_hdr_data(h), i * size),
                rt_offset(rt_hdr_data(h), j * size),
                size,
            )
            i += 1
            j -= 1
        }
    }

    fn swap(inout self, a: int, b: int) {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        const len = rt_hdr_len(h)
        if a < 0 || a >= len || b < 0 || b >= len { panic("swap: index out of range") }
        if a != b { rt_swap_bytes(rt_offset(rt_hdr_data(h), a * size), rt_offset(rt_hdr_data(h), b * size), size) }
    }

    fn extend(inout self, other: list<T>) {
        const h = rt_addr_of(self)
        const o = rt_addr_of(other)
        const size = rt_size_of<T>()
        var i = 0
        const n = rt_hdr_len(o)
        while i < n {
            self.push!(rt_clone<T>(rt_offset(rt_hdr_data(o), i * size)))
            i += 1
        }
    }

    fn reversed(self) -> list<T> {
        var out = rt_clone<list<T>>(rt_addr_of(self))
        out.reverse!()
        out
    }

    fn iter(self) -> iter<T> = rt_cast<list<T>, iter<T>>(rt_clone<list<T>>(rt_addr_of(self)))
    fn to_list(self) -> list<T> = rt_clone<list<T>>(rt_addr_of(self))
    fn map<U>(self, f: fn(T) -> U) -> iter<U> {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        var out: list<U> = []
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            out.push!(f(rt_clone<T>(rt_offset(rt_hdr_data(h), i * size))))
            i += 1
        }
        rt_cast<list<U>, iter<U>>(sink out)
    }

    fn filter(self, f: fn(T) -> bool) -> iter<T> {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        var out: list<T> = []
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            if f(rt_clone<T>(rt_offset(rt_hdr_data(h), i * size))) {
                out.push!(rt_clone<T>(rt_offset(rt_hdr_data(h), i * size)))
            }
            i += 1
        }
        rt_cast<list<T>, iter<T>>(sink out)
    }

    fn each(self, f: fn(T)) {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            f(rt_clone<T>(rt_offset(rt_hdr_data(h), i * size)))
            i += 1
        }
    }
}

/// ---- Text: strings are a pointer, a length and a capacity (0 means borrowed or static) ---------

fn rt_bytes_eq(a: ptr, b: ptr, n: int) -> bool {
    var i = 0
    while i < n {
        if rt_load_byte(rt_offset(a, i)) != rt_load_byte(rt_offset(b, i)) { return false }
        i += 1
    }
    true
}

//~ Equal text. Both arguments are headers (`string` or `str`: pointer, then length).
fn rt_str_eq(a: ptr, b: ptr) -> bool {
    const n = rt_hdr_len(a)
    if n != rt_hdr_len(b) { return false }
    rt_bytes_eq(rt_hdr_data(a), rt_hdr_data(b), n)
}

//~ Orders text by bytes: negative, zero or positive.
fn rt_str_cmp(a: ptr, b: ptr) -> int {
    const na = rt_hdr_len(a)
    const nb = rt_hdr_len(b)
    var i = 0
    while i < na && i < nb {
        const x = rt_load_byte(rt_offset(rt_hdr_data(a), i)) to int
        const y = rt_load_byte(rt_offset(rt_hdr_data(b), i)) to int
        if x != y { return x < y ? -1 : 1 }
        i += 1
    }
    if na == nb { return 0 }
    na < nb ? -1 : 1
}

fn rt_str_hash(a: ptr) -> int {
    var h = 1469598103934665603
    var i = 0
    const n = rt_hdr_len(a)
    while i < n {
        h = (h ^ (rt_load_byte(rt_offset(rt_hdr_data(a), i)) to int)) *% 1099511628211
        i += 1
    }
    h
}

//~ Appends bytes to the string whose header is `dst`.
fn rt_str_push(dst: ptr, data: ptr, n: int) {
    if n == 0 { return }
    const len = rt_hdr_len(dst)
    rt_grow(dst, 1, len + n)
    rt_copy(rt_offset(rt_hdr_data(dst), len), data, n)
    rt_hdr_set_len(dst, len + n)
}

fn rt_str_concat(dst: ptr, a: ptr, b: ptr) {
    rt_store_ptr(dst, rt_null())
    rt_store_int(rt_offset(dst, 8), 0)
    rt_store_int(rt_offset(dst, 16), 0)
    rt_str_push(dst, rt_hdr_data(a), rt_hdr_len(a))
    rt_str_push(dst, rt_hdr_data(b), rt_hdr_len(b))
}

fn rt_push_byte(out: ptr, b: int) {
    const len = rt_hdr_len(out)
    rt_grow(out, 1, len + 1)
    rt_store_byte(rt_offset(rt_hdr_data(out), len), rt_to_byte(b))
    rt_hdr_set_len(out, len + 1)
}

//~ Appends a character as UTF-8.
fn rt_push_char(out: ptr, c: char) {
    const n = c to int
    if n < 128 {
        rt_push_byte(out, n)
    } else if n < 2048 {
        rt_push_byte(out, 192 | (n >> 6))
        rt_push_byte(out, 128 | (n & 63))
    } else if n < 65536 {
        rt_push_byte(out, 224 | (n >> 12))
        rt_push_byte(out, 128 | ((n >> 6) & 63))
        rt_push_byte(out, 128 | (n & 63))
    } else {
        rt_push_byte(out, 240 | (n >> 18))
        rt_push_byte(out, 128 | ((n >> 12) & 63))
        rt_push_byte(out, 128 | ((n >> 6) & 63))
        rt_push_byte(out, 128 | (n & 63))
    }
}

fn rt_show_int(out: ptr, n: int) {
    if n == 0 {
        rt_push_byte(out, 48)
        return
    }
    /// Digits are produced from the end, using negative numbers so the smallest int works.
    var digits = rt_alloc(24)
    var count = 0
    var m = n > 0 ? 0 - n : n
    while m != 0 {
        const d = 0 - (m % 10)
        rt_store_byte(rt_offset(digits, count), rt_to_byte(48 + d))
        count += 1
        m = m / 10
    }
    if n < 0 { rt_push_byte(out, 45) }
    while count > 0 {
        count -= 1
        rt_push_byte(out, rt_load_byte(rt_offset(digits, count)) to int)
    }
    rt_free(digits)
}

//~ Writes the digits of `n` and a newline into `buf`, right-aligned in 32 bytes (a number takes at
//~ most 21 with the sign); gives the offset of the first one. Used by `print` of one integer, which
//~ then needs no heap.
fn rt_fmt_int_line(buf: ptr, n: int) -> int {
    var at = 31
    rt_store_byte(rt_offset(buf, at), rt_to_byte(10))
    if n == 0 {
        at -= 1
        rt_store_byte(rt_offset(buf, at), rt_to_byte(48))
        return at
    }
    /// From the end, using negative numbers so the smallest int works.
    var m = n > 0 ? 0 - n : n
    while m != 0 {
        const d = 0 - (m % 10)
        at -= 1
        rt_store_byte(rt_offset(buf, at), rt_to_byte(48 + d))
        m = m / 10
    }
    if n < 0 {
        at -= 1
        rt_store_byte(rt_offset(buf, at), rt_to_byte(45))
    }
    at
}

fn rt_show_bool(out: ptr, b: bool) {
    if b {
        rt_push_char(out, 't')
        rt_push_char(out, 'r')
        rt_push_char(out, 'u')
        rt_push_char(out, 'e')
    } else {
        rt_push_char(out, 'f')
        rt_push_char(out, 'a')
        rt_push_char(out, 'l')
        rt_push_char(out, 's')
        rt_push_char(out, 'e')
    }
}

//~ Prints a float with up to six decimals and no trailing zeros.
fn rt_show_float(out: ptr, x: float) {
    if x != x {
        rt_push_char(out, 'n')
        rt_push_char(out, 'a')
        rt_push_char(out, 'n')
        return
    }
    var v = x
    if v < 0.0 {
        rt_push_char(out, '-')
        v = 0.0 - v
    }
    if v >= 9.0e18 {
        rt_show_int(out, 9223372036854775807)
        return
    }
    var whole = rt_to_int(v)
    var frac = v - (whole to float)
    /// Six decimals, rounded.
    var scaled = rt_to_int((frac * 1000000.0) + 0.5)
    if scaled >= 1000000 {
        whole += 1
        scaled -= 1000000
    }
    rt_show_int(out, whole)
    if scaled > 0 {
        rt_push_char(out, '.')
        var place = 100000
        while place > 0 && scaled > 0 {
            const d = scaled / place
            rt_push_byte(out, 48 + d)
            scaled -= d * place
            place /= 10
        }
    }
}

impl list<string> {
    fn join(self, separator: str) -> string {
        var out = ""
        const h = rt_addr_of(self)
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            if i > 0 { rt_str_push(rt_addr_of(out), rt_hdr_data(rt_addr_of(separator)), rt_hdr_len(rt_addr_of(separator))) }
            const item = rt_offset(rt_hdr_data(h), i * 24)
            rt_str_push(rt_addr_of(out), rt_hdr_data(item), rt_hdr_len(item))
            i += 1
        }
        out
    }
}

/// ---- Maps and sets: insertion-ordered tables ---------------------------------------------------
///
/// The header has four words: the entries block, the length, the capacity and the index table. The
/// block holds `cap` keys, then (for maps) `cap` values starting at an 8-byte boundary. The index
/// table has `rt_tab_size(cap)` slots; see `rt_map_tag` for what a slot holds.

//~ A capacity is always 4, 8, 16, ...: twice that is the power of two the table needs.
fn rt_tab_size(cap: int) -> int = cap << 1

fn rt_vals_off(cap: int, ksize: int) -> int = (cap *% ksize +% 7) & -8
fn rt_map_index(h: ptr) -> ptr = rt_load_ptr(rt_offset(h, 24))
fn rt_map_key_at(h: ptr, i: int, ksize: int) -> ptr = rt_offset(rt_hdr_data(h), i *% ksize)

fn rt_map_val_at(h: ptr, i: int, ksize: int, vsize: int) -> ptr {
    rt_offset(rt_hdr_data(h), rt_vals_off(rt_hdr_cap(h), ksize) +% i *% vsize)
}

//~ The 32-bit tag of a key: its hash with the high bits folded in. An index slot holds the tag in
//~ its upper half and the entry's position plus one in its lower half (0 when empty), so a table
//~ can be rebuilt without hashing again and a probe skips `eq` for keys with another tag. `size` is
//~ a power of two. The first slot probed is `tag & (size - 1)`, so nearby keys stay in nearby slots;
//~ the next ones are `5 * slot + 1 + perturb` with `perturb` the tag shifted right 5 more each step
//~ (as CPython does), which pulls the higher bits in when keys collide in the low ones.
fn rt_map_tag(hash: ptr, key: ptr) -> int {
    const h = rt_call_int1(hash, key)
    (h ^ (h >> 17)) & 4294967295
}

fn rt_slot_pos(v: int) -> int = v & 4294967295
fn rt_slot_tag(v: int) -> int = (v >> 32) & 4294967295

fn rt_map_zeroed(size: int) -> ptr {
    const tab = rt_alloc(size << 3)
    var i = 0
    while i < size {
        rt_store_int(rt_offset(tab, i << 3), 0)
        i += 1
    }
    tab
}

//~ Puts an entry in the first free slot of its probe sequence.
fn rt_map_place(tab: ptr, size: int, tag: int, e: int) {
    const mask = size -% 1
    var s = tag & mask
    var perturb = tag
    while rt_load_int(rt_offset(tab, s << 3)) != 0 {
        perturb = perturb >> 5
        s = (s *% 5 +% perturb +% 1) & mask
    }
    rt_store_int(rt_offset(tab, s << 3), (tag << 32) | (e +% 1))
}

//~ Rebuilds the index table from the entries.
fn rt_map_reindex(h: ptr, ksize: int, hash: ptr) {
    const old = rt_map_index(h)
    if !rt_is_null(old) { rt_free(old) }
    const cap = rt_hdr_cap(h)
    if cap == 0 {
        rt_store_ptr(rt_offset(h, 24), rt_null())
        return
    }
    const size = rt_tab_size(cap)
    const tab = rt_map_zeroed(size)
    var e = 0
    const n = rt_hdr_len(h)
    while e < n {
        rt_map_place(tab, size, rt_map_tag(hash, rt_map_key_at(h, e, ksize)), e)
        e += 1
    }
    rt_store_ptr(rt_offset(h, 24), tab)
}

fn rt_map_find(h: ptr, key: ptr, ksize: int, eq: ptr, hash: ptr) -> int {
    if rt_hdr_len(h) == 0 { return -1 }
    return rt_map_find_tag(h, key, ksize, eq, rt_map_tag(hash, key))
}

//~ The position of the entry whose key (tag `tag`) equals the one at `key`, or -1. The first slot is
//~ tried here, so that this stays small enough to be copied into its callers (where `eq` is known);
//~ a collision goes on in `rt_map_probe_slow`.
fn rt_map_find_tag(h: ptr, key: ptr, ksize: int, eq: ptr, tag: int) -> int {
    if rt_hdr_len(h) == 0 { return -1 }
    const mask = rt_tab_size(rt_hdr_cap(h)) -% 1
    const s = tag & mask
    const v = rt_load_int(rt_offset(rt_map_index(h), s << 3))
    if v == 0 { return -1 }
    if rt_slot_tag(v) == tag && rt_call_bool2(
        eq,
        rt_map_key_at(h, rt_slot_pos(v) -% 1, ksize),
        key,
    ) {
        return rt_slot_pos(v) -% 1
    }
    return rt_map_probe_slow(h, key, ksize, eq, tag, s)
}

//~ The rest of the probe sequence of `rt_map_find_tag`, after the first slot `s` held another key.
fn rt_map_probe_slow(h: ptr, key: ptr, ksize: int, eq: ptr, tag: int, first: int) -> int {
    const tab = rt_map_index(h)
    const mask = rt_tab_size(rt_hdr_cap(h)) -% 1
    var s = first
    var perturb = tag
    var v = rt_load_int(rt_offset(tab, s << 3))
    while v != 0 {
        if s != first && rt_slot_tag(v) == tag && rt_call_bool2(
            eq,
            rt_map_key_at(h, rt_slot_pos(v) -% 1, ksize),
            key,
        ) {
            return rt_slot_pos(v) -% 1
        }
        perturb = perturb >> 5
        s = (s *% 5 +% perturb +% 1) & mask
        v = rt_load_int(rt_offset(tab, s << 3))
    }
    -1
}

fn rt_map_grow(h: ptr, ksize: int, vsize: int, hash: ptr) {
    const cap = rt_hdr_cap(h)
    var ncap = cap * 2
    if ncap < 4 { ncap = 4 }
    const len = rt_hdr_len(h)
    const data = rt_alloc(rt_vals_off(ncap, ksize) + ncap * vsize)
    const old = rt_hdr_data(h)
    if len > 0 {
        rt_copy(data, old, len * ksize)
        if vsize > 0 { rt_copy(rt_offset(data, rt_vals_off(ncap, ksize)), rt_offset(old, rt_vals_off(cap, ksize)), len * vsize) }
    }
    if cap > 0 { rt_free(old) }
    rt_store_ptr(h, data)
    rt_store_int(rt_offset(h, 16), ncap)
    const oldtab = rt_map_index(h)
    if rt_is_null(oldtab) {
        rt_map_reindex(h, ksize, hash)
        return
    }
    /// The tags are in the old table: move them over without hashing the keys again.
    const osize = rt_tab_size(cap)
    const size = rt_tab_size(ncap)
    const tab = rt_map_zeroed(size)
    var j = 0
    while j < osize {
        const v = rt_load_int(rt_offset(oldtab, j << 3))
        if v != 0 { rt_map_place(tab, size, rt_slot_tag(v), rt_slot_pos(v) -% 1) }
        j += 1
    }
    rt_free(oldtab)
    rt_store_ptr(rt_offset(h, 24), tab)
}

//~ Makes room for one more entry; the next entry goes at the length.
fn rt_map_reserve(h: ptr, ksize: int, vsize: int, hash: ptr) {
    if rt_hdr_len(h) == rt_hdr_cap(h) { rt_map_grow(h, ksize, vsize, hash) }
}

//~ Counts the entry just written at the length: it becomes visible and is indexed.
fn rt_map_commit(h: ptr, ksize: int, tag: int) {
    const n = rt_hdr_len(h)
    rt_hdr_set_len(h, n + 1)
    const tab = rt_map_index(h)
    const size = rt_tab_size(rt_hdr_cap(h))
    rt_map_place(tab, size, tag, n)
}

//~ Removes the entry at `i` (its key and value must already be dropped or moved out).
fn rt_map_remove_at(h: ptr, i: int, ksize: int, vsize: int, hash: ptr) {
    const n = rt_hdr_len(h)
    var j = i
    while j + 1 < n {
        rt_copy(rt_map_key_at(h, j, ksize), rt_map_key_at(h, j + 1, ksize), ksize)
        if vsize > 0 { rt_copy(rt_map_val_at(h, j, ksize, vsize), rt_map_val_at(h, j + 1, ksize, vsize), vsize) }
        j += 1
    }
    rt_hdr_set_len(h, n - 1)
    /// Entries after `i` moved down one place: rebuild the table from its tags, without hashing.
    const oldtab = rt_map_index(h)
    const size = rt_tab_size(rt_hdr_cap(h))
    const tab = rt_map_zeroed(size)
    var k = 0
    while k < size {
        const v = rt_load_int(rt_offset(oldtab, k * 8))
        const p = rt_slot_pos(v) - 1
        if v != 0 && p != i {
            rt_map_place(tab, size, rt_slot_tag(v), if p > i { p - 1 } else { p })
        }
        k += 1
    }
    rt_free(oldtab)
    rt_store_ptr(rt_offset(h, 24), tab)
}

//~ Used by literals: moves the key at `k` and the value at `v` in (the old value of an equal key is dropped).
fn rt_map_put<K, V>(h: ptr, k: ptr, v: ptr) {
    const ks = rt_size_of<K>()
    const vs = rt_size_of<V>()
    const hash = rt_hash_fn<K>()
    const tag = rt_map_tag(hash, k)
    const i = rt_map_find_tag(h, k, ks, rt_eq_fn<K>(), tag)
    if i >= 0 {
        rt_drop_at<K>(k)
        rt_drop_at<V>(rt_map_val_at(h, i, ks, vs))
        rt_copy(rt_map_val_at(h, i, ks, vs), v, vs)
        return
    }
    rt_map_reserve(h, ks, vs, hash)
    const n = rt_hdr_len(h)
    rt_copy(rt_map_key_at(h, n, ks), k, ks)
    rt_copy(rt_map_val_at(h, n, ks, vs), v, vs)
    rt_map_commit(h, ks, tag)
}

fn rt_set_put<T>(h: ptr, k: ptr) {
    const ks = rt_size_of<T>()
    const hash = rt_hash_fn<T>()
    const tag = rt_map_tag(hash, k)
    if rt_map_find_tag(h, k, ks, rt_eq_fn<T>(), tag) >= 0 {
        rt_drop_at<T>(k)
        return
    }
    rt_map_reserve(h, ks, 0, hash)
    rt_copy(rt_map_key_at(h, rt_hdr_len(h), ks), k, ks)
    rt_map_commit(h, ks, tag)
}

fn rt_map_drop<K, V>(h: ptr) {
    const ks = rt_size_of<K>()
    const vs = rt_size_of<V>()
    var i = 0
    const n = rt_hdr_len(h)
    while i < n {
        rt_drop_at<K>(rt_map_key_at(h, i, ks))
        rt_drop_at<V>(rt_map_val_at(h, i, ks, vs))
        i += 1
    }
    if rt_hdr_cap(h) > 0 { rt_free(rt_hdr_data(h)) }
    if !rt_is_null(rt_map_index(h)) { rt_free(rt_map_index(h)) }
}

fn rt_set_drop<T>(h: ptr) {
    const ks = rt_size_of<T>()
    var i = 0
    const n = rt_hdr_len(h)
    while i < n {
        rt_drop_at<T>(rt_map_key_at(h, i, ks))
        i += 1
    }
    if rt_hdr_cap(h) > 0 { rt_free(rt_hdr_data(h)) }
    if !rt_is_null(rt_map_index(h)) { rt_free(rt_map_index(h)) }
}

//~ Copies the table: same capacity, same positions, so the index can be copied as it is.
fn rt_map_clone_to<K, V>(src: ptr, dst: ptr, vsize: int) {
    const ks = rt_size_of<K>()
    const cap = rt_hdr_cap(src)
    const n = rt_hdr_len(src)
    rt_store_int(rt_offset(dst, 8), n)
    rt_store_int(rt_offset(dst, 16), cap)
    if cap == 0 {
        rt_store_ptr(dst, rt_null())
        rt_store_ptr(rt_offset(dst, 24), rt_null())
        return
    }
    rt_store_ptr(dst, rt_alloc(rt_vals_off(cap, ks) + cap * vsize))
    var i = 0
    while i < n {
        rt_clone_to<K>(rt_map_key_at(src, i, ks), rt_map_key_at(dst, i, ks))
        i += 1
    }
    const size = rt_tab_size(cap)
    const tab = rt_alloc(size * 8)
    rt_copy(tab, rt_map_index(src), size * 8)
    rt_store_ptr(rt_offset(dst, 24), tab)
}

fn rt_map_clone<K, V>(src: ptr, dst: ptr) {
    rt_map_clone_to<K, V>(src, dst, rt_size_of<V>())
    const ks = rt_size_of<K>()
    const vs = rt_size_of<V>()
    var i = 0
    const n = rt_hdr_len(src)
    while i < n {
        rt_clone_to<V>(rt_map_val_at(src, i, ks, vs), rt_map_val_at(dst, i, ks, vs))
        i += 1
    }
}

fn rt_set_clone<T>(src: ptr, dst: ptr) {
    rt_map_clone_to<T, int>(src, dst, 0)
}

fn rt_map_eq<K, V>(a: ptr, b: ptr) -> bool {
    const n = rt_hdr_len(a)
    if n != rt_hdr_len(b) { return false }
    const ks = rt_size_of<K>()
    const vs = rt_size_of<V>()
    const eq = rt_eq_fn<K>()
    const hash = rt_hash_fn<K>()
    const veq = rt_eq_fn<V>()
    var i = 0
    while i < n {
        const tag = rt_map_tag(hash, rt_map_key_at(a, i, ks))
        const j = rt_map_find_tag(b, rt_map_key_at(a, i, ks), ks, eq, tag)
        if j < 0 { return false }
        if !rt_call_bool2(
            veq,
            rt_map_val_at(a, i, ks, vs),
            rt_map_val_at(b, j, ks, vs),
        ) { return false }
        i += 1
    }
    true
}

fn rt_set_eq<T>(a: ptr, b: ptr) -> bool {
    const n = rt_hdr_len(a)
    if n != rt_hdr_len(b) { return false }
    const ks = rt_size_of<T>()
    const eq = rt_eq_fn<T>()
    const hash = rt_hash_fn<T>()
    var i = 0
    while i < n {
        const tag = rt_map_tag(hash, rt_map_key_at(a, i, ks))
        if rt_map_find_tag(b, rt_map_key_at(a, i, ks), ks, eq, tag) < 0 { return false }
        i += 1
    }
    true
}

fn rt_map_show<K, V>(h: ptr, out: ptr) {
    const ks = rt_size_of<K>()
    const vs = rt_size_of<V>()
    const n = rt_hdr_len(h)
    if n == 0 {
        rt_push_char(out, '{')
        rt_push_char(out, ':')
        rt_push_char(out, '}')
        return
    }
    rt_push_char(out, '{')
    var i = 0
    while i < n {
        if i > 0 {
            rt_push_char(out, ',')
            rt_push_char(out, ' ')
        }
        rt_show_item_to<K>(rt_map_key_at(h, i, ks), out)
        rt_push_char(out, ':')
        rt_push_char(out, ' ')
        rt_show_item_to<V>(rt_map_val_at(h, i, ks, vs), out)
        i += 1
    }
    rt_push_char(out, '}')
}

fn rt_set_show<T>(h: ptr, out: ptr) {
    const ks = rt_size_of<T>()
    const n = rt_hdr_len(h)
    rt_push_char(out, '{')
    var i = 0
    while i < n {
        if i > 0 {
            rt_push_char(out, ',')
            rt_push_char(out, ' ')
        }
        rt_show_item_to<T>(rt_map_key_at(h, i, ks), out)
        i += 1
    }
    rt_push_char(out, '}')
}

impl<K, V> map<K, V> {
    fn len(self) -> int = rt_hdr_len(rt_addr_of(self))
    fn is_empty(self) -> bool = rt_hdr_len(rt_addr_of(self)) == 0

    fn get(self, key: K) -> V? {
        const h = rt_addr_of(self)
        const ks = rt_size_of<K>()
        const i = rt_map_find(h, rt_addr_of(key), ks, rt_eq_fn<K>(), rt_hash_fn<K>())
        if i < 0 { return none }
        return rt_clone<V>(rt_map_val_at(h, i, ks, rt_size_of<V>()))
    }

    fn contains_key(self, key: K) -> bool {
        rt_map_find(
            rt_addr_of(self),
            rt_addr_of(key),
            rt_size_of<K>(),
            rt_eq_fn<K>(),
            rt_hash_fn<K>(),
        ) >= 0
    }

    fn insert(inout self, sink key: K, sink value: V) -> V? {
        const h = rt_addr_of(self)
        const ks = rt_size_of<K>()
        const vs = rt_size_of<V>()
        const hash = rt_hash_fn<K>()
        const tag = rt_map_tag(hash, rt_addr_of(key))
        const i = rt_map_find_tag(h, rt_addr_of(key), ks, rt_eq_fn<K>(), tag)
        if i >= 0 {
            const old = rt_read<V>(rt_map_val_at(h, i, ks, vs))
            rt_write<V>(rt_map_val_at(h, i, ks, vs), sink value)
            return old
        }
        rt_map_reserve(h, ks, vs, hash)
        const n = rt_hdr_len(h)
        rt_write<K>(rt_map_key_at(h, n, ks), sink key)
        rt_write<V>(rt_map_val_at(h, n, ks, vs), sink value)
        rt_map_commit(h, ks, tag)
        none
    }

    fn remove(inout self, key: K) -> V? {
        const h = rt_addr_of(self)
        const ks = rt_size_of<K>()
        const vs = rt_size_of<V>()
        const hash = rt_hash_fn<K>()
        const tag = rt_map_tag(hash, rt_addr_of(key))
        const i = rt_map_find_tag(h, rt_addr_of(key), ks, rt_eq_fn<K>(), tag)
        if i < 0 { return none }
        const old = rt_read<V>(rt_map_val_at(h, i, ks, vs))
        rt_drop_at<K>(rt_map_key_at(h, i, ks))
        rt_map_remove_at(h, i, ks, vs, hash)
        return old
    }

    fn clear(inout self) {
        const h = rt_addr_of(self)
        const ks = rt_size_of<K>()
        const vs = rt_size_of<V>()
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            rt_drop_at<K>(rt_map_key_at(h, i, ks))
            rt_drop_at<V>(rt_map_val_at(h, i, ks, vs))
            i += 1
        }
        rt_hdr_set_len(h, 0)
        rt_map_reindex(h, ks, rt_hash_fn<K>())
    }

    fn keys(self) -> iter<K> {
        const h = rt_addr_of(self)
        const ks = rt_size_of<K>()
        var out: list<K> = []
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            out.push!(rt_clone<K>(rt_map_key_at(h, i, ks)))
            i += 1
        }
        rt_cast<list<K>, iter<K>>(sink out)
    }

    fn values(self) -> iter<V> {
        const h = rt_addr_of(self)
        const ks = rt_size_of<K>()
        const vs = rt_size_of<V>()
        var out: list<V> = []
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            out.push!(rt_clone<V>(rt_map_val_at(h, i, ks, vs)))
            i += 1
        }
        rt_cast<list<V>, iter<V>>(sink out)
    }
}

impl<T> set<T> {
    fn len(self) -> int = rt_hdr_len(rt_addr_of(self))
    fn is_empty(self) -> bool = rt_hdr_len(rt_addr_of(self)) == 0

    fn contains(self, item: T) -> bool {
        rt_map_find(
            rt_addr_of(self),
            rt_addr_of(item),
            rt_size_of<T>(),
            rt_eq_fn<T>(),
            rt_hash_fn<T>(),
        ) >= 0
    }

    fn insert(inout self, sink item: T) -> bool {
        const h = rt_addr_of(self)
        const ks = rt_size_of<T>()
        const hash = rt_hash_fn<T>()
        const tag = rt_map_tag(hash, rt_addr_of(item))
        if rt_map_find_tag(h, rt_addr_of(item), ks, rt_eq_fn<T>(), tag) >= 0 { return false }
        rt_map_reserve(h, ks, 0, hash)
        rt_write<T>(rt_map_key_at(h, rt_hdr_len(h), ks), sink item)
        rt_map_commit(h, ks, tag)
        true
    }

    fn remove(inout self, item: T) -> bool {
        const h = rt_addr_of(self)
        const ks = rt_size_of<T>()
        const hash = rt_hash_fn<T>()
        const tag = rt_map_tag(hash, rt_addr_of(item))
        const i = rt_map_find_tag(h, rt_addr_of(item), ks, rt_eq_fn<T>(), tag)
        if i < 0 { return false }
        rt_drop_at<T>(rt_map_key_at(h, i, ks))
        rt_map_remove_at(h, i, ks, 0, hash)
        true
    }

    fn clear(inout self) {
        const h = rt_addr_of(self)
        const ks = rt_size_of<T>()
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            rt_drop_at<T>(rt_map_key_at(h, i, ks))
            i += 1
        }
        rt_hdr_set_len(h, 0)
        rt_map_reindex(h, ks, rt_hash_fn<T>())
    }

    fn iter(self) -> iter<T> {
        const h = rt_addr_of(self)
        const ks = rt_size_of<T>()
        var out: list<T> = []
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            out.push!(rt_clone<T>(rt_map_key_at(h, i, ks)))
            i += 1
        }
        rt_cast<list<T>, iter<T>>(sink out)
    }
}

impl str {
    fn len(self) -> int = rt_hdr_len(rt_addr_of(self))
    fn is_empty(self) -> bool = rt_hdr_len(rt_addr_of(self)) == 0

    //~ The characters, decoded from UTF-8.
    fn chars(self) -> iter<char> {
        var out: [char] = []
        const h = rt_addr_of(self)
        const p = rt_hdr_data(h)
        const n = rt_hdr_len(h)
        var i = 0
        while i < n {
            const b = rt_load_byte(rt_offset(p, i)) to int
            var c = b
            var width = 1
            if b >= 240 {
                c = b & 7
                width = 4
            } else if b >= 224 {
                c = b & 15
                width = 3
            } else if b >= 192 {
                c = b & 31
                width = 2
            }
            var k = 1
            while k < width && i + k < n {
                c = (c << 6) | ((rt_load_byte(rt_offset(p, i + k)) to int) & 63)
                k += 1
            }
            out.push!(rt_to_char(c))
            i += width
        }
        rt_cast<list<char>, iter<char>>(sink out)
    }

    fn split(self, separator: str) -> iter<str> {
        var out: [str] = []
        const n = self.len()
        const sn = separator.len()
        if sn == 0 {
            out.push!(self)
            return rt_cast<list<str>, iter<str>>(sink out)
        }
        const p = rt_hdr_data(rt_addr_of(self))
        const sp = rt_hdr_data(rt_addr_of(separator))
        var start = 0
        var i = 0
        while i + sn <= n {
            if rt_bytes_eq(rt_offset(p, i), sp, sn) {
                out.push!(self[start..i])
                i += sn
                start = i
            } else {
                i += 1
            }
        }
        out.push!(self[start..n])
        rt_cast<list<str>, iter<str>>(sink out)
    }

    fn trim(self) -> str {
        const p = rt_hdr_data(rt_addr_of(self))
        var a = 0
        var b = self.len()
        while a < b && rt_is_space(rt_load_byte(rt_offset(p, a)) to int) { a += 1 }
        while b > a && rt_is_space(rt_load_byte(rt_offset(p, b - 1)) to int) { b -= 1 }
        self[a..b]
    }

    fn starts_with(self, prefix: str) -> bool {
        const pn = prefix.len()
        if pn > self.len() { return false }
        rt_bytes_eq(rt_hdr_data(rt_addr_of(self)), rt_hdr_data(rt_addr_of(prefix)), pn)
    }

    fn ends_with(self, suffix: str) -> bool {
        const sn = suffix.len()
        const n = self.len()
        if sn > n { return false }
        rt_bytes_eq(
            rt_offset(rt_hdr_data(rt_addr_of(self)), n - sn),
            rt_hdr_data(rt_addr_of(suffix)),
            sn,
        )
    }

    fn contains(self, part: str) -> bool = rt_find(self, part) >= 0

    fn to_upper(self) -> string {
        var out = ""
        const p = rt_hdr_data(rt_addr_of(self))
        var i = 0
        const n = self.len()
        while i < n {
            const b = rt_load_byte(rt_offset(p, i)) to int
            rt_push_byte(rt_addr_of(out), b >= 97 && b <= 122 ? b - 32 : b)
            i += 1
        }
        out
    }

    fn to_lower(self) -> string {
        var out = ""
        const p = rt_hdr_data(rt_addr_of(self))
        var i = 0
        const n = self.len()
        while i < n {
            const b = rt_load_byte(rt_offset(p, i)) to int
            rt_push_byte(rt_addr_of(out), b >= 65 && b <= 90 ? b + 32 : b)
            i += 1
        }
        out
    }

    fn replace(self, from: str, to: str) -> string {
        var out = ""
        const fnn = from.len()
        const n = self.len()
        const p = rt_hdr_data(rt_addr_of(self))
        var i = 0
        while i < n {
            if fnn > 0 && i + fnn <= n && rt_bytes_eq(
                rt_offset(p, i),
                rt_hdr_data(rt_addr_of(from)),
                fnn,
            ) {
                rt_str_push(rt_addr_of(out), rt_hdr_data(rt_addr_of(to)), to.len())
                i += fnn
            } else {
                rt_push_byte(rt_addr_of(out), rt_load_byte(rt_offset(p, i)) to int)
                i += 1
            }
        }
        out
    }

    fn parse_int(self) -> int ! parse_error {
        const p = rt_hdr_data(rt_addr_of(self))
        const n = self.len()
        if n == 0 { return err(parse_error { message: "empty text is not a number" }) }
        var i = 0
        var negative = false
        if rt_load_byte(p) == 45 {
            negative = true
            i = 1
        } else if rt_load_byte(p) == 43 {
            i = 1
        }
        if i == n { return err(parse_error { message: "no digits" }) }
        /// Accumulated as a negative number, so the smallest int fits.
        var value = 0
        while i < n {
            const d = (rt_load_byte(rt_offset(p, i)) to int) - 48
            if d < 0 || d > 9 { return err(parse_error { message: "bad digit at position #i" }) }
            if value < (-9223372036854775808 + d) / 10 { return err(parse_error { message: "the number is too large" }) }
            value = value * 10 - d
            i += 1
        }
        if !negative {
            if value == -9223372036854775808 { return err(parse_error { message: "the number is too large" }) }
            return ok(0 - value)
        }
        ok(value)
    }

    fn parse_float(self) -> float ! parse_error {
        const p = rt_hdr_data(rt_addr_of(self))
        const n = self.len()
        if n == 0 { return err(parse_error { message: "empty text is not a number" }) }
        var i = 0
        var negative = false
        if rt_load_byte(p) == 45 {
            negative = true
            i = 1
        }
        var value = 0.0
        var digits = 0
        while i < n && rt_is_digit(rt_load_byte(rt_offset(p, i)) to int) {
            value = value * 10.0 + (((rt_load_byte(rt_offset(p, i)) to int) - 48) to float)
            digits += 1
            i += 1
        }
        if i < n && rt_load_byte(rt_offset(p, i)) == 46 {
            i += 1
            var scale = 0.1
            while i < n && rt_is_digit(rt_load_byte(rt_offset(p, i)) to int) {
                value = value + scale * (((rt_load_byte(rt_offset(p, i)) to int) - 48) to float)
                scale = scale / 10.0
                digits += 1
                i += 1
            }
        }
        if digits == 0 || i != n { return err(parse_error { message: "bad number" }) }
        ok(negative ? 0.0 - value : value)
    }
}

fn rt_is_space(b: int) -> bool = b == 32 || b == 9 || b == 10 || b == 13
fn rt_is_digit(b: int) -> bool = b >= 48 && b <= 57

//~ The position of the first occurrence of `part` in `text`, or -1.
fn rt_find(text: str, part: str) -> int {
    const n = text.len()
    const pn = part.len()
    if pn == 0 { return 0 }
    var i = 0
    while i + pn <= n {
        if rt_bytes_eq(
            rt_offset(rt_hdr_data(rt_addr_of(text)), i),
            rt_hdr_data(rt_addr_of(part)),
            pn,
        ) { return i }
        i += 1
    }
    -1
}

impl string {
    fn push_str(inout self, text: str) {
        rt_str_push(rt_addr_of(self), rt_hdr_data(rt_addr_of(text)), rt_hdr_len(rt_addr_of(text)))
    }

    fn clear(inout self) {
        rt_hdr_set_len(rt_addr_of(self), 0)
    }
}

impl<T> iter<T> {
    fn count(self) -> int = rt_hdr_len(rt_addr_of(self))

    fn first(self) -> T? {
        const h = rt_addr_of(self)
        if rt_hdr_len(h) == 0 { return none }
        return rt_clone<T>(rt_hdr_data(h))
    }

    fn to_list(self) -> list<T> = rt_cast<iter<T>, list<T>>(rt_clone<iter<T>>(rt_addr_of(self)))
    fn map<U>(self, f: fn(T) -> U) -> iter<U> {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        var out: list<U> = []
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            out.push!(f(rt_clone<T>(rt_offset(rt_hdr_data(h), i * size))))
            i += 1
        }
        rt_cast<list<U>, iter<U>>(sink out)
    }

    fn filter(self, f: fn(T) -> bool) -> iter<T> {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        var out: list<T> = []
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            if f(rt_clone<T>(rt_offset(rt_hdr_data(h), i * size))) {
                out.push!(rt_clone<T>(rt_offset(rt_hdr_data(h), i * size)))
            }
            i += 1
        }
        rt_cast<list<T>, iter<T>>(sink out)
    }

    fn each(self, f: fn(T)) {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            f(rt_clone<T>(rt_offset(rt_hdr_data(h), i * size)))
            i += 1
        }
    }
    fn to_set(self) -> set<T> {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        var out: set<T> = set {}
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            out.insert!(rt_clone<T>(rt_offset(rt_hdr_data(h), i * size)))
            i += 1
        }
        out
    }
}

impl iter<int> {
    fn sum(self) -> int {
        const h = rt_addr_of(self)
        var total = 0
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            total += rt_load_int(rt_offset(rt_hdr_data(h), i * 8))
            i += 1
        }
        total
    }
}

impl iter<float> {
    fn sum(self) -> float {
        const h = rt_addr_of(self)
        var total = 0.0
        var i = 0
        const n = rt_hdr_len(h)
        while i < n {
            total += rt_load_float(rt_offset(rt_hdr_data(h), i * 8))
            i += 1
        }
        total
    }
}

impl<T> option<T> {
    fn is_some(self) -> bool {
        switch self {
            case some(_): true
            case none: false
        }
    }

    fn is_none(self) -> bool = !self.is_some()

    fn unwrap_or(self, fallback: T) -> T {
        switch self {
            case some(v): rt_clone<T>(rt_addr_of(v))
            case none: rt_clone<T>(rt_addr_of(fallback))
        }
    }

    fn map<U>(self, f: fn(T) -> U) -> U? {
        switch self {
            case some(v): f(rt_clone<T>(rt_addr_of(v)))
            case none: none
        }
    }

    fn or_err<E>(self, e: E) -> T ! E {
        switch self {
            case some(v): ok(rt_clone<T>(rt_addr_of(v)))
            case none: err(rt_clone<E>(rt_addr_of(e)))
        }
    }
}

impl<T, E> result<T, E> {
    fn ok(self) -> T? {
        switch self {
            case ok(v): return rt_clone<T>(rt_addr_of(v))
            case err(_): return none
        }
    }

    fn is_ok(self) -> bool {
        switch self {
            case ok(_): true
            case err(_): false
        }
    }

    fn is_err(self) -> bool = !self.is_ok()

    fn or(self, fallback: T) -> T {
        switch self {
            case ok(v): rt_clone<T>(rt_addr_of(v))
            case err(_): rt_clone<T>(rt_addr_of(fallback))
        }
    }

    fn map_err<F>(self, f: fn(E) -> F) -> T ! F {
        switch self {
            case ok(v): ok(rt_clone<T>(rt_addr_of(v)))
            case err(e): err(f(rt_clone<E>(rt_addr_of(e))))
        }
    }

    //~ Adds a line of context to the error: `context: error`.
    fn context(self, message: str) -> T ! error {
        switch self {
            case ok(v): ok(rt_clone<T>(rt_addr_of(v)))
            case err(e): {
                var text = ""
                rt_str_push(
                    rt_addr_of(text),
                    rt_hdr_data(rt_addr_of(message)),
                    rt_hdr_len(rt_addr_of(message)),
                )
                rt_push_char(rt_addr_of(text), ':')
                rt_push_char(rt_addr_of(text), ' ')
                rt_show_to<E>(rt_addr_of(e), rt_addr_of(text))
                err(rt_cast<string, error>(sink text))
            }
        }
    }
}

impl<T> range<T> {
    fn contains(self, item: T) -> bool {
        const h = rt_addr_of(self)
        const size = rt_size_of<T>()
        const cmp = rt_cmp_fn<T>()
        const probe = rt_addr_of(item)
        if rt_load_bool(rt_offset(h, size * 2 + 1)) {
            if rt_call_int2(cmp, probe, h) < 0 { return false }
        }
        if rt_load_bool(rt_offset(h, size * 2 + 2)) {
            const c = rt_call_int2(cmp, probe, rt_offset(h, size))
            return if rt_load_bool(rt_offset(h, size * 2)) { c <= 0 } else { c < 0 }
        }
        true
    }
}

impl range<int> {
    fn iter(self) -> iter<int> {
        const h = rt_addr_of(self)
        if !rt_load_bool(rt_offset(h, 17)) { panic("an open range with no start cannot be iterated") }
        if !rt_load_bool(rt_offset(h, 18)) { panic("an open range with no end cannot be iterated") }
        var out: list<int> = []
        var i = rt_load_int(h)
        var end = rt_load_int(rt_offset(h, 8))
        if rt_load_bool(rt_offset(h, 16)) { end += 1 }
        while i < end {
            out.push!(i)
            i += 1
        }
        rt_cast<list<int>, iter<int>>(sink out)
    }
}

impl int {
    fn abs(self) -> int = self < 0 ? 0 - self : self
    fn min(self, other: int) -> int = self < other ? self : other
    fn max(self, other: int) -> int = self > other ? self : other

    fn pow(self, exponent: int) -> int {
        var result = 1
        var i = 0
        while i < exponent {
            result *= self
            i += 1
        }
        result
    }

    fn checked_add(self, other: int) -> int? {
        if other > 0 && self > 9223372036854775807 - other { return none }
        if other < 0 && self < -9223372036854775808 - other { return none }
        return self + other
    }

    fn checked_sub(self, other: int) -> int? {
        if other < 0 && self > 9223372036854775807 + other { return none }
        if other > 0 && self < -9223372036854775808 + other { return none }
        return self - other
    }

    fn checked_mul(self, other: int) -> int? {
        if self == 0 || other == 0 { return 0 }
        const product = self *% other
        if product / other != self ||
            (self == -1 && other == -9223372036854775808) ||
            (other == -1 && self == -9223372036854775808) { return none }
        return product
    }

    fn wrapping_add(self, other: int) -> int = self +% other
    fn wrapping_sub(self, other: int) -> int = self -% other
    fn wrapping_mul(self, other: int) -> int = self *% other

    fn saturating_add(self, other: int) -> int {
        const r = self.checked_add(other)
        switch r {
            case some(v): v
            case none: other > 0 ? 9223372036854775807 : -9223372036854775808
        }
    }

    fn saturating_sub(self, other: int) -> int {
        const r = self.checked_sub(other)
        switch r {
            case some(v): v
            case none: other > 0 ? -9223372036854775808 : 9223372036854775807
        }
    }
}

impl float {
    fn abs(self) -> float = self < 0.0 ? 0.0 - self : self
    //~ `self * b + c` rounded once, not twice: the same result on every target and in the interpreter.
    //~ Plain `a * b + c` is never fused, so it keeps rounding after the product.
    fn fma(self, b: float, c: float) -> float = rt_fma(self, b, c)
    fn min(self, other: float) -> float = self < other ? self : other
    fn max(self, other: float) -> float = self > other ? self : other

    fn sqrt(self) -> float {
        if self < 0.0 { return 0.0 / 0.0 }
        if self == 0.0 { return 0.0 }
        var x = self > 1.0 ? self : 1.0
        var i = 0
        while i < 80 {
            x = (x + self / x) / 2.0
            i += 1
        }
        x
    }

    fn floor(self) -> float {
        const t = rt_to_int(self) to float
        t > self ? t - 1.0 : t
    }

    fn ceil(self) -> float {
        const t = rt_to_int(self) to float
        t < self ? t + 1.0 : t
    }

    fn round(self) -> float = self < 0.0 ? 0.0 - (0.0 - self + 0.5).floor() : (self + 0.5).floor()

    fn pow(self, exponent: float) -> float {
        const n = rt_to_int(exponent)
        if (n to float) != exponent { panic("pow: only whole exponents are supported") }
        var result = 1.0
        var i = 0
        const count = n < 0 ? 0 - n : n
        while i < count {
            result *= self
            i += 1
        }
        n < 0 ? 1.0 / result : result
    }
}

impl char {
    fn is_digit(self) -> bool = (self to int) >= 48 && (self to int) <= 57
    fn is_upper(self) -> bool = (self to int) >= 65 && (self to int) <= 90
    fn is_lower(self) -> bool = (self to int) >= 97 && (self to int) <= 122
    fn is_alpha(self) -> bool = self.is_upper() || self.is_lower()
    fn is_space(self) -> bool = rt_is_space(self to int)
    fn to_upper(self) -> char = self.is_lower() ? rt_to_char((self to int) - 32) : self
    fn to_lower(self) -> char = self.is_upper() ? rt_to_char((self to int) + 32) : self
}

/// ---- Concurrency (docs/design/concurrency.md) ----------------------------------------------------

//~ What `send` returns when nobody is receiving any more.
pub struct closed {}

//~ A running thread that will produce a `T`. `join!!()` waits and consumes it.
//~
//~ Stage 0 runs threads one after another: a spawned task waits until something needs it (a `join`, a
//~ `recv` on an empty channel, or the end of `main`) and then runs to completion. Programs that need two
//~ tasks to talk back and forth need real threads.
pub struct task<T> {
    state: ptr

    deinit {
        /// The task block: [ran: int, fn, result]. Dropping the handle detaches the task.
        if rt_load_int(self.state) == 0 {
            rt_store_int(self.state, 3)
        } else {
            rt_drop_at<T>(rt_offset(self.state, 40))
            rt_free(self.state)
        }
    }
}

//~ Addresses of the task blocks that have not run yet.
var rt_pending: [int] = []

//~ Runs a task block once (the closure at offset 8 moves out and runs). A detached task frees itself.
fn rt_task_run(s: ptr) {
    const state = rt_load_int(s)
    /// 0: waiting, 3: waiting and detached (the task frees itself when done); anything else already ran.
    if state != 0 && state != 3 { return }
    if state == 0 { rt_store_int(s, 1) }
    const g = rt_read<once fn()>(rt_offset(s, 8))
    g!!()
}

//~ Runs every task that has not run yet.
pub fn rt_run_pending() {
    while rt_pending.len() > 0 {
        const addr = rt_pending.remove!(0)
        const s = rt_cast<int, ptr>(addr)
        rt_task_run(s)
    }
    rt_pending = []
}

//~ Runs one task that is still waiting; false when there is none.
pub fn rt_run_one_pending() -> bool {
    if rt_pending.len() == 0 { return false }
    const addr = rt_pending.remove!(0)
    rt_task_run(rt_cast<int, ptr>(addr))
    true
}

//~ Can a receive on this channel finish now: a value is queued, or no sender is left?
pub fn rt_chan_ready(ch: ptr) -> bool = rt_hdr_len(ch) > 0 || rt_load_int(rt_offset(ch, 24)) == 0

fn rt_task_body<T>(s: ptr, sink f: once fn() -> T) {
    rt_write<T>(rt_offset(s, 40), f!!())
    if rt_load_int(s) == 3 {
        rt_drop_at<T>(rt_offset(s, 40))
        rt_free(s)
    }
}

impl<T> task<T> {
    fn join(sink self) -> T {
        const s = self.state
        const addr = rt_addr_int(s)
        var i = 0
        while i < rt_pending.len() {
            if rt_pending[i] == addr { rt_pending.remove!(i) } else { i += 1 }
        }
        if rt_load_int(s) == 0 {
            rt_task_run(s)
        }
        /// The task ran; its result is at offset 40. The handle's `deinit` must not free it twice.
        rt_store_int(s, 2)
        const r = rt_read<T>(rt_offset(s, 40))
        rt_free(s)
        rt_forget_task<T>(sink self)
        r
    }
}

//~ Gives up a task handle without running its `deinit`.
fn rt_forget_task<T>(sink t: task<T>) {
    rt_cast<task<T>, ptr>(sink t)
}

//~ Starts `f` on a new thread. What the closure uses must be copied or moved in (`sink x ~> ...`).
pub fn spawn<T>(sink f: once fn() -> T) -> task<T> {
    const s = rt_alloc(48 + rt_size_of<T>())
    rt_store_int(s, 0)
    const runner = [sink f, sink s] () ~> rt_task_body<T>(s, sink f)
    rt_write<once fn()>(rt_offset(s, 8), sink runner)
    rt_pending.push!(rt_addr_int(s))
    task<T> { state: s }
}

//~ The handle of `scope s { ... }`. `s.spawn(task)` starts a task that is finished when the scope ends.
pub struct scope_handle {
    id: int
}

impl scope_handle {
    fn spawn<T>(self, sink f: once fn() -> T) -> task<T> = spawn(sink f)
}

/// A channel block: [queue: list 24 bytes][senders: int][receiver alive: int].

pub struct sender<T> {
    ch: ptr

    deinit {
        const n = rt_load_int(rt_offset(self.ch, 24)) - 1
        rt_store_int(rt_offset(self.ch, 24), n)
        if n == 0 && rt_load_int(rt_offset(self.ch, 32)) == 0 { rt_chan_free<T>(self.ch) }
    }
}

pub struct receiver<T> {
    ch: ptr

    deinit {
        rt_store_int(rt_offset(self.ch, 32), 0)
        if rt_load_int(rt_offset(self.ch, 24)) == 0 { rt_chan_free<T>(self.ch) }
    }
}

fn rt_chan_free<T>(ch: ptr) {
    rt_drop_at<list<T>>(ch)
    rt_free(ch)
}

//~ A channel: a sender end and a receiver end. A capacity of 0 means unbounded.
pub fn chan<T>(capacity: int = 0) -> (sender<T>, receiver<T>) {
    const ch = rt_alloc(48)
    var q: list<T> = []
    rt_write<list<T>>(ch, sink q)
    rt_store_int(rt_offset(ch, 24), 1)
    rt_store_int(rt_offset(ch, 32), 1)
    (sender<T> { ch: ch }, receiver<T> { ch: ch })
}

impl<T> sender<T> {
    fn send(self, sink value: T) -> void ! closed {
        if rt_load_int(rt_offset(self.ch, 32)) == 0 { return err(closed {}) }
        var q = rt_read<list<T>>(self.ch)
        q.push!(value)
        rt_write<list<T>>(self.ch, sink q)
    }
}

//~ More senders: `copy tx`.
impl<T> clone for sender<T> {
    fn clone(self) -> sender<T> {
        rt_store_int(rt_offset(self.ch, 24), rt_load_int(rt_offset(self.ch, 24)) + 1)
        sender<T> { ch: self.ch }
    }
}

impl<T> receiver<T> {
    fn try_recv(self) -> T? {
        if rt_hdr_len(self.ch) == 0 { return none }
        var q = rt_read<list<T>>(self.ch)
        const v = q.remove!(0)
        rt_write<list<T>>(self.ch, sink q)
        return v
    }

    //~ Waits for a value: other tasks run while the queue is empty. `none` when every sender is gone.
    fn recv(self) -> T? {
        while rt_hdr_len(self.ch) == 0 {
            if rt_load_int(rt_offset(self.ch, 24)) == 0 { return none }
            if rt_pending.len() == 0 { panic("deadlock: waiting for a value nobody can send") }
            const addr = rt_pending.remove!(0)
            rt_task_run(rt_cast<int, ptr>(addr))
        }
        return self.try_recv()
    }

    fn iter(self) -> iter<T> {
        var out: list<T> = []
        var more = true
        while more {
            const v = self.recv()
            switch v {
                case some(x): out.push!(x)
                case none: more = false
            }
        }
        rt_cast<list<T>, iter<T>>(sink out)
    }
}

//~ Read-only data counted across threads: `shared(value)`, and `copy handle` for another handle.
pub struct shared<T> {
    p: ptr

    init(sink value: T) {
        const p = rt_alloc(8 + rt_size_of<T>())
        rt_store_int(p, 1)
        rt_write<T>(rt_offset(p, 8), sink value)
        self.p = p
    }

    deinit {
        const n = rt_load_int(self.p) - 1
        rt_store_int(self.p, n)
        if n == 0 {
            rt_drop_at<T>(rt_offset(self.p, 8))
            rt_free(self.p)
        }
    }
}

impl<T> shared<T> {
    fn get(self) -> T = rt_clone<T>(rt_offset(self.p, 8))
}

impl<T> clone for shared<T> {
    fn clone(self) -> shared<T> {
        rt_store_int(self.p, rt_load_int(self.p) + 1)
        shared<T> { p: self.p }
    }
}

//~ Data changed from several threads one at a time: `lock(value)`. Access is through `with`.
pub struct lock<T> {
    p: ptr

    init(sink value: T) {
        const p = rt_alloc(rt_size_of<T>() + 1)
        rt_write<T>(p, sink value)
        self.p = p
    }

    deinit {
        rt_drop_at<T>(self.p)
        rt_free(self.p)
    }
}

impl<T> lock<T> {
    fn with<R>(self, f: fn(inout T) -> R) -> R {
        var v = rt_read<T>(self.p)
        const r = f(inout v)
        rt_write<T>(self.p, sink v)
        r
    }
}

/// ---- Boxes -------------------------------------------------------------------------------------

//~ `box(value)`: one value on the heap with a single owner. The block holds the bare value.
fn rt_box_new<T>(sink value: T) -> box<T> {
    const p = rt_alloc(rt_size_of<T>() + 1)
    rt_write<T>(p, sink value)
    rt_cast<ptr, box<T>>(p)
}

impl<T> box<T> {
    //~ A view of the value inside. The compiler treats a call of `get` as a place (like a field).
    ext fn get(self) -> T

    //~ Drops the old value and puts a new one in.
    fn set(inout self, sink value: T) {
        const p = rt_load_ptr(rt_addr_of(self))
        rt_drop_at<T>(p)
        rt_write<T>(p, sink value)
    }

    //~ Takes the value out and frees the block.
    fn take(sink self) -> T {
        const p = rt_cast<box<T>, ptr>(sink self)
        const v = rt_read<T>(p)
        rt_free(p)
        v
    }
}

/// ---- async ---------------------------------------------------------------------------------------

//~ What an `async fn` gives. At this stage a call runs the body to the end and the future holds the
//~ result; `await f()` takes it out (`wait`). The layout of a `future<T>` is that of a `T`.
pub struct future<T> {
    value: T
}

impl<T> future<T> {
    fn wait(sink self) -> T = rt_cast<future<T>, T>(sink self)
}

//~ Runs a future to the end from ordinary code.
pub fn block_on<T>(sink f: future<T>) -> T = f.wait!!()

/// ---- Compile-time code -------------------------------------------------------------------------

//~ Compile-time code says something: it is shown as a note while compiling.
pub fn meta_note(message: string) { print("meta: #message") }

//~ Compile-time code stops the compilation with this message.
pub fn meta_error(message: string) -> never { panic(message) }

/// ---- soa: struct-of-arrays ---------------------------------------------------------------------

pub ext fn rt_soa_len<T>(h: ptr) -> int
pub ext fn rt_soa_push<T>(h: ptr, sink item: T)
pub ext fn rt_soa_insert<T>(h: ptr, index: int, sink item: T)
pub ext fn rt_soa_remove<T>(h: ptr, index: int) -> T
pub ext fn rt_soa_clear<T>(h: ptr)

//~ One column is a plain list: these work on its header at `h`, taking and giving the field by address.
fn rt_col_push<F>(h: ptr, src: ptr) {
    const size = rt_size_of<F>()
    const len = rt_hdr_len(h)
    rt_grow(h, size, len + 1)
    rt_copy(rt_offset(rt_hdr_data(h), len * size), src, size)
    rt_hdr_set_len(h, len + 1)
}

fn rt_col_insert<F>(h: ptr, index: int, src: ptr) {
    const size = rt_size_of<F>()
    const len = rt_hdr_len(h)
    rt_grow(h, size, len + 1)
    var i = len - 1
    while i >= index {
        rt_copy(
            rt_offset(rt_hdr_data(h), (i + 1) * size),
            rt_offset(rt_hdr_data(h), i * size),
            size,
        )
        i -= 1
    }
    rt_copy(rt_offset(rt_hdr_data(h), index * size), src, size)
    rt_hdr_set_len(h, len + 1)
}

fn rt_col_remove<F>(h: ptr, index: int, dst: ptr) {
    const size = rt_size_of<F>()
    const len = rt_hdr_len(h)
    rt_copy(dst, rt_offset(rt_hdr_data(h), index * size), size)
    var i = index
    while i < len - 1 {
        rt_copy(
            rt_offset(rt_hdr_data(h), i * size),
            rt_offset(rt_hdr_data(h), (i + 1) * size),
            size,
        )
        i += 1
    }
    rt_hdr_set_len(h, len - 1)
}

fn rt_col_clear<F>(h: ptr) {
    const size = rt_size_of<F>()
    var i = 0
    const len = rt_hdr_len(h)
    while i < len {
        rt_drop_at<F>(rt_offset(rt_hdr_data(h), i * size))
        i += 1
    }
    rt_hdr_set_len(h, 0)
}

impl<T> soa<T> {
    fn len(self) -> int = rt_soa_len<T>(rt_addr_of(self))
    fn is_empty(self) -> bool = rt_soa_len<T>(rt_addr_of(self)) == 0

    fn push(inout self, sink item: T) {
        rt_soa_push<T>(rt_addr_of(self), sink item)
    }

    fn insert(inout self, index: int, sink item: T) {
        if index < 0 || index > self.len() { panic("insert: index out of range") }
        rt_soa_insert<T>(rt_addr_of(self), index, sink item)
    }

    fn remove(inout self, index: int) -> T {
        if index < 0 || index >= self.len() { panic("remove: index out of range") }
        rt_soa_remove<T>(rt_addr_of(self), index)
    }

    fn pop(inout self) -> T? {
        const n = self.len()
        if n == 0 { return none }
        return self.remove!(n - 1)
    }

    fn clear(inout self) {
        rt_soa_clear<T>(rt_addr_of(self))
    }
}

/// ---- Spreading into literals ------------------------------------------------------------------

//~ Appends copies of the elements of the list at `src` to the list at `h`.
fn rt_list_spread<T>(h: ptr, src: ptr) {
    const size = rt_size_of<T>()
    var i = 0
    const n = rt_hdr_len(src)
    while i < n {
        const len = rt_hdr_len(h)
        rt_grow(h, size, len + 1)
        rt_clone_to<T>(rt_offset(rt_hdr_data(src), i * size), rt_offset(rt_hdr_data(h), len * size))
        rt_hdr_set_len(h, len + 1)
        i += 1
    }
}

fn rt_set_spread<T>(h: ptr, src: ptr) {
    const size = rt_size_of<T>()
    const tmp = rt_alloc(size + 1)
    var i = 0
    const n = rt_hdr_len(src)
    while i < n {
        rt_clone_to<T>(rt_map_key_at(src, i, size), tmp)
        rt_set_put<T>(h, tmp)
        i += 1
    }
    rt_free(tmp)
}

fn rt_map_spread<K, V>(h: ptr, src: ptr) {
    const ks = rt_size_of<K>()
    const vs = rt_size_of<V>()
    const kt = rt_alloc(ks + 1)
    const vt = rt_alloc(vs + 1)
    var i = 0
    const n = rt_hdr_len(src)
    while i < n {
        rt_clone_to<K>(rt_map_key_at(src, i, ks), kt)
        rt_clone_to<V>(rt_map_val_at(src, i, ks, vs), vt)
        rt_map_put<K, V>(h, kt, vt)
        i += 1
    }
    rt_free(kt)
    rt_free(vt)
}

//~ The address of the value stored under the key at `key`; a missing key stops the program.
fn rt_map_at<K, V>(h: ptr, key: ptr) -> ptr {
    const ks = rt_size_of<K>()
    const i = rt_map_find(h, key, ks, rt_eq_fn<K>(), rt_hash_fn<K>())
    if i < 0 { panic("key not found") }
    rt_map_val_at(h, i, ks, rt_size_of<V>())
}

//~ Is there an entry whose key equals the one at `key`?
fn rt_map_has(h: ptr, key: ptr, ksize: int, eq: ptr, hash: ptr) -> bool = rt_map_find(
    h,
    key,
    ksize,
    eq,
    hash,
) >= 0

/// ---- Objects ---------------------------------------------------------------------------------

//~ Is the object at `o` of the type with this id, or of a type that extends it? The table of an object
//~ points (in its third slot) to the number of ancestors and then their ids, the object's own first.
fn rt_obj_is(o: ptr, id: int) -> bool {
    const table = rt_load_ptr(rt_offset(rt_load_ptr(o), 16))
    const n = rt_load_int(table)
    var i = 0
    while i < n {
        if rt_load_int(rt_offset(table, 8 + i * 8)) == id { return true }
        i += 1
    }
    false
}
