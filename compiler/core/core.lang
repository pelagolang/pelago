/// The always-available library. Names declared `pub` here are in scope in every module.
///
/// Functions declared `ext` have no body here: the backend provides them. The signatures are what
/// the checker needs.

/// Anything that can be printed and put into a `#( )` string.
pub interface show {
    fn show(self) -> string
}

/// Equality with `==`. Plain `struct` and `enum` types have it already; an `obj` must say so.
pub interface eq {
    fn eq(self, other: Self) -> bool
}

/// Ordering with `<`, `>`, `<=`, `>=`: a negative, zero or positive number.
pub interface order : eq {
    fn cmp(self, other: Self) -> int
}

/// Use as a key of a `map` or a member of a `set` (together with `eq`).
pub interface hash : eq {
    fn hash(self) -> int
}

/// Types that `copy` can duplicate. Plain data has it already; an `obj` must write `clone`.
pub interface clone {
    fn clone(self) -> Self
}

/// Lets `?` and `to` turn one error type into another: `impl converts<app_error> for parse_error`.
/// (`converts` is a placeholder name.)
pub interface converts<E> {
    fn convert(self) -> E
}

/// One interface per operator: `impl add for vec2 { fn add(self, other: vec2) -> vec2 ... }`.
pub interface add {
    fn add(self, other: Self) -> Self
}
pub interface sub {
    fn sub(self, other: Self) -> Self
}
pub interface mul {
    fn mul(self, other: Self) -> Self
}
pub interface div {
    fn div(self, other: Self) -> Self
}
pub interface rem {
    fn rem(self, other: Self) -> Self
}
pub interface neg {
    fn neg(self) -> Self
}

/// A failed text-to-number conversion.
pub struct parse_error {
    pub message: string
}

impl show for parse_error {
    fn show(self) -> string = copy self.message
}

pub ext fn print(...values: any show)
pub ext fn assert(condition: bool)
pub ext fn panic(message: string) -> never
pub ext fn todo() -> never
pub ext fn unreachable() -> never

