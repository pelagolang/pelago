/// The window type `[T..]` (long spelling `slice<T>`): a borrowed part of a list or array.
fn bump(xs!: [int..]) {
    for inout x of xs {
        x += 100
    }
}

fn sumOf(xs: [int..]) -> int {
    var t = 0
    for i in 0..xs.len() {
        t += xs[i]
    }
    return t
}

fn fill(xs!: slice<int>, v: int) {
    for i in 0..xs.len() {
        xs[i] = v
    }
}

fn firstHalf(xs: [int..]) -> int = sumOf(xs[0..xs.len() / 2])

fn keep(w: [int..]) -> [int] {
    return copy w
}

fn main() {
    var xs = [1, 2, 3, 4, 5, 6]
    bump(xs[1..3]!)
    print(xs)
    bump(xs!)
    print(xs, sumOf(xs), sumOf(xs[2..]), firstHalf(xs))
    var a: [int; 4] = [1, 2, 3, 4]
    fill(a!, 9)
    fill(a[1..3]!, 0)
    print(a, sumOf(a), sumOf(a[1..]))
    fill(xs[..2]!, 7)
    print(xs)
    var k = keep(xs[1..4])
    k.push!(0)
    print(k, xs)
}
