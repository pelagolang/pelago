/// `eq`, `cmp`, `hash` and `clone` are methods of every type that provides the interface: numbers,
/// text, lists, derived structs and objs, directly and through a generic bound.
@derive(clone, eq, order, hash)
struct pt { x: int, y: int }

@derive(clone, eq, order, hash)
obj node { id: int, tags: [string] }

fn hashOf<T: hash>(v: T) -> int { v.hash() }
fn same<T: eq>(a: T, b: T) -> bool { a.eq(b) }
fn rank<T: order>(a: T, b: T) -> int { a.cmp(b) }

fn main() {
    print(3.eq(3), "a".eq("b"), 1.cmp(2), 2.cmp(2), "b".cmp("a"))
    print(3.hash() == 3.hash(), "ab".hash() == "ab".hash(), "ab".hash() == "ba".hash())
    print([1, 2].hash() == [1, 2].hash(), [1, 2].eq([1, 2]), [1, 2].cmp([1, 3]))
    const p = pt { x: 1, y: 2 }
    print(p.eq(pt { x: 1, y: 2 }), p.cmp(pt { x: 1, y: 3 }), p.hash() == pt { x: 1, y: 2 }.hash(), p.hash() == pt { x: 2, y: 1 }.hash())
    const n = node { id: 1, tags: ["a"] }
    var m = n.clone()
    m.tags.push!("b")
    print(n.tags, m.tags, n.eq(m), n.eq(n.clone()), n.cmp(m), n.hash() == n.clone().hash())
    print(hashOf(p) == p.hash(), hashOf(n) == n.hash(), same(n, n.clone()), rank(p, pt { x: 0, y: 0 }))
}
