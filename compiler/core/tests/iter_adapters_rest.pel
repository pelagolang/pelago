/// The `iter` adapters and consumers beyond `map` and `filter` (split into files so each native build stays small).

fn part4c() {
    const xs = [3, 1, 4, 1, 5, 9, 2, 6]
    print(xs.iter().reversed().toList())
}

fn part5() {
    const xs = [3, 1, 4, 1, 5, 9, 2, 6]
    print(xs.iter().min(), xs.iter().max())
    const empty: [int] = []
    print(empty.iter().min(), empty.iter().last(), empty.iter().fold(7, (a, x) ~> a + x))
    print(["pear", "fig", "apple"].iter().min(), ["pear", "fig", "apple"].iter().max())
}

fn part6() {
    const xs = [3, 1, 4, 1, 5, 9, 2, 6]
}

fn part4b() {
    const xs = [3, 1, 4, 1, 5, 9, 2, 6]
    print(xs.iter().filterMap((x) ~> x > 4 ? x * 2 : none).toList())
}

fn main() {
    part4c()
    part4b()
    part5()
    part6()
}
