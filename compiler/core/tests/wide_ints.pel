/// int128, uint128, int256 and uint256: arithmetic, comparison, shifts, conversions and printing.
struct pair { lo: int128, hi: uint256 }

fn fact(n: uint256) -> uint256 {
    var r: uint256 = 1
    var i: uint256 = 2
    while i <= n {
        r *= i
        i += 1
    }
    r
}

fn main() {
    const big: int128 = 170141183460469231731687303715884105727
    const low: int128 = -170141183460469231731687303715884105728
    print(big, low, -big, big + low)
    print(big / 7, big % 1000, low / 7, low % 1000)
    const a: uint128 = 18446744073709551615
    print(a + 1, (a + 1) * a, a << 64, (a << 64) >> 70)
    var c: int128 = -5
    c *= 7
    c -= 1
    c++
    print(c, c * c, c < 0, c >= -35, c == -35, c != -35)
    print(fact(50), fact(57))
    const m: uint256 = 115792089237316195423570985008687907853269984665640564039457584007913129639935
    const n: int256 = -57896044618658097711785492504343953926634992332820282019728792003956564819968
    print(m, n, m / 7, m % 1000, n / 3, n % 1000)
    print(m >> 200, 1 to uint256 << 255, n >> 250, ~(0 to uint256) == m)
    print((7 to int128) * (-6 to int128), (200 to uint128) + (55 to uint128))
    print(0xdead_beef_cafe_f00d_1234 to uint128, a to string)
    const p = pair { lo: -3, hi: 9 }
    print(p.lo, p.hi, p.lo == -3, p == pair { lo: -3, hi: 9 })
    print(((1 to int128) << 100) to float == 1267650600228229401496703205376.0, (-3 to int128) to float, (5 to uint256) to float32)
    print(c +% c, big +% 1, (0 to uint128) -% 1, a *% a *% a)
}
