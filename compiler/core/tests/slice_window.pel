fn bump(xs!: [int..]) {
    for inout x of xs {
        x += 100
    }
}

fn sumOf(xs: [int]) -> int {
    var t = 0
    for x of xs {
        t += x
    }
    return t
}

fn main() {
    var xs = [5, 4, 3, 2, 1, 0]
    /// A window changes the elements it covers and nothing else.
    xs[1..4].sort!()
    print(xs)
    xs[..2].reverse!()
    print(xs)
    bump(xs[3..]!)
    print(xs)
    for inout x of xs[0..2] {
        x = 7
    }
    print(xs)
    xs[2..4].swap!(0, 1)
    print(xs)
    /// The same on an array, in place.
    var a: [int; 5] = [9, 8, 7, 6, 5]
    a[1..4].sort!()
    bump(a[0..2]!)
    print(a, sumOf(a[1..3]))
    /// Strings in a window are changed in place too.
    var names = ["d", "b", "c", "a"]
    names[1..].sort!()
    print(names)
    /// The list is still whole and can still grow afterwards.
    xs.push!(1)
    print(xs.len(), xs)
}
