/// The allocator written in the language, driven directly: lanes, reuse, big blocks, realloc.
fn main() {
    print(
        heap_class(1),
        heap_class(16),
        heap_class(17),
        heap_class(32),
        heap_class(33),
        heap_class(8192),
    )
    const a = heap_alloc(24)
    const b = heap_alloc(24)
    print(a != b, a % 16, heap_ld(a), heap_ld(a + 16))
    heap_st(a, 77)
    heap_free(a)
    const c = heap_alloc(20)
    print(c == a, heap_ld(c))
    heap_free(b)
    heap_free(c)
    var sum = 0
    var i = 0
    while i < 3000 {
        const p = heap_alloc(100 + i % 200)
        heap_st(p, i)
        sum += heap_ld(p)
        heap_free(p)
        i += 1
    }
    print(sum)
    const big = heap_alloc(100000)
    heap_st(big + 99992, 5)
    const big2 = heap_realloc(big, 300000)
    print(heap_ld(big2 + 99992), heap_ld(big2 + 299992))
    const small = heap_alloc(40)
    heap_st(small, 9)
    const small2 = heap_realloc(small, 5000)
    print(heap_ld(small2), heap_ld(small2 + 4000))
    print(heap_realloc(0, 10) != 0)
    heap_free(big2)
    heap_free(small2)
    heap_trim()
}
