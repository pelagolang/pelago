fn main() {
    print(math.sqrt(2.0), math.floor(-2.5), math.ceil(-2.5), math.round(2.5), math.round(-2.5))
    print(math.min(3, 7), math.max(3, 7), math.min(2.5, 1.5), math.max(2.5, 1.5))
    print(
        math.clamp(15, 0, 10),
        math.clamp(-5, 0, 10),
        math.clamp(5, 0, 10),
        math.clamp(0.5, 0.0, 1.0),
    )
    print(
        math.abs(-3),
        math.abs(-1.5),
        math.signum(-9),
        math.signum(4),
        math.signum(0),
        math.signum(-2.5),
    )
    print(math.trunc(-2.7), math.trunc(2.7), math.fract(2.75), math.fract(-2.75))
    print(math.gcd(12, 18), math.gcd(-12, 18), math.gcd(0, 0), math.lcm(4, 6), math.lcm(0, 5))
    print(math.isqrt(0), math.isqrt(15), math.isqrt(16), math.isqrt(9223372036854775807))
    print(math.hypot(3.0, 4.0), math.hypot(0.0, 0.0), math.powInt(3, 4), math.pow(2.0, 10.0))
    print(
        math.isNan(0.0 / 0.0),
        math.isNan(1.0),
        math.isFinite(1.0),
        math.isFinite(1.0 / 0.0),
        math.isInfinite(-1.0 / 0.0),
    )
    print(math.pi, math.tau, math.e)
    const x: int128 = 5
    const y: int128 = 3
    print(math.min(x, y), math.max(x, y))
    print(2.0.sqrt(), 3.min(4))
}
