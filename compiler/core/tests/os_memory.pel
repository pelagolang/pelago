fn main() {
    const page = 4096
    /// Reserve, commit, write, read back, grow, release.
    const base = rtOsReserve(16 * page)
    print(base > 0)
    const p = rtIntAddr(base)
    print(rtOsCommit(p, 4 * page))
    rtStoreInt(p, 1234)
    rtStoreInt(rtOffset(p, 4 * page - 8), 99)
    const q = rtOsRemap(p, 4 * page, 8 * page)
    print(q > 0)
    const np = rtIntAddr(q)
    print(rtLoadInt(np), rtLoadInt(rtOffset(np, 4 * page - 8)))
    print(rtOsAdviseNohuge(np, 8 * page))
    print(rtOsRelease(np, 8 * page))
    /// Bad arguments are errors, not stops.
    print(rtOsReserve(0), rtOsReserve(100), rtOsReserve(-4096))
    print(rtOsCommit(rtIntAddr(base + 8), page))
    print(rtOsRelease(p, 0))
}
