struct body {
    x: int
    y: int
    vx: int
    vy: int
}

fn main() {
    var bs: [body] = []
    for i in 0..1000 { bs.push!(body { x: i * 7, y: i * 13, vx: (i & 7) - 3, vy: (i & 3) - 1 }) }
    for step in 0..20000 {
        for i in 0..bs.len() {
            bs[i].x = (bs[i].x + bs[i].vx) & 65535
            bs[i].y = (bs[i].y + bs[i].vy) & 65535
        }
    }
    var t = 0
    for i in 0..bs.len() { t += bs[i].x ^ bs[i].y }
    print(t)
}
