/// PHC strings: `argon2Encoded` / `scryptEncoded` against Python's base64 over `cryptography` and `hashlib`, and
/// `password.verify` on all three formats with right and wrong passwords.
import std.password

fn text(s: str) -> [byte] = s.bytes().toList()

fn main() {
    const a = password.argon2Encoded(2, text("password"), text("saltsalt"), 1, 16, 1, 24)
    const s = password.scryptEncoded(text("password"), text("NaCl"), 16, 1, 1, 20)
    print(a)
    print(s)
    print(password.verify("password", a), password.verify("passwore", a))
    print(password.verify("password", s), password.verify("passwore", s))
    print(password.verify("password", "$2b$04$WUHhXETkX0fnYkrqZU3ta.zcmUrocmI6GiV1XHHkfwFuAlE9bajm6"))
    print(password.verify("x", ""), password.verify("x", "$argon2id$v=19$m=7,t=1,p=1$c2FsdHNhbHQ$AAAA"), password.verify("x", "$unknown$a$b$c"))
}
