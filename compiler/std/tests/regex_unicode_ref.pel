/// The reference matcher's Unicode mode (`(?u)` at run time): every case of regex_unicode.corpus, expected spans from Python.
/// Generated by gen_regex_unicode.py.
import std.regex

fn show(pattern: str, text: str) -> int ! parse_error {
    const re = regex.compile("(?u)#(pattern)")?
    const hits = re.findAll(text)
    var spans = ""
    var i = 0
    while i < hits.len() {
        spans.pushStr!("#(hits[i].start)-#(hits[i].end) ")
        i += 1
    }
    print(true, hits.len(), "#(spans.trim())")
    ok(0)
}

fn main() {
    show("\\w+", "naïve café Straße ΑΒΓ дом 日本語 x_1").or(1)
    show(".", "aé日😀").or(1)
    show("[^a-z]+", "abcéxyz日本q").or(1)
    show("[à-ÿ]+", "abcéàÿxz").or(1)
    show("[α-ω]+", "abc αβγ δ").or(1)
    show("\\d+", "٣٤ 12 ٥ x").or(1)
    show("\\s+", "a b c  d　e").or(1)
    show("é+", "éééa é").or(1)
    show("(?i)é+", "éÉé x").or(1)
    show("(?i)[à-ÿ]+", "ÀÉÎ àéî x").or(1)
    show("(?i)привет", "Привет ПРИВЕТ привет").or(1)
    show("[^\\W\\d]+", "ab12é٣x_").or(1)
    show("日本+", "日本本本 日").or(1)
    show("[日本]+", "日本語本").or(1)
    show("(?s).+", "a\nb").or(1)
    show(".+", "añb\nçd").or(1)
    show("[é-ü]", "aéüz").or(1)
    show("x.?y", "xéy xy x😀y xaay").or(1)
    show("^.$", "😀").or(1)
    show("[😀-😂]+", "a😀😁😂😃").or(1)
    show("\\w*é\\w*", "café cafe élan").or(1)
    show("(?i)Σ", "σΣ").or(1)
    show("\\b\\w+\\b", "naïve café Straße x_1 日本語 !?").or(1)
    show("\\bé\\w*", "é aé éa été").or(1)
    show("\\Bé", "é aé éa").or(1)
    show("\\b", "é a").or(1)
    show("\\B", "éa b").or(1)
    show("(?i)\\bÉ+\\b", "é aÉ ÉÉ").or(1)
    show("(?i)k+", "kKK x").or(1)
    show("(?i)s+", "sSſ x").or(1)
    show("(?i)σ+", "σΣς x").or(1)
    show("(?i)[a-z]+", "kKK ſ x İ ı").or(1)
    show("(?i)ǆ+", "ǅǄǆ x").or(1)
    show("(?i)i+", "iIıİ x").or(1)
    show("(?i)ß+", "ßẞSS").or(1)
    show("(?i)\\w+", "kKK é Σ").or(1)
    show("\\p{L}+", "naïve café Straße 日本語 x_1 ٣").or(1)
    show("\\p{Lu}\\p{Ll}+", "Ébène Ångström ÀB ça").or(1)
    show("\\P{L}+", "ab12 é-é !?").or(1)
    show("[\\p{Nd}_]+", "٣٤_12 a").or(1)
    show("\\p{Sc}", "€5 £3 $2 ¥").or(1)
    show("\\pL+", "ab12 é-é").or(1)
    show("(?i)\\p{Lu}+", "abcDEF123").or(1)
    show("\\p{Letter}+", "ab12 é-é").or(1)
    show("[^\\p{L}\\s]+", "ab, é! 日?").or(1)
    show("\\p{Zs}", "a b c　").or(1)
    show("\\p{Uppercase_Letter}+", "abCDéÉ").or(1)
    show("\\p{^L}+", "ab12é").or(1)
}
