/// `int128`, `uint128`, `int256` and `uint256` in JSON: written as text of digits (no digit is lost in a reader that
/// keeps numbers as doubles), read from that text or from an integer that fits.
import std.json
import { json_error } = std.json

@derive(fromJson, toJson)
struct wide { a: int128, b: uint128, c: int256, d: uint256, h: float16, f: float128, g: float256 }

fn show(r: wide ! json_error) -> string {
    switch r {
        case ok(w): "#(w.a) #(w.b) #(w.c) #(w.d) #(w.h) #(w.f) #(w.g)"
        case err(e): "error: #(e.message)"
    }
}

fn main() {
    const w = wide {
        a: -170141183460469231731687303715884105728,
        b: 340282366920938463463374607431768211455,
        c: -57896044618658097711785492504343953926634992332820282019728792003956564819968,
        d: 115792089237316195423570985008687907853269984665640564039457584007913129639935,
        h: 0.1,
        f: 1.0 / 3.0,
        g: 1.0 / 7.0,
    }
    const text = wideEncode(w)
    print(text)
    print(show(wideDecode(text)))
    print(show(wideDecode("{\"a\": 5, \"b\": 6, \"c\": \"-7\", \"d\": \"8\", \"h\": 2, \"f\": 0.5, \"g\": \"-inf\"}")))
    print(show(wideDecode("{\"a\": \"170141183460469231731687303715884105728\", \"b\": 1, \"c\": 1, \"d\": 1, \"h\": 1, \"f\": 1, \"g\": 1}")))
    print(show(wideDecode("{\"a\": 1, \"b\": -1, \"c\": 1, \"d\": 1, \"h\": 1, \"f\": 1, \"g\": 1}")))
    print(show(wideDecode("{\"a\": 1, \"b\": \"x\", \"c\": 1, \"d\": 1, \"h\": 1, \"f\": 1, \"g\": 1}")))
    print(show(wideDecode("{\"a\": 1, \"b\": 1, \"c\": 1, \"d\": 1, \"h\": \"abc\", \"f\": 1, \"g\": 1}")))
    print(show(wideDecode("{\"a\": 1, \"b\": 1, \"c\": 1, \"d\": 1, \"h\": 1, \"f\": \"1e-300\", \"g\": \"nan\"}")))
}
