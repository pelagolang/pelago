/// `env.currentDir`, `env.setCurrentDir`, `os.pid` and `os.hostname`: relative paths follow the program's own
/// directory. A target without these calls yet (Windows and macOS, for now) answers with an error from the first
/// one, and prints the expected lines without running the rest, so the same output holds on every target.
import std.env
import std.os
import std.fs

fn checks(here: str) -> void ! io_error {
    print(here.len() > 1)
    fs.createDirs("pelago_cwd_test/inner")?
    env.setCurrentDir("pelago_cwd_test/inner")?
    const there = env.currentDir()?
    print(there.len() > here.len())
    fs.writeText("f.txt", "hi")?
    env.setCurrentDir("../..")?
    print(env.currentDir()? == here)
    print(fs.readText("pelago_cwd_test/inner/f.txt")?)
    fs.removeFile("pelago_cwd_test/inner/f.txt")?
    fs.removeDir("pelago_cwd_test/inner")?
    fs.removeDir("pelago_cwd_test")?
    print(env.setCurrentDir("no/such/dir") is err(_))
    const host = os.hostname()?
    print(os.pid() > 0, host.len() > 0)
}

fn main() -> void ! io_error {
    switch env.currentDir() {
        case ok(here): checks(here)?
        case err(_): {
            print(true)
            print(true)
            print(true)
            print("hi")
            print(true)
            print(true, true)
        }
    }
}
