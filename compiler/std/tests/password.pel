/// `std.password`: scrypt against `hashlib.scrypt`, Argon2d / Argon2i / Argon2id against `cryptography`, with tiny costs
/// so the interpreter finishes.
import std.hash
import std.password

fn text(s: str) -> [byte] = s.bytes().toList()

fn main() {
    print(hash.hex(password.scrypt(text("password"), text("NaCl"), 16, 1, 1, 64)))
    print(hash.hex(password.scrypt(text(""), text(""), 16, 1, 1, 64)))
    print(hash.hex(password.scrypt(text("pleaseletmein"), text("SodiumChloride"), 64, 2, 1, 32)))
    print(hash.hex(password.scrypt(text("pw"), text("salt"), 8, 1, 2, 20)))
    for k of [0, 1, 2] {
        print(k, hash.hex(password.argon2With(k, text("password"), text("saltsalt"), 2, 16, 2, [], [], 32)))
        print(k, hash.hex(password.argon2With(k, text("password"), text("saltsalt"), 1, 8, 1, [], [], 16)))
    }
}
