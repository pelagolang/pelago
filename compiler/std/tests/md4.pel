/// `std.legacy` MD4 against OpenSSL's legacy MD4 (broken hash, tested for compatibility only).
import std.hash
import std.legacy
import { md4 } = std.legacy

fn pattern(n: int) -> [byte] {
    var out: [byte] = []
    for i of 0..n { out.push!(((i * 7 + 3) & 255).wrapToByte()) }
    out
}

fn main() {
    for n of [0, 1, 3, 55, 56, 57, 63, 64, 65, 119, 120, 128, 200, 1000] {
        print(n, hash.hex(hash.digest(md4.new(), pattern(n))))
    }
    print(hash.hex(hash.digestText(md4.new(), "abc")))
    var h = md4.new()
    for i of 0..20 { h.update!(pattern(33)) }
    print(hash.hex(h.finish()), h.outputSize(), h.blockSize())
}
