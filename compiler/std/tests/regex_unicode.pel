/// `@regex` in Unicode mode: `(?u)` makes `.` and classes work on code points, not bytes.
@regex("(?u)(?<first>[à-ÿ]+)-(?<second>[α-ω]+)(?<mark>.)")
struct mixed {
    first: string
    second: string
    mark: string
}

@regex("(?ui)(?<word>é+)")
struct accent {
    word: string
}

@regex("(?u)\\b(?<word>\\p{Lu}\\p{Ll}+)\\b")
struct proper {
    word: string
}

@regex("(?ui)(?<ks>k+)")
struct kelvin {
    ks: string
}

fn main() {
    switch mixedFind("x été-αβγ😀 y") {
        case some(m): print(m.first, m.second, m.mark)
        case none: print("none")
    }
    print(mixedIsMatch("ete-abc!"), mixedIsMatch("été-αβγ"))
    const all = accentFindAll("éÉé x É")
    var i = 0
    while i < all.len() {
        print(all[i].word)
        i += 1
    }
    const names = properFindAll("Ébène et Ångström, ça va ÀB")
    i = 0
    while i < names.len() {
        print(names[i].word)
        i += 1
    }
    switch kelvinFind("x kK\u{212a} y") {
        case some(k): print(k.ks, k.ks.len())
        case none: print("none")
    }
}

