fn run0() {
    const text = "CA"
    const hits = c0FindAll(text)
    var joined = ""
    var i = 0
    while i < hits.len() {
        joined.pushStr!(hits[i].all)
        joined.pushStr!("|")
        i += 1
    }
    print(c0IsMatch(text), hits.len(), joined)
}

