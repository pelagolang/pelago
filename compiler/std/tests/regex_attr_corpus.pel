/// Generated by gen_regex_corpus.py: the corpus patterns read by `@regex`; expected lines from Python's `re`.

@regex("(?<all>\\S{0,2}.{1,2}b)")
struct c0 {
    all: string
}

@regex("(?<all>(?i)((b|\\Db+?a{2}?b??)c)((a|c{2})a.+|[^b-c1]a{2,}.a|\\zb\\.{2,}?))")
struct c1 {
