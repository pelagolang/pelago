/// `std.password`: Argon2 with a secret and associated data, tags longer than 64 bytes, and the short names.
import std.hash
import std.password

fn text(s: str) -> [byte] = s.bytes().toList()

fn main() {
    print(hash.hex(password.argon2With(2, text("password"), text("saltsalt"), 2, 16, 2, text("sec"), text("ad"), 32)))
    print(hash.hex(password.argon2With(2, text("pw"), text("somesalt"), 1, 16, 2, [], [], 100)))
    print(hash.hex(password.argon2id(text("password"), text("saltsalt"), 1, 16, 1, 40)))
    print(hash.hex(password.argon2iKey(text("password"), text("saltsalt"), 1, 16, 1, 40)))
    print(hash.hex(password.argon2dKey(text("password"), text("saltsalt"), 1, 16, 1, 40)))
}
