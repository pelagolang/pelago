/// Arithmetic of `std.big`; the expected lines come from Python's integers.
import std.big

fn t(a: str, b: str) -> int ! parse_error {
    const x = big.parse(a)?
    const y = big.parse(b)?
    print(x + y, x - y, x * y, x / y, x % y, x < y, x == y)
    ok(0)
}

fn edge(s: str) -> int ! parse_error {
    const v = big.parse(s)?
    const n = v.toInt()?
    print(n)
    ok(0)
}

fn main() {
    t("123456789012345678901234567890", "123456789012345678901234567890").or(1)
    t("1000000000000000000000000000000", "123456789012345678901234567890").or(1)
    t("-1000000000000000000", "7").or(1)
    t("0", "5").or(1)
    t("999999999999999999", "1000000000").or(1)
    t("-999999999999999999999999", "-999999999").or(1)
    t("-778932879217421809679290810", "-757938347").or(1)
    t("-99", "1453840191614610033076661934514506123100").or(1)
    t("-90099099009900090000990999", "7").or(1)
    t("297926224393328367", "-90999990000909000").or(1)
    t("-9999999999999999999", "-9").or(1)
    t("-892900754009171452117850255", "-607909669091111465697778188").or(1)
    t("-99", "99").or(1)
    t("99000999099909009090009900", "1774366875").or(1)
    t("999999999999999999999999999", "-495490267").or(1)
    t("-9090009", "8").or(1)
    t("909", "909900999").or(1)
    t("909990", "99").or(1)
    t("316028527288779137884828884", "9342884973681809608").or(1)
    t("-8917121876643772567851369042003230455397", "94").or(1)
    t("-668928383838992352595333123214616682360", "-518583171008989723").or(1)
    t("90009009", "6395003267556392180").or(1)
    t("69", "5441262585626321547105903445369281687316").or(1)
    t("0", "9999999999").or(1)
    t("14445888", "-1718906267278990676486945847484400390266").or(1)
    t("95136743081723910", "90099099999090090999909000").or(1)
    t("-446090", "-9999099900090999909099099099009999009").or(1)
    t("-75", "990").or(1)
    t("-478475368315505696395682992", "-403808294061984815141510216").or(1)
    t("999999999", "655527781906506178").or(1)
    t("-9999999999999999999999999999999999999999", "99").or(1)
    t("90", "-9999999999999999999").or(1)
    t("9", "-2070970513").or(1)
    t("-979837246", "8747658173").or(1)
    t("688403075", "926252482").or(1)
    t("-292032215", "9909009009009909999099090009909099090900").or(1)
    t("999", "4336154497576112912223607911302166156823").or(1)
    t("9999999999999999999", "9").or(1)
    t("-980453547", "9900990900000000999").or(1)
    t("90009090009909000", "-990009900909090909").or(1)
    t("2", "756996477661918588660504966").or(1)
    t("1317386071", "631586923").or(1)
    t("1182189704340521778", "304075457273340355").or(1)
    t("0", "9999099").or(1)
    t("-900", "445819834").or(1)
    t("421", "99").or(1)
    t("994846912433248022097960702185570848882", "909").or(1)
    t("-3478399740", "2").or(1)
    t("6", "-112989392").or(1)
    t("9990099009909999000", "-900").or(1)
    t("-9999000990099009990009090990990099000909", "-777273866104549082486934150").or(1)
    t("999099909909000", "999").or(1)
    t("845", "999099009990000909").or(1)
    t("38", "53").or(1)
    t("9099099999", "909090099").or(1)
    t("840615164067947541005559442", "5093109869614177660").or(1)
    t("9990009090009009099900909000099999999009", "211").or(1)
    t("9900990999", "9990900909000990009").or(1)
    t("999", "9999999999999999999").or(1)
    t("0", "-1650872514743696296384272184761250499246").or(1)
    print(big.fromInt(10).pow(30), big.fromInt(-9223372036854775807 - 1), big.fromInt(0))
    print(
        edge("9223372036854775807").isOk(),
        edge("-9223372036854775808").isOk(),
        edge("9223372036854775808").isOk(),
        edge("-9223372036854775809").isOk(),
    )
    print(big.parse("12x").isOk(), big.parse("").isOk(), big.parse("-").isOk())
}
