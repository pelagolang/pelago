/// The process environment: variables set by whoever started the program.
///
/// ```
/// import std.env
///
/// fn main() {
///     const home = env.get("HOME") or "/"
///     print(home)
///     for p of env.vars() { print("#(p.0)=#(p.1)") }
/// }
/// ```
///
/// The values are copied, so they stay valid however long the program runs. A variable that is set to an
/// empty text is still `some("")`; one that is not set is `none`. Like `main(args)`, this needs the start-up
/// block, which Windows programs do not have yet (the build says so).

/// The start-up block's environment: pointers to `NAME=value` texts, ending in a zero.
fn first() -> ptr {
    const blk = rtIntAddr(rtOsArgv())
    rtOffset(blk, 8 * (2 + rtLoadInt(blk)))
}

fn textLen(s: ptr) -> int {
    var n = 0
    while rtLoadByte(rtOffset(s, n)) != 0 { n += 1 }
    n
}

/// A copy of `n` bytes at `p` as a `string`.
fn copyOf(p: ptr, n: int) -> string {
    var out = ""
    rtStrPush(rtAddrOf(out), p, n)
    out
}

/// The offset of the first `=` in the `NAME=value` text at `s`, or its length when there is none.
fn split(s: ptr, n: int) -> int {
    var i = 0
    while i < n && rtLoadByte(rtOffset(s, i)) != 61 { i += 1 }
    i
}

//~ The value of the variable `name`, or `none` when it is not set.
pub fn get(name: str) -> string? {
    const want = rtHdrData(rtAddrOf(name))
    const wn = name.len()
    var at = first()
    while rtLoadInt(at) != 0 {
        const s = rtLoadPtr(at)
        const n = textLen(s)
        const k = split(s, n)
        if k == wn && rtBytesEq(s, want, wn) && k < n {
            return copyOf(rtOffset(s, k + 1), n - k - 1)
        }
        at = rtOffset(at, 8)
    }
    return none
}

//~ Whether the variable `name` is set (even to an empty text).
pub fn has(name: str) -> bool = get(name) is some(_)

//~ Every variable as `(name, value)` pairs, in the order the system gave them.
pub fn vars() -> [(string, string)] {
    var out: [(string, string)] = []
    var at = first()
    while rtLoadInt(at) != 0 {
        const s = rtLoadPtr(at)
        const n = textLen(s)
        const k = split(s, n)
        if k < n { out.push!((copyOf(s, k), copyOf(rtOffset(s, k + 1), n - k - 1))) }
        at = rtOffset(at, 8)
    }
    out
}
