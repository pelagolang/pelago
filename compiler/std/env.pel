/// The process environment: variables set by whoever started the program.
///
/// ```
/// import std.env
///
/// fn main() {
///     const home = env.get("HOME").unwrapOr("/")
///     print(home)
///     for p of env.vars() { print("#(p.0)=#(p.1)") }
/// }
/// ```
///
/// The values are copied, so they stay valid however long the program runs. A variable that is set to an
/// empty text is still `some("")`; one that is not set is `none`. On Windows names are compared ignoring ASCII
/// case, as the system does. Like `main(args)`, this reads the start-up block (on Windows the runtime makes one
/// from the process's environment).

/// The start-up block's environment: pointers to `NAME=value` texts, ending in a zero.
fn first() -> ptr {
    const blk = rtIntAddr(rtOsArgv())
    const n = rtLoadInt(blk)
    /// Windows: one text (the command line) in front of the environment.
    rtOffset(blk, 8 * (2 + (if n < 0 { 1 } else { n })))
}

fn textLen(s: ptr) -> int {
    var n = 0
    while rtLoadByte(rtOffset(s, n)) != 0 { n += 1 }
    n
}

/// Whether this is Windows: there the start-up block begins with a negative count (see `first`).
fn onWindows() -> bool = rtLoadInt(rtIntAddr(rtOsArgv())) < 0

fn fold(b: byte) -> byte = if b >= 65 && b <= 90 { b + 32 } else { b }

/// Whether the `n` bytes at `s` are the name `want`: exactly on Linux and macOS, ignoring ASCII case on Windows,
/// where `Path` and `PATH` are one variable.
fn sameName(s: ptr, want: ptr, n: int) -> bool {
    if !onWindows() { return rtBytesEq(s, want, n) }
    var i = 0
    while i < n {
        if fold(rtLoadByte(rtOffset(s, i))) != fold(rtLoadByte(rtOffset(want, i))) { return false }
        i += 1
    }
    true
}

/// A copy of `n` bytes at `p` as a `string`.
fn copyOf(p: ptr, n: int) -> string {
    var out = ""
    rtStrPush(rtAddrOf(out), p, n)
    out
}

/// The offset of the first `=` in the `NAME=value` text at `s`, or its length when there is none.
fn split(s: ptr, n: int) -> int {
    var i = 0
    while i < n && rtLoadByte(rtOffset(s, i)) != 61 { i += 1 }
    i
}

//~ The value of the variable `name`, or `none` when it is not set.
pub fn get(name: str) -> string? {
    const want = rtHdrData(rtAddrOf(name))
    const wn = name.len()
    var at = first()
    while rtLoadInt(at) != 0 {
        const s = rtLoadPtr(at)
        const n = textLen(s)
        const k = split(s, n)
        if k == wn && sameName(s, want, wn) && k < n {
            return copyOf(rtOffset(s, k + 1), n - k - 1)
        }
        at = rtOffset(at, 8)
    }
    return none
}

//~ Whether the variable `name` is set (even to an empty text).
pub fn has(name: str) -> bool = get(name) is some(_)

//~ Every variable as `(name, value)` pairs, in the order the system gave them.
pub fn vars() -> [(string, string)] {
    var out: [(string, string)] = []
    var at = first()
    while rtLoadInt(at) != 0 {
        const s = rtLoadPtr(at)
        const n = textLen(s)
        const k = split(s, n)
        /// Windows keeps each drive's current directory in hidden variables whose names start with `=`: not listed.
        if k < n &&
            !(k == 0 && onWindows()) { out.push!((copyOf(s, k), copyOf(rtOffset(s, k + 1), n - k - 1))) }
        at = rtOffset(at, 8)
    }
    out
}
