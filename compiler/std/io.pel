/// Streams and files: standard input and error, and files read or written through a `file`.
///
/// ```
/// import std.io
///
/// fn main() {
///     io.eprintln("warning: no input")
///     const text = io.readAll()
///     print(text.len())
/// }
/// ```
///
/// Standard output is `print`, in the prelude. A `file` is an owned value: the descriptor is closed when the
/// value goes out of scope (`deinit`), so there is no `close` to forget. Every operation that can fail on the
/// outside world gives a `result` with an `io_error` (design note input). `io.readLine`, `io.readAll` and
/// `io.readBytes` are the short forms for standard input: a failed read is an error, never the end of the
/// input. Text is checked to be UTF-8 (`readLine`, `readAll`: an `io_error` of kind `invalidUtf8`); `readBytes`
/// is the raw form. Writing and `eprint` go through
/// the operating system layer (`design note runtime`); standard output is flushed first, so the lines of the
/// two streams come out in the order the program wrote them.

const chunk: int = 4096

fn writeAll(fd: int, text: str) -> int {
    const h = rtAddrOf(text)
    var p = rtLoadPtr(h)
    var n = rtHdrLen(h)
    while n > 0 {
        const k = rtOsWrite(fd, p, n)
        if k <= 0 { return if k < 0 { k } else { -3 } }
        p = rtOffset(p, k)
        n -= k
    }
    0
}

//~ Writes the text to standard error.
pub fn eprint(text: str) {
    writeAll(2, text)
}

//~ Writes the text and a newline to standard error.
pub fn eprintln(text: str) {
    writeAll(2, text)
    writeAll(2, "\n")
}

/// The code `failure` reads as "the bytes are not UTF-8" (no operating system error is this large).
const badUtf8: int = -1000

/// Whether `n` bytes at `data` are well-formed UTF-8: no stray or missing continuation bytes, no overlong
/// forms, no surrogates, nothing above U+10FFFF.
fn utf8Ok(data: ptr, n: int) -> bool {
    var i = 0
    while i < n {
        const b = rtLoadByte(rtOffset(data, i))
        if b < 128 {
            i += 1
        } else {
            var more = 0
            var lo = 128
            var hi = 191
            if b >= 194 && b <= 223 {
                more = 1
            } else if b == 224 {
                more = 2
                lo = 160
            } else if b >= 225 && b <= 236 {
                more = 2
            } else if b == 237 {
                more = 2
                hi = 159
            } else if b >= 238 && b <= 239 {
                more = 2
            } else if b == 240 {
                more = 3
                lo = 144
            } else if b >= 241 && b <= 243 {
                more = 3
            } else if b == 244 {
                more = 3
                hi = 143
            } else {
                return false
            }
            if i + more >= n { return false }
            const c = rtLoadByte(rtOffset(data, i + 1))
            if c < lo || c > hi { return false }
            var k = 2
            while k <= more {
                const d = rtLoadByte(rtOffset(data, i + k))
                if d < 128 || d > 191 { return false }
                k += 1
            }
            i += more + 1
        }
    }
    true
}

fn textOk(text: str) -> bool = utf8Ok(rtHdrData(rtAddrOf(text)), text.len())

/// The kind for an operating system error number (the Linux and macOS numbers; the two differ only in the
/// ones for "would block" and "timed out", and both are listed).
fn kindOfErrno(e: int) -> io_kind {
    if e == 2 { return io_kind.notFound }
    if e == 1 || e == 13 { return io_kind.denied }
    if e == 17 { return io_kind.alreadyExists }
    if e == 20 { return io_kind.notDirectory }
    if e == 21 { return io_kind.isDirectory }
    if e == 22 { return io_kind.invalid }
    if e == 28 { return io_kind.outOfSpace }
    if e == 32 { return io_kind.brokenPipe }
    if e == 4 { return io_kind.interrupted }
    if e == 11 || e == 35 { return io_kind.wouldBlock }
    if e == 110 || e == 60 { return io_kind.timedOut }
    io_kind.other
}

fn describe(kind: io_kind) -> str {
    if kind == io_kind.notFound { return ": no such file or directory" }
    if kind == io_kind.denied { return ": permission denied" }
    if kind == io_kind.alreadyExists { return ": already exists" }
    if kind == io_kind.notDirectory { return ": not a directory" }
    if kind == io_kind.isDirectory { return ": is a directory" }
    if kind == io_kind.invalid { return ": invalid argument" }
    if kind == io_kind.invalidUtf8 { return ": the data is not valid UTF-8" }
    if kind == io_kind.unexpectedEof { return ": unexpected end of input" }
    if kind == io_kind.writeZero { return ": the sink accepted no bytes" }
    if kind == io_kind.outOfSpace { return ": no space left on the device" }
    if kind == io_kind.brokenPipe { return ": broken pipe" }
    if kind == io_kind.interrupted { return ": interrupted" }
    if kind == io_kind.wouldBlock { return ": would block" }
    if kind == io_kind.timedOut { return ": timed out" }
    ": the operating system reported an error"
}

fn build(kind: io_kind, os: int, verb: str, name: str) -> io_error {
    var message = ""
    message.pushStr!(verb)
    message.pushStr!(" ")
    message.pushStr!(name)
    message.pushStr!(describe(kind))
    io_error { kind: kind, code: os, message: message }
}

//~ The `io_error` for a negative code from a path call of the operating system layer (`open`, `fs`): `verb`
//~ and `name` say what was being done to what ("opening", "a.txt"). The codes -4 and -5 are "no such file"
//~ and "denied"; any other negative code is the system's error number, negated.
pub fn failure(code: int, verb: str, name: str) -> io_error {
    if code == -4 { return build(io_kind.notFound, 2, verb, name) }
    if code == -5 { return build(io_kind.denied, 13, verb, name) }
    failureOs(code, verb, name)
}

//~ The `io_error` for a negative result of `read` or `write`: the system's error number, negated (-3 is an
//~ error the layer could not name, as on Windows today).
pub fn failureOs(code: int, verb: str, name: str) -> io_error {
    if code == badUtf8 { return build(io_kind.invalidUtf8, 0, verb, name) }
    if code == -3 { return build(io_kind.other, 0, verb, name) }
    const e = 0 - code
    build(kindOfErrno(e), e, verb, name)
}

//~ A byte source or sink: standard input, or a file from `fs.open`, `fs.create` or `fs.append`. Reading goes
//~ through a buffer, so `readLine` costs one system call per few thousand bytes, not one per byte.
pub struct file {
    fd: int
    name: string
    buf: string
    pos: int
    /// The error number that stopped the last read (0: none). The short forms read it, so they never build an
    /// `io_error` (and a program that only uses them does not carry the code that makes one).
    code: int

    init(fd: int, sink name: string) {
        self.fd = fd
        self.name = name
        self.buf = ""
        self.pos = 0
        self.code = 0
    }

    deinit {
        if self.fd >= 3 { rtOsClose(self.fd) }
    }
}

impl file {
    /// Reads another chunk into the buffer: the count read, 0 at the end, or a negative error.
    fn fill(inout self) -> int {
        const h = rtAddrOf(self.buf)
        var len = rtHdrLen(h)
        if self.pos > 0 {
            const rest = len - self.pos
            if rest == 0 {
                len = 0
                self.pos = 0
                rtHdrSetLen(h, 0)
            } else if rest <= self.pos {
                rtCopy(rtHdrData(h), rtOffset(rtHdrData(h), self.pos), rest)
                len = rest
                self.pos = 0
                rtHdrSetLen(h, rest)
            }
        }
        rtGrow(h, 1, len + chunk)
        const k = rtOsRead(self.fd, rtOffset(rtHdrData(h), len), chunk)
        if k > 0 { rtHdrSetLen(h, len + k) }
        k
    }

    /// Gives the buffer back when nothing is left in it, so a file that is read to its end holds no memory
    /// (and a program's leak check stays clean).
    fn release(inout self) {
        self.buf = ""
        self.pos = 0
    }

    /// The buffered bytes from `from` up to `to`, as text.
    fn slice(self, from: int, to: int) -> string {
        var out = ""
        if to > from { rtStrPush(rtAddrOf(out), rtOffset(rtHdrData(rtAddrOf(self.buf)), from), to - from) }
        out
    }

    /// The next line, or `none` at the end of the input or when a read fails (`code` tells which).
    fn nextLine(inout self) -> string? {
        self.code = 0
        var from = self.pos
        while true {
            const h = rtAddrOf(self.buf)
            const len = rtHdrLen(h)
            const data = rtHdrData(h)
            var i = from
            while i < len && rtLoadByte(rtOffset(data, i)) != 10 { i += 1 }
            if i < len {
                var end = i
                if end > self.pos && rtLoadByte(rtOffset(data, end - 1)) == 13 { end -= 1 }
                const line = self.slice(self.pos, end)
                self.pos = i + 1
                if self.pos == len { self.release!() }
                return line
            }
            const scanned = len - self.pos
            const k = self.fill!()
            if k < 0 {
                self.code = k
                return none
            }
            if k == 0 {
                const end = rtHdrLen(rtAddrOf(self.buf))
                if end == self.pos {
                    self.release!()
                    return none
                }
                var stop = end
                if rtLoadByte(rtOffset(rtHdrData(rtAddrOf(self.buf)), stop - 1)) == 13 { stop -= 1 }
                const line = self.slice(self.pos, stop)
                self.release!()
                return line
            }
            from = self.pos + scanned
        }
        none
    }

    /// Everything left; when a read fails, what was read before it (`code` tells).
    fn rest(inout self) -> string {
        self.code = 0
        var out = self.slice(self.pos, rtHdrLen(rtAddrOf(self.buf)))
        self.release!()
        const o = rtAddrOf(out)
        while true {
            const len = rtHdrLen(o)
            rtGrow(o, 1, len + chunk)
            const room = rtHdrCap(o) - len
            const k = rtOsRead(self.fd, rtOffset(rtHdrData(o), len), room)
            if k < 0 {
                self.code = k
                break
            }
            if k == 0 { break }
            rtHdrSetLen(o, len + k)
        }
        out
    }

    /// Text as bytes (a copy).
    fn toBytes(self, text: str) -> [byte] {
        var out: [byte] = []
        const n = text.len()
        const o = rtAddrOf(out)
        rtGrow(o, 1, n)
        rtCopy(rtHdrData(o), rtHdrData(rtAddrOf(text)), n)
        rtHdrSetLen(o, n)
        out
    }

    //~ The next line without its line ending (`\n` or `\r\n`), `none` at the end of the input, or the error
    //~ that stopped the read (`invalidUtf8` when the line is not UTF-8). A last line with no ending still
    //~ counts as a line.
    fn readLine(inout self) -> string? ! io_error {
        const line = self.nextLine!()
        if self.code < 0 { return err(failureOs(self.code, "reading", self.name)) }
        if line is some(text) {
            if !textOk(text) { return err(failureOs(badUtf8, "reading", self.name)) }
        }
        ok(line)
    }

    //~ Everything left, as text, or the error that stopped the read (`invalidUtf8` when the bytes are not
    //~ UTF-8: use `readBytes` for raw data).
    fn readAll(inout self) -> string ! io_error {
        const text = self.rest!()
        if self.code < 0 { return err(failureOs(self.code, "reading", self.name)) }
        if !textOk(text) { return err(failureOs(badUtf8, "reading", self.name)) }
        ok(text)
    }

    //~ Everything left, as bytes.
    fn readBytes(inout self) -> [byte] ! io_error {
        const text = self.rest!()
        if self.code < 0 { return err(failureOs(self.code, "reading", self.name)) }
        ok(self.toBytes(text))
    }

    //~ Writes all of the text (no buffering: build the text first, then write it once).
    fn write(inout self, text: str) -> void ! io_error {
        const k = writeAll(self.fd, text)
        if k < 0 { return err(failureOs(k, "writing", self.name)) }
    }
}

var stdin: file = file(0, sink "standard input")

//~ The next line of standard input without its line ending, `none` at the end of the input, or the error
//~ that stopped the read.
pub fn readLine() -> string? ! io_error = stdin.readLine!()

//~ Everything left on standard input, as text (checked to be UTF-8).
pub fn readAll() -> string ! io_error = stdin.readAll!()

//~ Everything left on standard input, as bytes.
pub fn readBytes() -> [byte] ! io_error = stdin.readBytes!()
