fn main() {
    var x = 0.5
    var v = 0.0
    var e = 0.0
    for i in 0..20000000 {
        const a = -x * 0.001
        v += a * 0.01
        x += v * 0.01
        e += x * x + v * v
    }
    print(fixed6(e))
}

/// The text of `x` rounded to six decimals, trailing zeros dropped: what the C twin prints with `%f`
/// (the library prints the shortest text that reads back, which is not what this test compares).
fn fixed6(x: float) -> string {
    var out = ""
    var v = x
    if v < 0.0 {
        out.pushChar!('-')
        v = 0.0 - v
    }
    var whole = v.truncInt()
    var scaled = ((v - (whole to float)) * 1000000.0 + 0.5).truncInt()
    if scaled >= 1000000 {
        whole += 1
        scaled -= 1000000
    }
    out.pushStr!("#whole")
    if scaled > 0 {
        out.pushChar!('.')
        var place = 100000
        while place > 0 && scaled > 0 {
            const d = scaled / place
            out.pushStr!("#d")
            scaled -= d * place
            place /= 10
        }
    }
    out
}
