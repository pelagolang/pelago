fn main() {
    const size = 400
    var total = 0
    for py in 0..size {
        for px in 0..size {
            const cx = (px * 3500) / size - 2500
            const cy = (py * 2000) / size - 1000
            var x = 0
            var y = 0
            var it = 0
            while it < 100 && (x * x + y * y) < 4000000 {
                const nx = (x * x - y * y) / 1000 + cx
                y = (2 * x * y) / 1000 + cy
                x = nx
                it += 1
            }
            total += it
        }
    }
    print(total)
}
