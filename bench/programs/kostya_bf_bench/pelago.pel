///* Brainfuck interpreter after kostya/benchmarks brainfuck/bf.c (MIT, Copyright (c) 2014 Konstantin Makarchev); program: brainfuck/bench.b *///
enum op {
    inc(d: int)
    move(d: int)
    again(body: [op])
    out
}

fn parse(code: [int], inout pos: int) -> [op] {
    var ops: [op] = []
    while pos < code.len() {
        const c = code[pos]
        pos += 1
        if c == 0 { ops.push!(op.inc(d: 1)) }
        else if c == 1 { ops.push!(op.inc(d: -1)) }
        else if c == 2 { ops.push!(op.move(d: 1)) }
        else if c == 3 { ops.push!(op.move(d: -1)) }
        else if c == 4 { ops.push!(op.out) }
        else if c == 5 {
            const body = parse(code, inout pos)
            ops.push!(op.again(body: body))
        }
        else { return ops }
    }
    return ops
}

fn eval(ops: [op], inout tape: [int], inout pos: int, inout sums: [int]) {
    for o of ops {
        switch o {
            case .inc(d): tape[pos] += d
            case .move(d): {
                pos += d
                if pos >= tape.len() {
                    const n = tape.len()
                    for i in 0..n { tape.push!(0) }
                }
            }
            case .again(body): {
                while tape[pos] > 0 { eval(body, inout tape, inout pos, inout sums) }
            }
            case .out: {
                sums[0] = (sums[0] + tape[pos]) % 255
                sums[1] = (sums[1] + sums[0]) % 255
            }
        }
    }
}

fn main() {
    const src = ">++[<+++++++++++++>-]<[[>+>+<<-]>[<+>-]++++++++[>++++++++<-]>.[-]<<>++++++++++[>++++++++++[>++++++++++[>++++++++++[>++++++++++[>++++++++++[>++++++++++[-]<-]<-]<-]<-]<-]<-]<-]++++++++++."
    var code: [int] = []
    for c of src.chars() {
        if c == '+' { code.push!(0) }
        else if c == '-' { code.push!(1) }
        else if c == '>' { code.push!(2) }
        else if c == '<' { code.push!(3) }
        else if c == '.' { code.push!(4) }
        else if c == '[' { code.push!(5) }
        else { code.push!(6) }
    }
    var pos = 0
    const ops = parse(code, inout pos)
    var tape: [int] = [0]
    var p = 0
    var sums: [int] = [0, 0]
    eval(ops, inout tape, inout p, inout sums)
    print((sums[1] << 8) | sums[0])
}
