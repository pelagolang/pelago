fn main() {
    const n = 3000000
    var table: [int] = []
    for i in 0..26 { table.push!(65 + i) }
    for i in 0..26 { table.push!(97 + i) }
    for i in 0..10 { table.push!(48 + i) }
    table.push!(43)
    table.push!(47)
    var rev: [int] = []
    for i in 0..256 { rev.push!(0) }
    for i in 0..64 { rev[table[i]] = i }
    var data: [int] = []
    var s = 1
    for i in 0..n {
        s = (s * 1103515245 + 12345) & 2147483647
        data.push!((s >> 8) & 255)
    }
    var check = 0
    var bad = 0
    for round in 0..3 {
        var enc: [int] = []
        var i = 0
        while i < n {
            const v = (data[i] << 16) | (data[i + 1] << 8) | data[i + 2]
            enc.push!(table[(v >> 18) & 63])
            enc.push!(table[(v >> 12) & 63])
            enc.push!(table[(v >> 6) & 63])
            enc.push!(table[v & 63])
            i += 3
        }
        for c in enc { check = (check * 31 + c) & 2147483647 }
        var j = 0
        i = 0
        while j < enc.len() {
            const v = (rev[enc[j]] << 18) | (rev[enc[j + 1]] << 12) | (rev[enc[j + 2]] << 6) | rev[enc[j + 3]]
            if data[i] != (v >> 16) & 255 { bad += 1 }
            if data[i + 1] != (v >> 8) & 255 { bad += 1 }
            if data[i + 2] != v & 255 { bad += 1 }
            i += 3
            j += 4
        }
    }
    print(check, bad)
}
