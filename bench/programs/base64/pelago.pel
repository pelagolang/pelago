///* After kostya/benchmarks base64 (MIT, Copyright (c) 2014 Konstantin Makarchev): encode and decode a 128 KiB block into newly allocated buffers, with '=' padding. *///
fn encode(src: [uint8], table: [uint8]) -> [uint8] {
    var out: [uint8] = []
    out.reserve!((src.len() + 2) / 3 * 4)
    const full = src.len() - src.len() % 3
    var i = 0
    while i < full {
        const v = ((src[i] to int) << 16) | ((src[i + 1] to int) << 8) | (src[i + 2] to int)
        out.push!(table[(v >> 18) & 63])
        out.push!(table[(v >> 12) & 63])
        out.push!(table[(v >> 6) & 63])
        out.push!(table[v & 63])
        i += 3
    }
    const rest = src.len() % 3
    if rest == 1 {
        const v = (src[i] to int) << 16
        out.push!(table[(v >> 18) & 63])
        out.push!(table[(v >> 12) & 63])
        out.push!(61)
        out.push!(61)
    } else if rest == 2 {
        const v = ((src[i] to int) << 16) | ((src[i + 1] to int) << 8)
        out.push!(table[(v >> 18) & 63])
        out.push!(table[(v >> 12) & 63])
        out.push!(table[(v >> 6) & 63])
        out.push!(61)
    }
    return out
}

fn decode(src: [uint8], rev: [uint8]) -> [uint8] {
    var size = src.len()
    while size > 0 && (src[size - 1] == 61 || src[size - 1] == 10 || src[size - 1] == 13) { size -= 1 }
    var out: [uint8] = []
    out.reserve!(size / 4 * 3 + 3)
    var i = 0
    while i + 4 <= size {
        const v = ((rev[src[i] to int] to int) << 18) | ((rev[src[i + 1] to int] to int) << 12) | ((rev[src[i + 2] to int] to int) << 6) | (rev[src[i + 3] to int] to int)
        out.push!(((v >> 16) & 255).wrapToByte())
        out.push!(((v >> 8) & 255).wrapToByte())
        out.push!((v & 255).wrapToByte())
        i += 4
    }
    const rest = size - i
    if rest == 2 {
        const v = ((rev[src[i] to int] to int) << 18) | ((rev[src[i + 1] to int] to int) << 12)
        out.push!(((v >> 16) & 255).wrapToByte())
    } else if rest == 3 {
        const v = ((rev[src[i] to int] to int) << 18) | ((rev[src[i + 1] to int] to int) << 12) | ((rev[src[i + 2] to int] to int) << 6)
        out.push!(((v >> 16) & 255).wrapToByte())
        out.push!(((v >> 8) & 255).wrapToByte())
    }
    return out
}

fn main() {
    var table: [uint8] = []
    for i in 0..26 { table.push!((65 + i).wrapToByte()) }
    for i in 0..26 { table.push!((97 + i).wrapToByte()) }
    for i in 0..10 { table.push!((48 + i).wrapToByte()) }
    table.push!(43)
    table.push!(47)
    var rev: [uint8] = []
    for i in 0..256 { rev.push!(0) }
    for i in 0..64 { rev[table[i] to int] = i.wrapToByte() }
    var text: [uint8] = []
    for i in 0..131072 { text.push!(97) }
    const encoded = encode(text, table)
    const decoded = decode(encoded, rev)
    var ok = 0
    if decoded.len() == text.len() { ok = 1 }
    var s_encoded = 0
    var s_decoded = 0
    for t in 0..256 { s_encoded += encode(text, table).len() }
    for t in 0..256 { s_decoded += decode(encoded, rev).len() }
    print(ok, s_encoded, s_decoded)
}
