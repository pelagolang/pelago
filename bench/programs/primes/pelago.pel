fn main() {
    const limit = 2000000
    var sieve: [int] = []
    for i in 0..limit + 1 { sieve.push!(0) }
    var x = 1
    while x * x < limit {
        var y = 1
        while y * y < limit {
            var n = 4 * x * x + y * y
            if n <= limit && (n % 12 == 1 || n % 12 == 5) { sieve[n] = sieve[n] ^ 1 }
            n = 3 * x * x + y * y
            if n <= limit && n % 12 == 7 { sieve[n] = sieve[n] ^ 1 }
            n = 3 * x * x - y * y
            if x > y && n <= limit && n % 12 == 11 { sieve[n] = sieve[n] ^ 1 }
            y += 1
        }
        x += 1
    }
    var r = 5
    while r * r <= limit {
        if sieve[r] == 1 {
            var k = r * r
            while k <= limit {
                sieve[k] = 0
                k += r * r
            }
        }
        r += 1
    }
    var child: [int] = []
    var cnt: [int] = []
    for d in 0..10 { child.push!(0) }
    cnt.push!(0)
    var nodes = 1
    var primes = 0
    for p in 2..limit + 1 {
        if p == 2 || p == 3 || (p >= 5 && sieve[p] == 1) {
            primes += 1
            var d = 1
            while d * 10 <= p { d *= 10 }
            var node = 0
            while d > 0 {
                const digit = (p / d) % 10
                if child[node * 10 + digit] == 0 {
                    child[node * 10 + digit] = nodes
                    for e in 0..10 { child.push!(0) }
                    cnt.push!(0)
                    nodes += 1
                }
                node = child[node * 10 + digit]
                cnt[node] += 1
                d /= 10
            }
        }
    }
    var queue: [int] = [0]
    var head = 0
    var check = 0
    while head < queue.len() {
        const node = queue[head]
        head += 1
        check = (check * 31 + cnt[node]) & 2147483647
        for digit in 0..10 {
            if child[node * 10 + digit] != 0 { queue.push!(child[node * 10 + digit]) }
        }
    }
    print(primes, nodes, check)
}
