fn main() {
    const prog = "-[>-[>-[>+<-]<-]<-]>>>."
    var code: [int] = []
    for c of prog.chars() {
        if c == '+' { code.push!(0) }
        else if c == '-' { code.push!(1) }
        else if c == '<' { code.push!(2) }
        else if c == '>' { code.push!(3) }
        else if c == '[' { code.push!(4) }
        else if c == ']' { code.push!(5) }
        else { code.push!(6) }
    }
    var jump: [int] = []
    var stack: [int] = []
    for i in 0..code.len() { jump.push!(0) }
    for i in 0..code.len() {
        if code[i] == 4 { stack.push!(i) }
        else if code[i] == 5 {
            const open = stack.pop!() ?? 0
            jump[open] = i
            jump[i] = open
        }
    }
    var tape: [int] = []
    for i in 0..30000 { tape.push!(0) }
    var ptr = 0
    var pc = 0
    var steps = 0
    var out = 0
    while pc < code.len() {
        const op = code[pc]
        steps += 1
        if op == 0 { tape[ptr] = (tape[ptr] + 1) & 255 }
        else if op == 1 { tape[ptr] = (tape[ptr] + 255) & 255 }
        else if op == 2 { ptr -= 1 }
        else if op == 3 { ptr += 1 }
        else if op == 4 { if tape[ptr] == 0 { pc = jump[pc] } }
        else if op == 5 { if tape[ptr] != 0 { pc = jump[pc] } }
        else { out += tape[ptr] }
        pc += 1
    }
    var sum = 0
    for i in 0..30000 { sum += tape[i] }
    print(steps, sum, out)
}
