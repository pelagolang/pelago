///* After kostya/benchmarks matmul (written by Attractive Chaos, MIT license): float matrices, second matrix transposed. *///
fn gen(n: int, seed: float) -> [[float]] {
    const tmp = seed / (n to float) / (n to float)
    var m: [[float]] = []
    for i in 0..n {
        var row: [float] = []
        for j in 0..n { row.push!(tmp * ((i - j) to float) * ((i + j) to float)) }
        m.push!(sink row)
    }
    return m
}

fn mul(n: int, a: [[float]], b: [[float]]) -> [[float]] {
    var c: [[float]] = []
    for i in 0..n {
        var row: [float] = []
        for j in 0..n { row.push!(b[j][i]) }
        c.push!(sink row)
    }
    var m: [[float]] = []
    for i in 0..n {
        var row: [float] = []
        for j in 0..n {
            var t = 0.0
            for k in 0..n { t += a[i][k] * c[j][k] }
            row.push!(t)
        }
        m.push!(sink row)
    }
    return m
}

fn calc(size: int) -> float {
    const n = size / 2 * 2
    const a = gen(n, 1.0)
    const b = gen(n, 2.0)
    const m = mul(n, a, b)
    return m[n / 2][n / 2]
}

fn main() {
    print(fixed6(calc(400)))
}

/// The text of `x` rounded to six decimals, trailing zeros dropped: what the C twin prints with `%f`
/// (the library prints the shortest text that reads back, which is not what this test compares).
fn fixed6(x: float) -> string {
    var out = ""
    var v = x
    if v < 0.0 {
        out.pushChar!('-')
        v = 0.0 - v
    }
    var whole = v.truncInt()
    var scaled = ((v - (whole to float)) * 1000000.0 + 0.5).truncInt()
    if scaled >= 1000000 {
        whole += 1
        scaled -= 1000000
    }
    out.pushStr!("#whole")
    if scaled > 0 {
        out.pushChar!('.')
        var place = 100000
        while place > 0 && scaled > 0 {
            const d = scaled / place
            out.pushStr!("#d")
            scaled -= d * place
            place /= 10
        }
    }
    out
}
