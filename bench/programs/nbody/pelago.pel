fn energy(x: [float], y: [float], z: [float], vx: [float], vy: [float], vz: [float], m: [float]) -> float {
    var e = 0.0
    for i in 0..5 {
        e += 0.5 * m[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i])
        for j in i + 1..5 {
            const dx = x[i] - x[j]
            const dy = y[i] - y[j]
            const dz = z[i] - z[j]
            e -= m[i] * m[j] / (dx * dx + dy * dy + dz * dz).sqrt()
        }
    }
    return e
}

fn main() {
    const pi = 3.141592653589793
    const sm = 4.0 * pi * pi
    const dpy = 365.24
    var x: [float] = [0.0, 4.84143144246472090, 8.34336671824457987, 12.8943695621391310, 15.3796971148509165]
    var y: [float] = [0.0, -1.16032004402742839, 4.12479856412430479, -15.1111514016986312, -25.9193146099879641]
    var z: [float] = [0.0, -0.103622044471123109, -0.403523417114321381, -0.223307578892655734, 0.179258772950371181]
    var vx: [float] = [0.0, 0.00166007664274403694 * dpy, -0.00276742510726862411 * dpy, 0.00296460137564761618 * dpy, 0.00268067772490389322 * dpy]
    var vy: [float] = [0.0, 0.00769901118419740425 * dpy, 0.00499852801234917238 * dpy, 0.00237847173959480950 * dpy, 0.00162824170038242295 * dpy]
    var vz: [float] = [0.0, -0.0000690460016972063023 * dpy, 0.0000230417297573763929 * dpy, -0.0000296589568540237556 * dpy, -0.0000951592254519715870 * dpy]
    var m: [float] = [sm, 0.000954791938424326609 * sm, 0.000285885980666130812 * sm, 0.0000436624404335156298 * sm, 0.0000515138902046611451 * sm]
    var px = 0.0
    var py = 0.0
    var pz = 0.0
    for i in 0..5 {
        px += vx[i] * m[i]
        py += vy[i] * m[i]
        pz += vz[i] * m[i]
    }
    vx[0] = -px / sm
    vy[0] = -py / sm
    vz[0] = -pz / sm
    print(energy(x, y, z, vx, vy, vz, m))
    for step in 0..200000 {
        for i in 0..5 {
            for j in i + 1..5 {
                const dx = x[i] - x[j]
                const dy = y[i] - y[j]
                const dz = z[i] - z[j]
                const d2 = dx * dx + dy * dy + dz * dz
                const mag = 0.01 / (d2 * d2.sqrt())
                vx[i] -= dx * m[j] * mag
                vy[i] -= dy * m[j] * mag
                vz[i] -= dz * m[j] * mag
                vx[j] += dx * m[i] * mag
                vy[j] += dy * m[i] * mag
                vz[j] += dz * m[i] * mag
            }
        }
        for i in 0..5 {
            x[i] += 0.01 * vx[i]
            y[i] += 0.01 * vy[i]
            z[i] += 0.01 * vz[i]
        }
    }
    print(energy(x, y, z, vx, vy, vz, m))
}
