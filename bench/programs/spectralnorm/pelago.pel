fn a(i: int, j: int) -> float {
    return 1.0 / ((((i + j) * (i + j + 1)) / 2 + i + 1) to float)
}

fn mul_av(v: [float], inout out: [float]) {
    for i in 0..v.len() {
        var s = 0.0
        for j in 0..v.len() { s += a(i, j) * v[j] }
        out[i] = s
    }
}

fn mul_atv(v: [float], inout out: [float]) {
    for i in 0..v.len() {
        var s = 0.0
        for j in 0..v.len() { s += a(j, i) * v[j] }
        out[i] = s
    }
}

fn main() {
    const n = 2000
    var u: [float] = []
    var v: [float] = []
    var t: [float] = []
    for i in 0..n {
        u.push!(1.0)
        v.push!(0.0)
        t.push!(0.0)
    }
    for k in 0..10 {
        mul_av(u, inout t)
        mul_atv(t, inout v)
        mul_av(v, inout t)
        mul_atv(t, inout u)
    }
    var vbv = 0.0
    var vv = 0.0
    for i in 0..n {
        vbv += u[i] * v[i]
        vv += v[i] * v[i]
    }
    print(fixed6((vbv / vv).sqrt()))
}

/// The text of `x` rounded to six decimals, trailing zeros dropped: what the C twin prints with `%f`
/// (the library prints the shortest text that reads back, which is not what this test compares).
fn fixed6(x: float) -> string {
    var out = ""
    var v = x
    if v < 0.0 {
        out.pushChar!('-')
        v = 0.0 - v
    }
    var whole = v.truncInt()
    var scaled = ((v - (whole to float)) * 1000000.0 + 0.5).truncInt()
    if scaled >= 1000000 {
        whole += 1
        scaled -= 1000000
    }
    out.pushStr!("#whole")
    if scaled > 0 {
        out.pushChar!('.')
        var place = 100000
        while place > 0 && scaled > 0 {
            const d = scaled / place
            out.pushStr!("#d")
            scaled -= d * place
            place /= 10
        }
    }
    out
}
