/// The same program with the nodes in an arena: a node is a bump, and freeing a tree is one reset.
struct node {
    l: aref<node>
    r: aref<node>
}

fn make(inout a: arena, d: int) -> aref<node> {
    if d == 0 { return a.new!(node { l: a.noRef(), r: a.noRef() }) }
    const l = make(inout a, d - 1)
    const r = make(inout a, d - 1)
    a.new!(node { l: l, r: r })
}

fn check(a: arena, t: aref<node>) -> int {
    const n = a.get(t)
    var c = 0
    if !a.isNone(n.l) { c += 1 + check(a, n.l) }
    if !a.isNone(n.r) { c += check(a, n.r) }
    c
}

fn main() {
    var a = arena()
    var total = 0
    for it in 0..20 {
        total += check(a, make(inout a, 16))
        a.reset!()
    }
    print(total)
}
