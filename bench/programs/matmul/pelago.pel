fn main() {
    const n = 256
    var a: [int] = []
    var b: [int] = []
    var c: [int] = []
    for i in 0..n * n {
        a.push!((i * 7) & 15)
        b.push!((i * 13 + 3) & 15)
        c.push!(0)
    }
    for i in 0..n {
        for j in 0..n {
            var sum = 0
            for k in 0..n { sum += a[i * n + k] * b[k * n + j] }
            c[i * n + j] = sum
        }
    }
    var t = 0
    for i in 0..n * n { t += c[i] * (i & 7) }
    print(t)
}
