{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pelago",
  "scopeName": "source.pelago",
  "fileTypes": [
    "pel"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#soft"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.pelago",
          "begin": "//~\\*",
          "end": "\\*~//"
        },
        {
          "name": "comment.line.documentation.pelago",
          "match": "//~.*$"
        },
        {
          "name": "comment.block.pelago",
          "begin": "///\\*",
          "end": "\\*///",
          "patterns": [
            {
              "include": "#block-inner"
            }
          ]
        },
        {
          "name": "comment.line.triple-slash.pelago",
          "match": "///.*$"
        },
        {
          "name": "invalid.illegal.not-a-comment.pelago",
          "match": "//.*$|/\\*"
        }
      ]
    },
    "block-inner": {
      "patterns": [
        {
          "name": "comment.block.pelago",
          "begin": "///\\*",
          "end": "\\*///",
          "patterns": [
            {
              "include": "#block-inner"
            }
          ]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.pelago",
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.attribute.pelago"
            },
            "2": {
              "name": "entity.name.function.attribute.pelago"
            }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.pelago",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.pelago"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.pelago"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.pelago",
          "match": "\\\\(?:[nrt0\\\\\"'#]|u\\{[0-9a-fA-F]+\\}|x[0-9a-fA-F]{2})"
        },
        {
          "name": "meta.interpolation.pelago",
          "begin": "(#)(\\()",
          "end": "(\\))",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.interpolation.pelago"
            },
            "2": {
              "name": "punctuation.definition.interpolation.pelago"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.interpolation.pelago"
            }
          },
          "patterns": [
            {
              "include": "#interp-parens"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#attributes"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#chars"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#soft"
            },
            {
              "include": "#declarations"
            },
            {
              "include": "#types"
            },
            {
              "include": "#calls"
            },
            {
              "include": "#operators"
            }
          ]
        },
        {
          "name": "meta.interpolation.pelago",
          "match": "(#)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.interpolation.pelago"
            },
            "2": {
              "name": "variable.other.interpolation.pelago"
            }
          }
        }
      ]
    },
    "interp-parens": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#interp-parens"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#soft"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#types"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#operators"
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.pelago",
          "match": "'(?:\\\\(?:[nrt0\\\\\"']|u\\{[0-9a-fA-F]+\\}|x[0-9a-fA-F]{2})|[^'\\\\\\n])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.pelago",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.pelago",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.pelago",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.pelago",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9_]+\\b"
        },
        {
          "name": "constant.numeric.integer.pelago",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pelago",
          "match": "(?<![.\\w])(?:if|else|unless|switch|case|guard|for|in|of|while|do|loop|break|continue|return|defer|become|yield|is)\\b"
        },
        {
          "name": "storage.modifier.access.pelago",
          "match": "(?<![.\\w])(?:inout|sink|copy)\\b"
        },
        {
          "name": "storage.modifier.binding.pelago",
          "match": "(?<![.\\w])(?:var|const)\\b"
        },
        {
          "name": "storage.type.pelago",
          "match": "(?<![.\\w])(?:fn|struct|enum|interface|impl|obj|mod|pkg)\\b"
        },
        {
          "name": "keyword.declaration.pelago",
          "match": "(?<![.\\w])(?:import|export|use|pub|priv|meta|macro|deinit|let)\\b"
        },
        {
          "name": "constant.language.pelago",
          "match": "(?<![.\\w])(?:true|false|none)\\b"
        },
        {
          "name": "variable.language.pelago",
          "match": "(?<![.\\w])(?:super|self|Self)\\b"
        },
        {
          "name": "keyword.other.pelago",
          "match": "(?<![.\\w])(?:unsafe|async|await)\\b"
        }
      ]
    },
    "soft": {
      "patterns": [
        {
          "name": "keyword.other.soft.pelago",
          "match": "(?<=[\\w)\\]\"'])\\s+(to)(?=\\s+[a-zA-Z_\\[(])",
          "captures": {
            "1": {
              "name": "keyword.other.soft.pelago"
            }
          }
        },
        {
          "match": "(\\.\\.=?)([^\\n]*?)\\s(step)\\b",
          "captures": {
            "1": {
              "name": "keyword.operator.range.pelago"
            },
            "2": {
              "patterns": [
                {
                  "include": "#comments"
                },
                {
                  "include": "#strings"
                },
                {
                  "include": "#chars"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#calls"
                },
                {
                  "include": "#operators"
                }
              ]
            },
            "3": {
              "name": "keyword.other.soft.pelago"
            }
          }
        },
        {
          "name": "keyword.other.soft.pelago",
          "match": "^\\s*(?:pub\\s+|priv\\s+)?(?:type|ext|union|static|operator|open|abstract|override|final|linear|test)(?=\\s+(?:fn|struct|enum|obj|interface|impl|[a-z_]+|\"))"
        },
        {
          "name": "keyword.other.soft.pelago",
          "match": "^\\s*init(?=\\s*[({])"
        },
        {
          "match": "(?<=~>)([^\\n]*?)(?<![.\\w])(it)\\b",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#comments"
                },
                {
                  "include": "#strings"
                },
                {
                  "include": "#chars"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#calls"
                },
                {
                  "include": "#operators"
                }
              ]
            },
            "2": {
              "name": "keyword.other.soft.pelago"
            }
          }
        },
        {
          "name": "keyword.other.soft.pelago",
          "match": "(?<=[:>,\\[]\\s)any(?=\\s+[a-z_])"
        },
        {
          "name": "keyword.other.soft.pelago",
          "match": "(?<![.\\w])(?:spawn|select)(?=\\s*[({])"
        },
        {
          "name": "keyword.other.soft.pelago",
          "match": "(?<![.\\w])scope(?=\\s+[a-z_]+\\s*\\{)"
        },
        {
          "name": "keyword.other.soft.pelago",
          "match": "(?<=\\))\\s+where\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.pelago"
            },
            "2": {
              "name": "entity.name.function.pelago"
            }
          }
        },
        {
          "match": "\\b(struct|enum|obj|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.pelago"
            },
            "2": {
              "name": "entity.name.type.pelago"
            }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.pelago",
          "match": "(?<![.\\w])(?:int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|byte|float|float32|float64|bool|char|string|str|map|set|range|option|result|box|soa|rc|ptr|void|never|error|list|iter|task|chan|sender|receiver|shared|lock|fn)\\b"
        },
        {
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.pelago"
            },
            "2": {
              "name": "entity.name.type.pelago"
            }
          }
        },
        {
          "name": "entity.name.type.pelago",
          "match": "\\b[a-z_][a-z0-9_]*(?=<[A-Za-z_\\[(])"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "support.function.builtin.pelago",
          "match": "(?<![.\\w])(?:print|assert|panic|todo|unreachable)(?=\\s*\\()"
        },
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(!!|!)?(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.pelago"
            },
            "2": {
              "name": "keyword.operator.mark.pelago"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.pelago",
          "match": "~>"
        },
        {
          "name": "keyword.operator.optional.pelago",
          "match": "\\?\\?=?|\\?\\.|\\?"
        },
        {
          "name": "keyword.operator.range.pelago",
          "match": "\\.\\.\\.|\\.\\.=|\\.\\."
        },
        {
          "name": "keyword.operator.pelago",
          "match": "\\+%=|-%=|\\*%=|<<=|>>=|\\*\\*|==|!=|<=|>=|&&|\\|\\||!!|\\+%|-%|\\*%|<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|\\+\\+|--|->|\\|>|\\+|-|\\*|/|%|<|>|!|&|\\||\\^|~|="
        }
      ]
    }
  }
}
